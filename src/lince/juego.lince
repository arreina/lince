# 🐆 Lince — la parte del módulo 'juego' escrita en Lince.
#
# Va dentro del ejecutable (src/lince/incrustar.py la convierte en
# src/biblioteca_juego.h) y se carga con 'importar "juego"': cada función de
# aquí cuyo nombre no empieza por '_' es una función más del módulo, como las
# que están en C. Aquí está lo que no necesita la velocidad de C ni hablar con
# la pantalla, el teclado o el altavoz: así se puede leer, y copiar para hacer
# una versión propia.
#
# Lo que usa de C: juego.historial(segundos[, acciones]), juego.gastar(ids),
# juego.estado_accion(nombre), juego.tiempo(), juego.tiempo_real(), juego.dt()
# y juego.cubrir(color). presentar() llama a _presentar() en cada fotograma.

importar "matematica"
importar "texto"
importar "sistema"
importar "archivos"

# ── Comprobaciones con el mismo mensaje en todas las funciones ──

funcion _segundos(numero s, texto fn): nulo {
    si s < 0 o s > 10 { lanzar ErrorArgumento("{fn}(): los segundos van de 0 a 10") }
}

# El estado de una acción definida con juego.definir_accion
funcion _accion(cualquiera a, texto fn): diccionario {
    si no (a es texto) { lanzar ErrorTipo("{fn}() espera el nombre de una acción") }
    sea estado = juego.estado_accion(a)
    si estado == nulo { lanzar ErrorArgumento("{fn}(): la acción '{a}' no está definida (usa juego.definir_accion)") }
    devolver estado
}

# Las pulsaciones de esas acciones en los últimos 'segundos'. historial() da
# nulo si alguna no es una acción definida: entonces se mira cuál, para decirlo.
funcion _historial(numero segundos, lista acciones, texto fn): lista {
    sea pulsadas = juego.historial(segundos, acciones)
    si pulsadas == nulo {
        para cada cualquiera a en acciones { _accion(a, fn) }
    }
    devolver pulsadas
}

# El nombre de la copia de esa acción para ese jugador ("saltar@2"), o nulo si
# ese jugador no se ha unido (para él, nada está pulsado)
funcion _accion_de(cualquiera a, cualquiera jugador, texto fn): cualquiera {
    _accion(a, fn)
    si no (jugador es numero) o jugador < 1 o jugador > 8 o matematica.piso(jugador) != jugador {
        lanzar ErrorArgumento("{fn}(): el jugador es un número de 1 a 8")
    }
    sea suya = "{a}@{jugador}"
    si juego.estado_accion(suya) == nulo { devolver nulo }
    devolver suya
}

# ── Pulsaciones: combos, machacar un botón y golpes cargados ──

# combo(acciones[, segundos]): ¿se han pulsado esas acciones en ese orden en
# los últimos 'segundos'? Puede haber otras pulsaciones en medio. Cuando da
# verdadero, esas pulsaciones se gastan y no valen para otro combo (por eso se
# pregunta antes por los combos largos). Con una sola acción sirve para no
# perder una pulsación hecha un poco antes de tiempo: combo(["golpe"], 0.2).
funcion combo(cualquiera acciones, numero segundos = 0.5, cualquiera jugador = nulo): logico {
    si no (acciones es lista) o acciones.longitud() < 1 o acciones.longitud() > 32 {
        lanzar ErrorTipo("combo() espera (lista de acciones[, segundos[, jugador]]), por ejemplo ([\"abajo\", \"adelante\", \"golpe\"], 0.5)")
    }
    _segundos(segundos, "combo")
    si jugador != nulo {
        sea suyas = []
        para cada cualquiera a en acciones { suyas.agregar(_accion_de(a, jugador, "combo")) }
        si suyas.contiene(nulo) { devolver falso }       # ese jugador no está
        acciones = suyas
    }
    sea pulsadas = _historial(segundos, acciones, "combo")

    # Se busca de la última acción hacia atrás, cada una antes que la siguiente
    sea j = pulsadas.longitud() - 1
    sea usadas = []
    para (i = acciones.longitud() - 1; i >= 0; i--) {
        mientras j >= 0 y (pulsadas[j]["gastada"] o pulsadas[j]["accion"] != acciones[i]) { j-- }
        si j < 0 { devolver falso }
        usadas.agregar(pulsadas[j]["id"])
        j--
    }
    juego.gastar(usadas)
    devolver verdadero
}

# pulsaciones(accion[, segundos]): cuántas veces se ha pulsado en los últimos
# 'segundos', también las que ya ha gastado combo(). Para los golpes de
# machacar un botón y para soltarse de un agarre.
funcion pulsaciones(cualquiera accion, numero segundos = 0.5, cualquiera jugador = nulo): numero {
    _segundos(segundos, "pulsaciones")
    si jugador != nulo {
        accion = _accion_de(accion, jugador, "pulsaciones")
        si accion == nulo { devolver 0 }
    }
    devolver _historial(segundos, [accion], "pulsaciones").longitud()
}

# mantenida(accion[, margen]): cuántos segundos lleva pulsada (0 si no lo
# está). Con 'margen', si se soltó hace menos de esos segundos dice cuánto
# estuvo pulsada: para los golpes cargados (mantener atrás un segundo y luego
# adelante y golpe: al pulsar adelante, atrás ya se ha soltado).
funcion mantenida(cualquiera accion, numero margen = 0, cualquiera jugador = nulo): numero {
    si jugador != nulo {
        accion = _accion_de(accion, jugador, "mantenida")
        si accion == nulo { devolver 0 }
    }
    sea estado = _accion(accion, "mantenida")
    si margen < 0 o margen > 10 { lanzar ErrorArgumento("mantenida(): el margen va de 0 a 10 segundos") }
    si estado["pulsada"] { devolver estado["mantenida"] }
    sea hace = estado["soltada_hace"]
    si margen > 0 y hace >= 0 y hace <= margen + 0.000000001 { devolver estado["duro"] }
    devolver 0
}

# ── Movimiento suave ──
# Una curva dice cómo se reparte un cambio en el tiempo: t va de 0 (empieza) a
# 1 (acaba) y la curva da cuánto del camino se ha hecho. "lineal" va igual
# todo el rato; las demás arrancan o paran poco a poco, se pasan un poco y
# vuelven ("atras"), rebotan al llegar ("rebote") o vibran como un muelle
# ("elastico").

fijo _CURVAS = ["lineal", "suave", "entrar", "salir", "rebote", "elastico", "atras"]

funcion _nombre_curva(cualquiera c, texto fn): texto {
    si c == nulo { devolver "suave" }
    si c es texto y _CURVAS.contiene(c) { devolver c }
    lanzar ErrorArgumento(fn + "(): la curva es \"lineal\", \"suave\", \"entrar\", \"salir\", \"rebote\", \"elastico\" o \"atras\"")
}

funcion _al_cubo(numero v): numero { devolver v * v * v }

funcion _curva(texto c, numero t): numero {
    si t < 0 { t = 0 }
    si t > 1 { t = 1 }
    elegir c {
        caso "lineal" { devolver t }
        caso "suave" { devolver si t < 0.5 { 4 * _al_cubo(t) } sino { 1 - _al_cubo(-2 * t + 2) / 2 } }
        caso "entrar" { devolver _al_cubo(t) }
        caso "salir" { devolver 1 - _al_cubo(1 - t) }
        caso "rebote" {
            fijo N1 = 7.5625
            fijo D1 = 2.75
            si t < 1 / D1 { devolver N1 * t * t }
            si t < 2 / D1 {
                t -= 1.5 / D1
                devolver N1 * t * t + 0.75
            }
            si t < 2.5 / D1 {
                t -= 2.25 / D1
                devolver N1 * t * t + 0.9375
            }
            t -= 2.625 / D1
            devolver N1 * t * t + 0.984375
        }
        caso "elastico" {
            si t == 0 o t == 1 { devolver t }
            devolver matematica.potencia(2, -10 * t) * matematica.seno((t * 10 - 0.75) * (2 * matematica.PI / 3)) + 1
        }
    }
    # "atras"
    fijo C1 = 1.70158
    devolver 1 + (C1 + 1) * _al_cubo(t - 1) + C1 * (t - 1) * (t - 1)
}

# desde + (hasta - desde) * f, con números o con listas de números (posiciones, colores)
funcion _interpolar(cualquiera desde, cualquiera hasta, numero f, texto fn): cualquiera {
    si desde es numero y hasta es numero { devolver desde + (hasta - desde) * f }
    sea bien = desde es lista y hasta es lista y desde.longitud() == hasta.longitud()
    para (i = 0; bien y i < desde.longitud(); i++) {
        bien = desde[i] es numero y hasta[i] es numero
    }
    si no bien {
        lanzar ErrorTipo("{fn}(): los dos valores son números, o listas de números del mismo largo (como [x, y] o un color)")
    }
    sea r = []
    para (i = 0; i < desde.longitud(); i++) { r.agregar(desde[i] + (hasta[i] - desde[i]) * f) }
    devolver r
}

# curva(nombre, t): cuánto del camino se ha hecho en el momento t (de 0 a 1)
funcion curva(texto nombre, numero t): numero {
    devolver _curva(_nombre_curva(nombre, "curva"), t)
}

# suavizar(desde, hasta, segundos, inicio[, curva]): el valor que toca ahora
# en un cambio de 'desde' a 'hasta' que empezó en 'inicio' (un juego.tiempo())
# y dura 'segundos'; antes de empezar, 'desde', y al acabar, 'hasta'
funcion suavizar(cualquiera desde, cualquiera hasta, numero segundos, numero inicio,
        cualquiera nombre_curva = nulo): cualquiera {
    sea c = _nombre_curva(nombre_curva, "suavizar")
    sea t = si segundos > 0 { (juego.tiempo() - inicio) / segundos } sino { 1 }
    devolver _interpolar(desde, hasta, _curva(c, t), "suavizar")
}

# acercar(actual, objetivo, rapidez): un paso de 'actual' hacia 'objetivo' en
# este fotograma, más largo cuanto más lejos (frena al llegar). Con rapidez 10
# recorre en una décima de segundo unos dos tercios de lo que le falta, vaya
# el juego a los fotogramas que vaya. Para una cámara que sigue al jugador,
# una barra de vida que baja...
funcion acercar(cualquiera actual, cualquiera objetivo, numero rapidez): cualquiera {
    si rapidez < 0 { lanzar ErrorArgumento("acercar(): la rapidez no es negativa") }
    devolver _interpolar(actual, objetivo, 1 - matematica.potencia(matematica.E, -rapidez * juego.dt()), "acercar")
}

# ── Escenas ──
# Un nombre para cada parte del juego ("portada", "partida", "fin"...). El
# cambio se hace en el siguiente presentar(), así un fotograma no mezcla dos
# escenas; con fundido, la pantalla se oscurece, cambia y se aclara. El
# fundido va con el reloj de verdad: no se para con congelar().

sea _escena = ""
sea _siguiente = nulo        # la que viene, o nulo
sea _nueva = falso           # ¿es el primer fotograma de la escena?
sea _desde = 0               # juego.tiempo() al empezar la escena
sea _fundido = 0             # segundos que dura el fundido
sea _fase = 0                # 0: sin fundido; 1: oscurece; 2: aclara
sea _desde_fase = 0          # juego.tiempo_real() al empezar la fase

# LINCE_JUEGO_ESCENA=nombre (para probar una escena sin recorrer el juego): el
# juego empieza en esa escena, como si lo primero que hace fuera
# cambiar_escena("nombre") sin fundido; la primera cambiar_escena() del programa
# (la suya, que lleva a la escena de siempre) se salta
sea _forzada = sistema.entorno("LINCE_JUEGO_ESCENA", "")

funcion _aplicar_forzada(): nulo {
    si _forzada != "" {
        sea nombre = _forzada
        _forzada = ""
        _poner_escena(nombre)
    }
}

funcion _poner_escena(texto nombre): nulo {
    _escena = nombre
    _nueva = verdadero
    _desde = juego.tiempo()
}

# cambiar_escena(nombre[, fundido]): fundido en segundos (0 = de golpe)
funcion cambiar_escena(cualquiera nombre, cualquiera fundido = 0): nulo {
    si no juego.abierto() { lanzar ErrorJuego("la ventana no está abierta: llama a juego.abrir() primero") }
    si no (nombre es texto) { lanzar ErrorTipo("cambiar_escena() espera (nombre[, segundos de fundido])") }
    si no (fundido es numero) { lanzar ErrorTipo("cambiar_escena(): el argumento 2 debe ser un número") }
    si _forzada != "" y _escena == "" {      # LINCE_JUEGO_ESCENA: se empieza en la que se pidió
        _aplicar_forzada()
        devolver nulo
    }
    si _escena == "" y fundido <= 0 {        # la primera escena empieza ya
        _poner_escena(nombre)
        devolver nulo
    }
    _siguiente = nombre
    _fundido = si fundido > 0 { fundido } sino { 0 }
    si fundido > 0 y _fase != 1 {
        _fase = 1
        _desde_fase = juego.tiempo_real()
    }
}

funcion escena(): texto {
    _aplicar_forzada()
    devolver _escena
}
funcion escena_nueva(): logico {
    _aplicar_forzada()
    devolver _nueva
}
funcion tiempo_escena(): numero {
    _aplicar_forzada()
    devolver juego.tiempo() - _desde
}

# En cada presentar(), después de las tareas: la caja de diálogo, el fundido
# de las escenas y, encima de todo, el mando de la pantalla táctil
funcion _presentar(): nulo {
    _aplicar_forzada()
    _dibujar_dialogo()
    _fundido_escenas()
    _dibujar_mando()
}

# Hace el cambio de escena pendiente y dibuja el fundido
funcion _fundido_escenas(): nulo {
    _nueva = falso
    si _siguiente != nulo y _fase != 1 {
        _poner_escena(_siguiente)
        _siguiente = nulo
    }
    si _fase == 0 { devolver nulo }
    sea ahora = juego.tiempo_real()
    sea mitad = _fundido / 2
    sea p = si mitad > 0 { (ahora - _desde_fase) / mitad } sino { 1 }
    si _fase == 1 y p >= 1 {                 # a oscuras: cambia y empieza a aclarar
        si _siguiente != nulo {
            _poner_escena(_siguiente)
            _siguiente = nulo
        }
        _fase = 2
        _desde_fase = ahora
        p = 0
    } sino si _fase == 2 y p >= 1 {
        _fase = 0
        devolver nulo
    }
    sea alfa = si _fase == 1 { p } sino { 1 - p }
    juego.cubrir([0, 0, 0, matematica.limitar(alfa, 0, 1) * 255])
}

# ── Animador ──
# Lleva por ti qué animación toca, desde cuándo, si se repite o se queda en el
# último cuadro (y cuál va después), cuándo hay una pisada y con qué golpea:
#   sea pj = juego.animador(HOJA, {"andar": {"fila": 0, "por_segundo": 10},
#                                  "saltar": {"fila": 2, "repetir": falso, "siguiente": "quieto"},
#                                  "quieto": {"fila": 2, "cuadros": [0]}})
#   juego.animacion(pj, "andar")           (cambia solo si no estaba ya)
#   juego.dibujar(pj, x, y, opciones)      (dibujar() pregunta a _cuadro())
#   si juego.pisada(pj) { ... }            (un pie acaba de tocar el suelo)
# Todo su estado va en el diccionario ("actual", "desde"...), así que se
# conserva al recargar el programa en caliente.

fijo _OPCIONES_ANIMACION = ["fila", "cuadros", "por_segundo", "repetir", "siguiente", "pisadas", "golpes", "cancelar", "hoja"]

funcion _es_hoja(cualquiera h): logico {
    devolver h es diccionario y h.contiene("hoja") y h["hoja"] es numero
}

funcion _es_animador(cualquiera pj, texto fn): diccionario {
    si no (pj es diccionario) o no pj.contiene("animador") {
        lanzar ErrorTipo("{fn}() espera un animador de juego.animador()")
    }
    devolver pj
}

funcion _son_numeros(cualquiera l): logico {
    si no (l es lista) { devolver falso }
    para cada cualquiera v en l {
        si no (v es numero) { devolver falso }
    }
    devolver verdadero
}

# Comprueba una opción de una animación; devuelve el mensaje si está mal, o nulo
funcion _opcion_mala(texto nombre, texto c, cualquiera v, diccionario hoja,
        diccionario animaciones): cualquiera {
    elegir c {
        caso "fila" {
            si v es numero y v >= 0 y v < hoja["filas"] y v == matematica.piso(v) { devolver nulo }
            devolver "animador(): en \"{nombre}\", \"fila\" va de 0 a {hoja["filas"] - 1}"
        }
        caso "por_segundo" {
            si v es numero y v > 0 { devolver nulo }
            devolver "animador(): en \"{nombre}\", \"por_segundo\" es un número mayor que 0"
        }
        caso "repetir" {
            si v es logico { devolver nulo }
            devolver "animador(): en \"{nombre}\", \"repetir\" es verdadero o falso"
        }
        caso "siguiente" {
            si v es texto y animaciones.contiene(v) { devolver nulo }
            devolver "animador(): en \"{nombre}\", \"siguiente\" es el nombre de otra de las animaciones"
        }
        caso "pisadas" {
            si v es logico o _son_numeros(v) { devolver nulo }
            devolver "animador(): en \"{nombre}\", \"pisadas\" es verdadero, falso o la lista de cuadros con pisada"
        }
        caso "cuadros" {
            si _son_numeros(v) y v.longitud() > 0 y v.longitud() <= 1024 { devolver nulo }
            devolver "animador(): en \"{nombre}\", \"cuadros\" es la lista de cuadros que se van mostrando"
        }
        caso "golpes" {
            sea bien = v es lista
            para cada cualquiera g en (si bien { v } sino { [] }) {
                bien = bien y _son_numeros(g) y g.longitud() == 5 y g[0] >= 0 y g[3] > 0 y g[4] > 0
            }
            si bien { devolver nulo }
            devolver "animador(): en \"{nombre}\", \"golpes\" es una lista de [cuadro, x, y, ancho, alto] " +
                "(la caja que golpea en ese cuadro, medida dentro de la celda)"
        }
        caso "cancelar" {
            si v es numero y v >= 0 { devolver nulo }
            devolver "animador(): en \"{nombre}\", \"cancelar\" es el cuadro desde el que se puede pasar a otra animación"
        }
    }
    devolver nulo
}

# animador(hoja, animaciones[, inicial])
funcion animador(cualquiera hoja, cualquiera animaciones, cualquiera inicial = nulo): diccionario {
    si no _es_hoja(hoja) o no (animaciones es diccionario) o animaciones.longitud() == 0 {
        lanzar ErrorTipo("animador() espera (hoja, \{nombre: \{\"fila\": n, \"por_segundo\": n, ...}, ...}[, inicial])")
    }
    para cada texto nombre en animaciones {
        sea cfg = animaciones[nombre]
        si no (cfg es diccionario) {
            lanzar ErrorTipo("animador(): \"{nombre}\" va con un diccionario, por ejemplo \{\"fila\": 0}")
        }
        sea hc = hoja
        si cfg.contiene("hoja") {
            hc = cfg["hoja"]
            si no _es_hoja(hc) {
                lanzar ErrorTipo("animador(): en \"{nombre}\", \"hoja\" es una hoja de juego.hoja() o juego.animar()")
            }
        }
        para cada texto c en cfg {
            si no _OPCIONES_ANIMACION.contiene(c) {
                lanzar ErrorArgumento("animador(): en \"{nombre}\", no conozco '{c}' (hay \"fila\", \"cuadros\", \"por_segundo\", " +
                        "\"repetir\", \"siguiente\", \"pisadas\", \"golpes\", \"cancelar\" y \"hoja\")")
            }
            sea mal = _opcion_mala(nombre, c, cfg[c], hc, animaciones)
            si mal != nulo { lanzar ErrorArgumento(mal) }
        }
        si cfg.contiene("cuadros") {
            sea fila = si cfg.contiene("fila") { cfg["fila"] } sino { -1 }
            sea limite = si fila >= 0 { hc["por_fila"][fila] } sino { hc["cuadros"] }
            para cada numero q en cfg["cuadros"] {
                si q < 0 o q >= limite o q != matematica.piso(q) {
                    sea dentro = si fila >= 0 { " (contando dentro de su fila)" } sino { "" }
                    lanzar ErrorArgumento("animador(): en \"{nombre}\", los cuadros van de 0 a {limite - 1}{dentro}")
                }
            }
        }
    }
    sea primera = ""
    para cada texto nombre en animaciones {
        primera = nombre
        romper
    }
    si inicial != nulo {
        si no (inicial es texto) o no animaciones.contiene(inicial) {
            lanzar ErrorArgumento("animador(): la animación inicial es el nombre de una de las animaciones")
        }
        primera = inicial
    }
    devolver {"animador": verdadero, "hoja": hoja, "animaciones": animaciones,
        "actual": primera, "desde": juego.tiempo(), "cuadro": 0}
}

# Dónde va el animador ahora (o nulo si no tiene animación): la hoja, la fila
# y el cuadro, cuántos han pasado (k), en qué posición de la secuencia va
# (pos, de n)... Si la que había acabó y tiene "siguiente", pasa a esa como si
# hubiera empezado justo al acabar.
funcion _estado(diccionario pj): cualquiera {
    sea animaciones = pj["animaciones"]
    para (vueltas = 0; vueltas < 8; vueltas++) {
        sea actual = pj["actual"]
        si no (actual es texto) o no animaciones.contiene(actual) { devolver nulo }
        sea cfg = animaciones[actual]
        sea hoja = si cfg.contiene("hoja") { cfg["hoja"] } sino { pj["hoja"] }
        sea por_segundo = si cfg.contiene("por_segundo") { cfg["por_segundo"] } sino { 10 }
        sea siguiente = si cfg.contiene("siguiente") { cfg["siguiente"] } sino { nulo }
        sea repetir = si cfg.contiene("repetir") { cfg["repetir"] } sino { siguiente == nulo }
        sea fila = si cfg.contiene("fila") { matematica.truncar(cfg["fila"]) } sino { -1 }
        sea cuadros = si cfg.contiene("cuadros") { cfg["cuadros"] } sino { nulo }
        sea n = si cuadros != nulo { cuadros.longitud() } sino { juego.cuadros_de(hoja, si fila >= 0 { fila } sino { nulo }) }
        si n < 1 { devolver nulo }
        sea k = matematica.piso((juego.tiempo() - pj["desde"]) * por_segundo + 0.000000001)
        si k < 0 { k = 0 }
        sea acabada = no repetir y k >= n
        si acabada y siguiente es texto y animaciones.contiene(siguiente) {
            pj["actual"] = siguiente
            pj["desde"] = pj["desde"] + n / por_segundo
            continuar
        }
        sea pos = si repetir { k % n } sino { matematica.minimo(k, n - 1) }
        sea cuadro = si cuadros != nulo { matematica.truncar(cuadros[pos]) } sino { pos }
        devolver {"hoja": hoja, "fila": fila, "cuadro": cuadro, "cuadros": cuadros, "k": k, "n": n,
            "pos": pos, "acabada": acabada, "repetir": repetir, "cfg": cfg}
    }
    devolver nulo
}

# Para dibujar() y caja(): [hoja, fila, cuadro] de lo que toca, o nulo
funcion _cuadro(diccionario pj): cualquiera {
    sea e = _estado(pj)
    si e == nulo { devolver nulo }
    devolver [e["hoja"], e["fila"], e["cuadro"]]
}

# animacion(animador, nombre[, desde_el_principio]): pone esa animación; si ya
# estaba puesta sigue por donde iba, salvo que se pida empezar de nuevo
funcion animacion(cualquiera pj, cualquiera nombre, cualquiera desde_el_principio = falso): nulo {
    _es_animador(pj, "animacion")
    sea animaciones = pj["animaciones"]
    si no (nombre es texto) { lanzar ErrorTipo("animacion() espera (animador, nombre)") }
    si no animaciones.contiene(nombre) {
        sea hay = ""
        sea i = 0
        para cada texto otra en animaciones {
            sea antes = si i == 0 { "" } sino si i == animaciones.longitud() - 1 { " y" } sino { "," }
            hay += "{antes} \"{otra}\""
            i++
        }
        lanzar ErrorArgumento("animacion(): no hay ninguna animación '{nombre}'; hay{hay}")
    }
    _estado(pj)                       # por si acabó una con "siguiente"
    si (desde_el_principio es logico y desde_el_principio) o pj["actual"] != nombre {
        pj["actual"] = nombre
        pj["desde"] = juego.tiempo()
    }
}

# acabada(animador): ¿ha llegado al final una animación que no se repite?
funcion acabada(cualquiera pj): logico {
    sea e = _estado(_es_animador(pj, "acabada"))
    devolver e != nulo y e["acabada"]
}

# libre(animador): ¿se puede pasar ya a otra animación? Sí si la actual se
# repite, si ha acabado o si ha llegado a su cuadro "cancelar" (así se
# encadenan los golpes de un combo sin esperar a que acabe cada uno)
funcion libre(cualquiera pj): logico {
    sea e = _estado(_es_animador(pj, "libre"))
    si e == nulo o e["repetir"] o e["acabada"] { devolver verdadero }
    devolver e["cfg"].contiene("cancelar") y e["k"] >= matematica.truncar(e["cfg"]["cancelar"])
}

# golpe(animador, x, y[, opciones]): la caja [x, y, ancho, alto] con la que
# golpea ahora (la de "golpes" del cuadro que toca), puesta como se dibuja (las
# mismas opciones que dibujar: escala, centrado, espejo...); nulo si en este
# cuadro no golpea. Varias cajas en el mismo cuadro se juntan.
funcion golpe(cualquiera pj, cualquiera px, cualquiera py, cualquiera opciones = nulo): cualquiera {
    _es_animador(pj, "golpe")
    si opciones != nulo y no (opciones es diccionario) {
        lanzar ErrorTipo("golpe(): las opciones van en un diccionario, como en dibujar()")
    }
    si no (px es numero) { lanzar ErrorTipo("golpe(): el argumento 2 debe ser un número") }
    si no (py es numero) { lanzar ErrorTipo("golpe(): el argumento 3 debe ser un número") }
    sea e = _estado(pj)
    si e == nulo o e["acabada"] o no e["cfg"].contiene("golpes") { devolver nulo }   # quieta al final: ya no golpea
    sea caja = nulo
    para cada lista g en e["cfg"]["golpes"] {
        si matematica.truncar(g[0]) == e["pos"] {
            sea x0 = matematica.truncar(g[1])
            sea y0 = matematica.truncar(g[2])
            sea x1 = x0 + matematica.truncar(g[3])
            sea y1 = y0 + matematica.truncar(g[4])
            si caja == nulo {
                caja = [x0, y0, x1, y1]
            } sino {
                caja = [matematica.minimo(caja[0], x0), matematica.minimo(caja[1], y0),
                    matematica.maximo(caja[2], x1), matematica.maximo(caja[3], y1)]
            }
        }
    }
    si caja == nulo { devolver nulo }
    sea op = {}
    si opciones != nulo {
        para cada texto c en opciones { op[c] = opciones[c] }
    }
    op["trozo"] = [caja[0], caja[1], caja[2] - caja[0], caja[3] - caja[1]]
    devolver juego.caja(e["hoja"], px, py, op)
}

# Los cuadros con pisada de la animación actual (posiciones en su secuencia):
# los que diga su "pisadas", o los que se ven en la hoja si se repite
funcion _pisadas(diccionario e): lista {
    sea cfg = e["cfg"]
    si cfg.contiene("pisadas") y cfg["pisadas"] es lista { devolver cfg["pisadas"] }
    sea calcular = si cfg.contiene("pisadas") { cfg["pisadas"] } sino { e["repetir"] }
    si no calcular { devolver [] }
    sea fila = si e["fila"] >= 0 { e["fila"] } sino { nulo }
    devolver juego.pisadas(e["hoja"], fila, si e["cuadros"] != nulo { e["cuadros"] } sino { e["n"] })
}

# pisada(animador): ¿ha tocado un pie el suelo desde la última vez que se
# preguntó? (llámala una vez por fotograma)
funcion pisada(cualquiera pj): logico {
    sea e = _estado(_es_animador(pj, "pisada"))
    si e == nulo { devolver falso }
    # desde dónde mirar: lo último visto de esta misma animación, o justo antes de empezar
    sea actual = pj["actual"]
    sea desde = pj["desde"]
    sea k = e["k"]
    sea n = e["n"]
    sea ultimo = k - 1
    si pj.contiene("visto_de") y pj["visto_de"] == actual y pj["visto_desde"] == desde { ultimo = pj["visto"] }
    sea hay = falso
    si k > ultimo {
        sea pisa = _pisadas(e)
        sea j = si k - ultimo > n { k - n + 1 } sino { ultimo + 1 }
        mientras j <= k y no hay {
            si no e["repetir"] y j >= n { romper }
            hay = pisa.contiene(si e["repetir"] { j % n } sino { j })
            j++
        }
    }
    pj["visto"] = k
    pj["visto_de"] = actual
    pj["visto_desde"] = desde
    devolver hay
}

# ── Mando en la pantalla táctil ──
# Como en los juegos de móvil de ahora: a la izquierda una palanca que aparece
# donde se pone el pulgar, y a la derecha los botones A, B, X, Y. Funciona como
# un mando de verdad (se suma al mando 1 con mando_virtual()), así que las
# acciones con "mando:a" o "mando:izq_x-" no cambian. Sale solo: con pantalla
# táctil, si alguna acción usa el mando, con los botones que usen (y la palanca
# si usan la palanca izquierda o la cruceta). Con un mando de verdad
# conectado (Bluetooth o cable) se esconde. Se puede ajustar o quitar:
#   juego.mando_tactil({"botones": ["a", "b", "x", "y"], "tamaño": 1.2})
#   juego.mando_tactil(falso)                      sin mando (controles propios)
# Con "siempre": verdadero también se ve en el ordenador (y se usa con el ratón).

sea _mt = nulo              # el que vale en este fotograma (de _mt_config), o nulo si no hay
sea _mt_opciones = nulo     # las de mando_tactil(), o nulo: todo automático
sea _mt_quitado = falso     # mando_tactil(falso)
sea _mt_palanca = nulo      # el dedo de la palanca: su id y dónde empezó
sea _mt_eje = [0, 0]        # cuánto se inclina la palanca, de -1 a 1
sea _mt_pulsados = []
sea _mt_puesto = falso      # ¿hay algo de este mando en mando_virtual()?

fijo _MT_BOTONES = ["a", "b", "x", "y", "inicio"]
fijo _MT_COLORES = {"a": [80, 200, 110], "b": [230, 80, 80], "x": [80, 140, 240], "y": [240, 200, 60], "inicio": [180, 180, 190]}
fijo _MT_MENSAJES = {
    "botones": "\"botones\" es una lista con algunos de \"a\", \"b\", \"x\", \"y\" e \"inicio\"",
    "palanca": "\"palanca\" es verdadero o falso",
    "siempre": "\"siempre\" es verdadero o falso",
    "alfa": "\"alfa\" va de 0 (invisible) a 255",
    "tamaño": "\"tamaño\" es un número mayor que 0 (1 es el tamaño normal)"
}

funcion _mt_bien(texto c, cualquiera v): logico {
    elegir c {
        caso "botones" {
            si no (v es lista) { devolver falso }
            para cada cualquiera b en v {
                si no (b es texto) o no _MT_BOTONES.contiene(b) { devolver falso }
            }
            devolver verdadero
        }
        caso "palanca" { devolver v es logico }
        caso "siempre" { devolver v es logico }
        caso "alfa" { devolver v es numero y v >= 0 y v <= 255 }
        caso "tamaño" { devolver v es numero y v > 0 }
    }
    devolver falso
}

# mando_tactil([opciones]) · mando_tactil(falso)
funcion mando_tactil(cualquiera opciones = nulo): nulo {
    si opciones == falso {
        _mt = nulo
        _mt_quitado = verdadero
        _mt_palanca = nulo
        _mt_eje = [0, 0]
        _mt_pulsados = []
        si _mt_puesto { juego.mando_virtual([], {}) }
        _mt_puesto = falso
        devolver nulo
    }
    si opciones == nulo { opciones = {} }
    si no (opciones es diccionario) {
        lanzar ErrorTipo("mando_tactil() espera un diccionario de opciones (o falso para quitarlo), por ejemplo \{\"botones\": [\"a\", \"b\"]}")
    }
    para cada texto c en opciones {
        si no _MT_MENSAJES.contiene(c) {
            _no_conozco("mando_tactil", c, ["botones", "palanca", "siempre", "alfa", "tamaño"])
        }
        si no _mt_bien(c, opciones[c]) { lanzar ErrorArgumento("mando_tactil(): " + _MT_MENSAJES[c]) }
    }
    _mt_opciones = opciones
    _mt_quitado = falso
}

# Lo que usan las acciones: los botones (en el orden de un mando) y si hace
# falta la palanca (palanca izquierda o cruceta)
funcion _mt_lo_que_usan(): diccionario {
    sea usados = []
    sea palanca = falso
    sea acciones = juego.acciones()
    para cada texto nombre en acciones {
        para cada texto entrada en acciones[nombre] {
            sea partes = entrada.dividir(":")
            si partes.longitud() == 2 y partes[0].contiene("mando") {
                sea parte = partes[1]
                si _MT_BOTONES.contiene(parte) y no usados.contiene(parte) { usados.agregar(parte) }
                si parte.contiene("izq_") o ["izquierda", "derecha", "arriba", "abajo"].contiene(parte) { palanca = verdadero }
            }
        }
    }
    sea botones = []
    para cada texto b en _MT_BOTONES {
        si usados.contiene(b) { botones.agregar(b) }
    }
    devolver {"botones": botones, "palanca": palanca}
}

# El mando que toca ahora, con lo que se haya pedido y lo demás automático; o
# nulo si no hay que ponerlo
funcion _mt_config(): cualquiera {
    si _mt_quitado { devolver nulo }
    sea op = si _mt_opciones == nulo { {} } sino { _mt_opciones }
    sea siempre = op.contiene("siempre") y op["siempre"]
    si no siempre y no juego.tactil() { devolver nulo }
    # con un mando de verdad conectado (por Bluetooth o cable), el de la
    # pantalla sobra: se esconde, y vuelve si se desconecta
    si no siempre y juego.mandos() > 0 { devolver nulo }
    sea usan = _mt_lo_que_usan()
    si _mt_opciones != nulo y usan["botones"].longitud() == 0 y no usan["palanca"] {
        usan = {"botones": ["a", "b"], "palanca": verdadero}       # pedido a mano, sin acciones de mando
    }
    sea cfg = {"botones": usan["botones"], "palanca": usan["palanca"], "alfa": 120, "tamaño": 1, "siempre": siempre}
    para cada texto c en op { cfg[c] = op[c] }
    si cfg["botones"].longitud() == 0 y no cfg["palanca"] { devolver nulo }
    devolver cfg
}

# Las medidas, en coordenadas del juego: u es el lado corto de la pantalla
funcion _mt_medidas(): diccionario {
    sea ancho = juego.ancho()
    sea alto = juego.alto()
    sea u = matematica.minimo(ancho, alto) * _mt["tamaño"]
    sea radio = u * 0.16
    devolver {"ancho": ancho, "alto": alto, "radio": radio, "boton": u * 0.085,
        "casa": [u * 0.1 + radio, alto - u * 0.1 - radio], "centro": [ancho - u * 0.26, alto - u * 0.26]}
}

# Dónde va cada botón: en rombo como en un mando (A abajo, B a la derecha, X a
# la izquierda, Y arriba); con dos o menos, A y B en diagonal; "inicio", arriba
funcion _mt_sitio(texto b, diccionario m): lista {
    sea c = m["centro"]
    sea d = m["boton"] * 1.35
    si b == "inicio" { devolver [m["ancho"] - m["boton"] * 1.6, m["boton"] * 1.4] }
    sea cuantos = 0
    para cada texto otro_boton en _mt["botones"] {
        si otro_boton != "inicio" { cuantos++ }
    }
    si cuantos <= 2 {
        si b == "a" o cuantos == 1 { devolver [c[0] - d * 0.7, c[1] + d * 0.45] }
        devolver [c[0] + d * 0.7, c[1] - d * 0.45]
    }
    elegir b {
        caso "a" { devolver [c[0], c[1] + d] }
        caso "b" { devolver [c[0] + d, c[1]] }
        caso "x" { devolver [c[0] - d, c[1]] }
    }
    devolver [c[0], c[1] - d]
}

funcion _mt_dentro(diccionario t, lista sitio, numero radio): logico {
    devolver matematica.distancia(t["x"], t["y"], sitio[0], sitio[1]) <= radio
}

# Después de leer los dedos, en cada presentar(): qué hace cada uno. La
# palanca sigue al dedo que la empezó (uno nuevo en la mitad izquierda que no
# toque un botón); cada botón está pulsado si hay otro dedo encima.
# Los menús y los diálogos, después: así también los maneja el mando de la
# pantalla (o lo que se deje con mando_virtual)
funcion _entrada_ui(): nulo {
    _ui_leer()
    _dl_entrada()
}

funcion _entrada(): nulo {
    _mt = _mt_config()
    si _mt == nulo {
        si _mt_puesto {                     # se suelta lo que hubiera pulsado
            _mt_pulsados = []
            _mt_palanca = nulo
            _mt_eje = [0, 0]
            _mt_puesto = falso
            juego.mando_virtual([], {})
        }
        devolver nulo
    }
    sea m = _mt_medidas()
    sea toques = juego.toques()
    sea dedo = nulo
    si _mt_palanca != nulo {
        para cada diccionario t en toques {
            si t["id"] == _mt_palanca["id"] { dedo = t }
        }
        si dedo == nulo { _mt_palanca = nulo }
    }
    si _mt_palanca == nulo y _mt["palanca"] {
        para cada diccionario t en toques {
            si t["nuevo"] y t["x"] < m["ancho"] / 2 {
                # la base, donde se pone el pulgar pero sin salirse de la pantalla
                _mt_palanca = {"id": t["id"],
                    "x": matematica.limitar(t["x"], m["radio"], m["ancho"] / 2 - m["radio"]),
                    "y": matematica.limitar(t["y"], m["radio"], m["alto"] - m["radio"])}
                dedo = t
                romper
            }
        }
    }
    sea ejes = {}
    _mt_eje = [0, 0]
    si dedo != nulo {
        sea dx = dedo["x"] - _mt_palanca["x"]
        sea dy = dedo["y"] - _mt_palanca["y"]
        sea largo = matematica.distancia(0, 0, dx, dy)
        si largo > m["radio"] {
            dx = dx * m["radio"] / largo
            dy = dy * m["radio"] / largo
            largo = m["radio"]
        }
        si largo > m["radio"] * 0.15 {             # zona muerta, como en un mando
            _mt_eje = [dx / m["radio"], dy / m["radio"]]
        }
        ejes = {"izq_x": _mt_eje[0], "izq_y": _mt_eje[1]}
    }
    sea pulsados = []
    para cada texto b en _mt["botones"] {
        sea sitio = _mt_sitio(b, m)
        para cada diccionario t en toques {
            si (dedo == nulo o t["id"] != dedo["id"]) y _mt_dentro(t, sitio, m["boton"] * 1.3) {
                pulsados.agregar(b)
                romper
            }
        }
    }
    # la palanca también hace de cruceta
    si _mt_eje[0] < -0.5 { pulsados.agregar("izquierda") }
    si _mt_eje[0] > 0.5 { pulsados.agregar("derecha") }
    si _mt_eje[1] < -0.5 { pulsados.agregar("arriba") }
    si _mt_eje[1] > 0.5 { pulsados.agregar("abajo") }
    _mt_pulsados = pulsados
    _mt_puesto = verdadero
    juego.mando_virtual(pulsados, ejes)
}

# En cada presentar(), encima de todo y sin moverse con la cámara
funcion _dibujar_mando(): nulo {
    si _mt == nulo { devolver nulo }
    sea m = _mt_medidas()
    sea alfa = _mt["alfa"]
    sea camara = juego.camara_actual()
    juego.camara()
    si _mt["palanca"] {
        sea base = si _mt_palanca != nulo { [_mt_palanca["x"], _mt_palanca["y"]] } sino { m["casa"] }
        juego.circulo(base[0], base[1], m["radio"], [255, 255, 255, alfa * 0.3])
        sea fuerte = si _mt_palanca != nulo { 1.4 } sino { 1 }
        juego.circulo(base[0] + _mt_eje[0] * m["radio"], base[1] + _mt_eje[1] * m["radio"], m["radio"] * 0.45,
            [255, 255, 255, matematica.minimo(255, alfa * fuerte)])
    }
    para cada texto b en _mt["botones"] {
        sea sitio = _mt_sitio(b, m)
        sea pulsado = _mt_pulsados.contiene(b)
        sea c = _MT_COLORES[b]
        sea radio = si b == "inicio" { m["boton"] * 0.6 } sino { m["boton"] }
        juego.circulo(sitio[0], sitio[1], si pulsado { radio * 0.9 } sino { radio },
            [c[0], c[1], c[2], matematica.minimo(255, si pulsado { alfa * 1.8 } sino { alfa })])
        sea letra = si b == "inicio" { "=" } sino { b.mayusculas() }
        sea escala = matematica.maximo(1, matematica.redondear(radio / 9))
        juego.texto(letra, sitio[0], sitio[1] - 3.5 * escala,
            {"escala": escala, "alinear": "centro", "color": [255, 255, 255, matematica.minimo(255, alfa * 1.8)]})
    }
    juego.camara(camara)
}

# ── Menús y diálogos ──
# Se manejan igual con teclado (flechas o WASD, entrar o espacio, escape), con
# mando (cruceta o palanca, A, B) y con el ratón o el dedo (señalar y tocar).
# Se dibujan sin moverse con la cámara.

sea _ui_eje = 0             # la palanca, arriba (-1), abajo (1) o en medio: para moverse a saltos
sea _ui_paso = 0            # -1 / 1 si en este fotograma se pide subir / bajar
sea _menus = {}             # por menú (sus opciones): cuál está elegida y cuándo se vio

# Lo que se pide en este fotograma (en _entrada_ui, con la entrada recién leída)
funcion _ui_leer(): nulo {
    sea eje = juego.eje("izq_y")
    sea ahora = si eje < -0.5 { -1 } sino si eje > 0.5 { 1 } sino { 0 }
    _ui_paso = 0
    si juego.tecla_pulsada("arriba") o juego.tecla_pulsada("w") o juego.boton_pulsado("arriba") { _ui_paso = -1 }
    si juego.tecla_pulsada("abajo") o juego.tecla_pulsada("s") o juego.boton_pulsado("abajo") { _ui_paso = 1 }
    si ahora != 0 y ahora != _ui_eje { _ui_paso = ahora }
    _ui_eje = ahora
}

funcion _ui_aceptar(): logico {
    devolver juego.tecla_pulsada("entrar") o juego.tecla_pulsada("espacio") o juego.boton_pulsado("a")
}

funcion _ui_atras(): logico {
    devolver juego.tecla_pulsada("escape") o juego.boton_pulsado("b") o juego.boton_pulsado("atras")
}

# El error de una opción mal escrita, como en las funciones de C:
# «fn(): no conozco la opción 'x' (hay "a", "b" y "c")»
funcion _no_conozco(texto fn, texto c, lista validas): nulo {
    sea partes = []
    para cada texto v en validas { partes.agregar("\"" + v + "\"") }
    sea hay = partes[0]
    para (i = 1; i < partes.longitud(); i++) {
        hay = hay + (si i == partes.longitud() - 1 { " y " } sino { ", " }) + partes[i]
    }
    lanzar ErrorArgumento("{fn}(): no conozco la opción '{c}' (hay {hay})")
}

# opciones[c], o 'defecto' si no está
funcion _de(diccionario opciones, texto c, cualquiera defecto): cualquiera {
    si opciones.contiene(c) { devolver opciones[c] }
    devolver defecto
}

funcion _ui_sonar(cualquiera opciones, texto cual): nulo {
    si opciones.contiene(cual) y opciones[cual] != nulo { juego.reproducir(opciones[cual]) }
}

# Las opciones de letra para texto() y ancho_texto()
funcion _ui_letra(diccionario opciones, numero escala): diccionario {
    sea r = {"escala": escala}
    si opciones.contiene("fuente") { r["fuente"] = opciones["fuente"] }
    devolver r
}

fijo _MENU_OPCIONES = ["x", "y", "escala", "fuente", "color", "color_elegido", "separacion", "atras",
    "sonido_mover", "sonido_elegir"]

funcion _ui_opciones(cualquiera opciones, lista validos, texto fn): diccionario {
    si opciones == nulo { devolver {} }
    si no (opciones es diccionario) { lanzar ErrorTipo("{fn}() espera un diccionario de opciones") }
    para cada texto c en opciones {
        si no validos.contiene(c) {
            _no_conozco(fn, c, validos)
        }
    }
    devolver opciones
}

# menu(textos[, opciones]): dibuja un menú con esos textos para elegir, uno
# debajo de otro, y devuelve el elegido en el fotograma en que se elige (si
# no, nulo). Se llama en cada fotograma mientras se vea:
#   sea eleccion = juego.menu(["Jugar", "Opciones", "Salir"])
#   si eleccion == "Jugar" { juego.cambiar_escena("partida", 0.6) }
# Opciones: x, y (el centro de la primera opción; por defecto, el centro de la
# pantalla), escala (3), fuente, color, color_elegido, separacion, atras (lo
# que devuelve con escape o B: "Continuar" en una pausa), sonido_mover y
# sonido_elegir. Vuelve a la primera opción si deja de verse un rato.
funcion menu(cualquiera textos, cualquiera opciones = nulo): cualquiera {
    si no (textos es lista) o textos.longitud() == 0 {
        lanzar ErrorTipo("menu() espera una lista de textos, como [\"Jugar\", \"Salir\"]")
    }
    para cada cualquiera op en textos {
        si no (op es texto) { lanzar ErrorTipo("menu(): cada opción es un texto") }
    }
    sea aj = _ui_opciones(opciones, _MENU_OPCIONES, "menu")
    sea vistos = []                # lo que se ve, en el idioma elegido (devuelve el original)
    para cada texto op en textos { vistos.agregar(traducir(op)) }
    sea escala = _de(aj, "escala", 3)
    sea letra = _ui_letra(aj, escala)
    sea alto = juego.medir_texto("Ay", letra)[1]
    sea paso = alto + _de(aj, "separacion", alto * 0.6)
    sea cx = _de(aj, "x", juego.ancho() / 2)
    sea cy = _de(aj, "y", juego.alto() / 2 - paso * (textos.longitud() - 1) / 2)
    sea clave = texto.unir(textos, "|")
    sea ahora = juego.tiempo_real()
    si no _menus.contiene(clave) o ahora - _menus[clave]["visto"] > 0.25 {
        _menus[clave] = {"elegida": 0, "visto": ahora}
    }
    sea m = _menus[clave]
    m["visto"] = ahora
    sea antes = m["elegida"]
    sea total = textos.longitud()
    m["elegida"] = (m["elegida"] + _ui_paso + total) % total
    # el ratón o el dedo: señalar elige, tocar acepta
    sea r = juego.raton()
    sea mov = juego.movimiento_raton()
    sea tocada = -1
    para (i = 0; i < total; i++) {
        sea ancho = juego.ancho_texto(vistos[i], letra)
        sea arriba = cy + i * paso - paso * 0.2
        si r[0] >= cx - ancho / 2 - alto y r[0] <= cx + ancho / 2 + alto y r[1] >= arriba y r[1] < arriba + paso {
            si mov[0] != 0 o mov[1] != 0 o juego.clic(1) { m["elegida"] = i }
            si juego.clic(1) { tocada = i }
        }
    }
    si m["elegida"] != antes { _ui_sonar(aj, "sonido_mover") }
    # dibujar
    sea camara = juego.camara_actual()
    juego.camara()
    para (i = 0; i < total; i++) {
        sea elegida = i == m["elegida"]
        sea y_op = cy + i * paso
        si elegida {
            sea ancho = juego.ancho_texto(vistos[i], letra)
            juego.rectangulo(cx - ancho / 2 - alto * 0.6, y_op - alto * 0.3, ancho + alto * 1.2, alto * 1.6, [255, 255, 255, 40])
        }
        sea color = si elegida { _de(aj, "color_elegido", [255, 220, 80]) } sino { _de(aj, "color", [210, 210, 220]) }
        sea t = {"alinear": "centro", "color": color}
        para cada texto c en letra { t[c] = letra[c] }
        juego.texto(vistos[i], cx, y_op, t)
    }
    juego.camara(camara)
    # elegir
    si tocada >= 0 o _ui_aceptar() {
        _ui_sonar(aj, "sonido_elegir")
        _menus.eliminar(clave)
        devolver textos[m["elegida"]]
    }
    si aj.contiene("atras") y _ui_atras() {
        _menus.eliminar(clave)
        devolver aj["atras"]
    }
    devolver nulo
}

# dialogo(paginas[, opciones]): una caja de diálogo abajo de la pantalla, con el
# texto saliendo letra a letra, como en las aventuras y los RPG. 'paginas' es
# una página o una lista; cada página, un texto o un diccionario con "texto",
# "nombre" (quién habla), "retrato" (una imagen, o [hoja, cuadro]) y "respuestas" (una lista de
# textos para elegir; la elegida la da respuesta()). Aceptar (entrar, espacio,
# A o tocar) termina de escribir la página o pasa a la siguiente. Mientras
# dialogo_abierto() sea verdadero, el juego no debería mover al personaje:
#   si no juego.dialogo_abierto() { ...mover... }
# Opciones: escala (2), fuente, color, fondo, borde, velocidad (letras por
# segundo, 40), lineas (3), arriba (verdadero: arriba de la pantalla; si no se
# dice, va arriba solo mientras se vea el mando de la pantalla táctil) y sonido
# (suena con las letras). Una página que no cabe en las líneas se parte sola.
sea _dl = nulo               # el diálogo abierto, o nulo
sea _dl_cerrando = falso     # se cerró con la entrada de este fotograma
sea _dl_respuesta = nulo

fijo _DIALOGO_OPCIONES = ["escala", "fuente", "color", "fondo", "borde", "velocidad", "lineas", "arriba", "sonido"]
fijo _PAGINA_CAMPOS = ["texto", "nombre", "retrato", "respuestas"]

# Un texto partido en líneas que no pasen de 'ancho'
funcion _partir_lineas(texto t, numero ancho, diccionario letra): lista {
    sea lineas = []
    para cada texto parrafo en t.dividir("\n") {
        sea linea = ""
        para cada texto palabra en parrafo.dividir(" ") {
            sea con = si linea == "" { palabra } sino { linea + " " + palabra }
            si linea != "" y juego.ancho_texto(con, letra) > ancho {
                lineas.agregar(linea)
                linea = palabra
            } sino {
                linea = con
            }
        }
        lineas.agregar(linea)
    }
    devolver lineas
}

# Las medidas de la caja
funcion _dl_medidas(diccionario aj, logico con_retrato, numero filas = 0): diccionario {
    sea letra = _ui_letra(aj, _de(aj, "escala", 2))
    sea alto_letra = juego.medir_texto("Ay", letra)[1]
    sea margen = matematica.maximo(8, juego.ancho() / 50)
    sea relleno = alto_letra * 0.8
    sea paso = alto_letra * 1.4
    sea lineas = _de(aj, "lineas", 3)
    sea alto_caja = relleno * 2 + paso * matematica.maximo(lineas, filas) - (paso - alto_letra)
    sea retrato = si con_retrato { alto_caja - relleno } sino { 0 }
    devolver {"letra": letra, "alto_letra": alto_letra, "margen": margen, "relleno": relleno, "paso": paso,
        "lineas": lineas, "alto": alto_caja, "retrato": retrato,
        "ancho_texto": juego.ancho() - margen * 2 - relleno * 2 - (si con_retrato { retrato + relleno } sino { 0 })}
}

funcion dialogo(cualquiera paginas, cualquiera opciones = nulo): nulo {
    sea aj = _ui_opciones(opciones, _DIALOGO_OPCIONES, "dialogo")
    si paginas es texto o paginas es diccionario { paginas = [paginas] }
    si no (paginas es lista) o paginas.longitud() == 0 {
        lanzar ErrorTipo("dialogo() espera un texto, una página (\{\"nombre\": ..., \"texto\": ...}) o una lista de páginas")
    }
    # cada página, en trozos que caben en la caja
    sea trozos = []
    para cada cualquiera p en paginas {
        si p es texto { p = {"texto": p} }
        si no (p es diccionario) o no p.contiene("texto") o no (p["texto"] es texto) {
            lanzar ErrorTipo("dialogo(): cada página es un texto o un diccionario con \"texto\"")
        }
        para cada texto c en p {
            si no _PAGINA_CAMPOS.contiene(c) {
                lanzar ErrorArgumento("dialogo(): una página no tiene '{c}' (tiene \"texto\", \"nombre\", \"retrato\" y \"respuestas\")")
            }
        }
        sea respuestas = _de(p, "respuestas", [])
        si no (respuestas es lista) { lanzar ErrorTipo("dialogo(): \"respuestas\" es una lista de textos") }
        sea md = _dl_medidas(aj, p.contiene("retrato"))
        sea todas = _partir_lineas(traducir(p["texto"]), md["ancho_texto"], md["letra"])
        # las respuestas van en la última parte (la caja crece para que quepan)
        sea caben = md["lineas"]
        sea i = 0
        mientras i < todas.longitud() o i == 0 {
            sea quedan = todas.longitud() - i
            sea ultimo = quedan <= caben
            sea cuantas = si ultimo { quedan } sino { caben }
            sea nombre = _de(p, "nombre", nulo)
            sea trozo = {"lineas": [], "nombre": si nombre es texto { traducir(nombre) } sino { nombre }, "retrato": _de(p, "retrato", nulo),
                "respuestas": si ultimo { respuestas } sino { [] }}
            para (k = 0; k < cuantas; k++) { trozo["lineas"].agregar(todas[i + k]) }
            trozos.agregar(trozo)
            i = i + matematica.maximo(cuantas, 1)
        }
    }
    _dl = {"trozos": trozos, "opciones": aj, "pagina": 0, "letras": 0, "elegida": 0, "desde": juego.tiempo_real()}
    _dl_respuesta = nulo
}

funcion dialogo_abierto(): logico { devolver _dl != nulo o _dl_cerrando }
funcion respuesta(): cualquiera { devolver _dl_respuesta }
funcion cerrar_dialogo(): nulo { _dl = nulo }

funcion _dl_total(diccionario trozo): numero {
    sea n = 0
    para cada texto l en trozo["lineas"] { n = n + l.longitud() }
    devolver n
}

funcion _dl_siguiente(): nulo {
    _dl["pagina"] = _dl["pagina"] + 1
    _dl["letras"] = 0
    _dl["elegida"] = 0
    si _dl["pagina"] >= _dl["trozos"].longitud() {
        _dl = nulo
        _dl_cerrando = verdadero
    }
}

# Dónde va la caja y cada respuesta
funcion _dl_caja(): diccionario {
    sea trozo = _dl["trozos"][_dl["pagina"]]
    sea md = _dl_medidas(_dl["opciones"], trozo["retrato"] != nulo, trozo["lineas"].longitud() + trozo["respuestas"].longitud())
    # sin decir nada, abajo; pero con el mando de la pantalla a la vista, arriba, que abajo lo tapan los botones
    sea arriba = si _de(_dl["opciones"], "arriba", _mt_puesto) { md["margen"] + md["alto_letra"] * 1.5 } sino { juego.alto() - md["margen"] - md["alto"] }
    md["x"] = md["margen"]
    md["y"] = arriba
    md["ancho"] = juego.ancho() - md["margen"] * 2
    md["texto_x"] = md["x"] + md["relleno"] + (si trozo["retrato"] != nulo { md["retrato"] + md["relleno"] } sino { 0 })
    devolver md
}

# En _entrada_ui: avanza las letras y atiende a aceptar
funcion _dl_entrada(): nulo {
    _dl_cerrando = falso
    si _dl == nulo { devolver nulo }
    sea ahora = juego.tiempo_real()
    sea trozo = _dl["trozos"][_dl["pagina"]]
    sea total = _dl_total(trozo)
    sea antes = matematica.piso(_dl["letras"])
    _dl["letras"] = matematica.minimo(total, _dl["letras"] + _de(_dl["opciones"], "velocidad", 40) * (ahora - _dl["desde"]))
    _dl["desde"] = ahora
    si _dl["opciones"].contiene("sonido") y matematica.piso(_dl["letras"]) != antes y antes % 2 == 0 {
        juego.reproducir(_dl["opciones"]["sonido"], {"grupo": "voces"})
    }
    sea acabada = _dl["letras"] >= total
    sea respuestas = trozo["respuestas"]
    si no acabada {
        si _ui_aceptar() o _ui_atras() o juego.clic(1) { _dl["letras"] = total }
        devolver nulo
    }
    si respuestas.longitud() == 0 {
        si _ui_aceptar() o _ui_atras() o juego.clic(1) { _dl_siguiente() }
        devolver nulo
    }
    # elegir una respuesta
    sea n = respuestas.longitud()
    _dl["elegida"] = (_dl["elegida"] + _ui_paso + n) % n
    sea md = _dl_caja()
    sea r = juego.raton()
    sea mov = juego.movimiento_raton()
    sea tocada = falso
    para (i = 0; i < n; i++) {
        sea arriba = md["y"] + md["relleno"] + (trozo["lineas"].longitud() + i) * md["paso"] - md["paso"] * 0.2
        si r[0] >= md["x"] y r[0] <= md["x"] + md["ancho"] y r[1] >= arriba y r[1] < arriba + md["paso"] {
            si mov[0] != 0 o mov[1] != 0 o juego.clic(1) { _dl["elegida"] = i }
            si juego.clic(1) { tocada = verdadero }
        }
    }
    si tocada o _ui_aceptar() {
        _dl_respuesta = respuestas[_dl["elegida"]]
        _dl_siguiente()
    }
}

# En _presentar: la caja, encima de lo del juego
funcion _dibujar_dialogo(): nulo {
    si _dl == nulo { devolver nulo }
    sea aj = _dl["opciones"]
    sea trozo = _dl["trozos"][_dl["pagina"]]
    sea md = _dl_caja()
    sea camara = juego.camara_actual()
    juego.camara()
    sea borde = _de(aj, "borde", [255, 255, 255])
    juego.rectangulo(md["x"], md["y"], md["ancho"], md["alto"], _de(aj, "fondo", [16, 18, 36, 235]))
    juego.contorno(md["x"], md["y"], md["ancho"], md["alto"], borde)
    sea color = _de(aj, "color", [240, 240, 240])
    sea letra = {"color": color}
    para cada texto c en md["letra"] { letra[c] = md["letra"][c] }
    si trozo["nombre"] != nulo {          # quién habla, en una pestaña encima
        sea ancho_nombre = juego.ancho_texto(trozo["nombre"], md["letra"]) + md["relleno"] * 2
        sea alto_nombre = md["alto_letra"] * 1.5
        juego.rectangulo(md["x"], md["y"] - alto_nombre, ancho_nombre, alto_nombre, _de(aj, "fondo", [16, 18, 36, 235]))
        juego.contorno(md["x"], md["y"] - alto_nombre, ancho_nombre, alto_nombre + 1, borde)
        sea letra_nombre = {"color": [255, 220, 80]}
        para cada texto c en md["letra"] { letra_nombre[c] = md["letra"][c] }
        juego.texto(trozo["nombre"], md["x"] + md["relleno"], md["y"] - alto_nombre + md["alto_letra"] * 0.25, letra_nombre)
    }
    si trozo["retrato"] != nulo {
        sea retrato = trozo["retrato"]
        sea como = {"ancho": md["retrato"], "alto": md["retrato"]}
        si retrato es lista {                 # [hoja, cuadro]: un cuadro de una hoja
            como["cuadro"] = retrato[1]
            retrato = retrato[0]
        }
        juego.dibujar(retrato, md["x"] + md["relleno"], md["y"] + md["relleno"] / 2, como)
    }
    # las letras que ya han salido
    sea quedan = matematica.piso(_dl["letras"])
    sea fila = md["y"] + md["relleno"]
    para cada texto linea en trozo["lineas"] {
        si quedan <= 0 { romper }
        sea parte = linea
        si linea.longitud() > quedan {
            parte = ""
            sea k = 0
            para cada texto ch en linea {
                si k >= quedan { romper }
                parte = parte + ch
                k = k + 1
            }
        }
        juego.texto(parte, md["texto_x"], fila, letra)
        quedan = quedan - linea.longitud()
        fila = fila + md["paso"]
    }
    si _dl["letras"] >= _dl_total(trozo) {
        sea respuestas = trozo["respuestas"]
        si respuestas.longitud() > 0 {
            para (i = 0; i < respuestas.longitud(); i++) {
                sea elegida = i == _dl["elegida"]
                sea lr = {"color": si elegida { [255, 220, 80] } sino { color }}
                para cada texto c en md["letra"] { lr[c] = md["letra"][c] }
                juego.texto((si elegida { "> " } sino { "  " }) + traducir(respuestas[i]), md["texto_x"], fila + i * md["paso"], lr)
            }
        } sino si (juego.tiempo_real() * 2) % 2 < 1 {     # el triangulito de «sigue»
            sea t = md["alto_letra"] * 0.5
            sea ax = md["x"] + md["ancho"] - md["relleno"] - t * 2
            sea ay = md["y"] + md["alto"] - md["relleno"] - t
            para (k = 0; k < t; k++) {
                juego.rectangulo(ax + k, ay + k, (t - k) * 2 - k, 1, borde)
            }
        }
    }
    juego.camara(camara)
}

# ── Física sencilla ──
# Cuerpos que caen, rebotan, se empujan y chocan entre ellos y con un mapa:
# cajas, pelotas, plataformas que se mueven y el propio personaje. Un cuerpo
# es un diccionario como los de mover_en_mapa (x, y, ancho, alto, vx, vy) con
# lo suyo: masa, rebote, friccion, fijo, sensor, gravedad. Los que llevan
# "gira" (o "puntos", un polígono) giran al chocar: ver «Física con giros».
#   sea mundo = juego.fisica({"gravedad": 900, "mapa": NIVEL})
#   sea caja = juego.cuerpo(mundo, {"x": 100, "y": 50, "ancho": 24, "alto": 24})
#   # en cada fotograma:
#   juego.avanzar_fisica(mundo)

fijo _FISICA_OPCIONES = ["gravedad", "mapa", "pasos", "iteraciones"]
sea _cuerpos_creados = 0

funcion fisica(cualquiera opciones = nulo): diccionario {
    sea op = _ui_opciones(opciones, _FISICA_OPCIONES, "fisica")
    sea g = _de(op, "gravedad", 900)
    si g es numero { g = [0, g] }
    si no (g es lista) o g.longitud() != 2 { lanzar ErrorTipo("fisica(): \"gravedad\" es un número (hacia abajo) o [x, y]") }
    sea it = _de(op, "iteraciones", 8)
    si no (it es numero) o it < 1 o it > 100 { lanzar ErrorArgumento("fisica(): \"iteraciones\" va de 1 a 100 (más: pilas más quietas, pero más lento)") }
    devolver {"gravedad": g, "mapa": _de(op, "mapa", nulo), "pasos": _de(op, "pasos", 120),
        "iteraciones": it, "_pasos_puestos": op.contiene("pasos"), "cuerpos": [], "toques": {}, "uniones": [], "_cache": {}, "_casillas": {},
        "_sin_choque": {}}
}

funcion _es_mundo(cualquiera m, texto fn): nulo {
    si no (m es diccionario) o no m.contiene("cuerpos") {
        lanzar ErrorTipo("{fn}() espera un mundo de juego.fisica()")
    }
}

# cuerpo(mundo, datos): añade un cuerpo al mundo y lo devuelve (el mismo
# diccionario, con lo que falte puesto). Con "radio" es un círculo (x, y es
# su esquina, como en las cajas). "fijo": no lo mueven los choques ni la
# gravedad (suelos, paredes, plataformas que se mueven con su vx, vy).
# "sensor": no choca, solo cuenta lo que toca (monedas, zonas).
funcion cuerpo(cualquiera mundo, cualquiera datos): diccionario {
    _es_mundo(mundo, "cuerpo")
    si no (datos es diccionario) { lanzar ErrorTipo("cuerpo() espera (mundo, \{\"x\": ..., \"y\": ..., \"ancho\": ..., \"alto\": ...})") }
    si datos.contiene("radio") {
        datos["ancho"] = datos["radio"] * 2
        datos["alto"] = datos["radio"] * 2
    }
    si datos.contiene("puntos") { _medir_puntos(datos) }
    para cada texto c en ["x", "y", "ancho", "alto"] {
        si no datos.contiene(c) o no (datos[c] es numero) {
            lanzar ErrorTipo("cuerpo(): falta \"{c}\" (un número; o \"radio\" en vez de ancho y alto)")
        }
    }
    para cada texto c en ["vx", "vy", "rebote"] { si no datos.contiene(c) { datos[c] = 0 } }
    si no datos.contiene("masa") { datos["masa"] = 1 }
    si no datos.contiene("friccion") { datos["friccion"] = 0.5 }
    si no datos.contiene("gravedad") { datos["gravedad"] = 1 }
    si no datos.contiene("fijo") { datos["fijo"] = falso }
    si no datos.contiene("sensor") { datos["sensor"] = falso }
    si datos["masa"] <= 0 { lanzar ErrorArgumento("cuerpo(): la masa tiene que ser mayor que 0") }
    si datos.contiene("puntos") o (datos.contiene("gira") y datos["gira"]) { _preparar_rigido(datos) }
    _cuerpos_creados = _cuerpos_creados + 1
    datos["id_fisica"] = _cuerpos_creados
    datos["en_suelo"] = falso
    mundo["cuerpos"].agregar(datos)
    devolver datos
}

funcion quitar_cuerpo(cualquiera mundo, cualquiera c): nulo {
    _es_mundo(mundo, "quitar_cuerpo")
    sea quedan = []
    para cada diccionario vecino en mundo["cuerpos"] {
        si vecino["id_fisica"] != c["id_fisica"] { quedan.agregar(vecino) }
    }
    mundo["cuerpos"] = quedan
    sea uniones = []                     # y lo que lo unía a otros
    para cada diccionario u en mundo["uniones"] {
        si u["a"]["id_fisica"] != c["id_fisica"] y no (u["b"] es diccionario y u["b"]["id_fisica"] == c["id_fisica"]) {
            uniones.agregar(u)
        }
    }
    mundo["uniones"] = uniones
}

# empujar(cuerpo, fx, fy[, punto]): un golpe: cambia su velocidad según su
# masa. Si gira y el golpe es en un punto [x, y] que no es su centro, gira.
funcion empujar(cualquiera c, numero fx, numero fy, cualquiera punto = nulo): nulo {
    si c["fijo"] { devolver nulo }
    c["vx"] = c["vx"] + fx / c["masa"]
    c["vy"] = c["vy"] + fy / c["masa"]
    si punto != nulo y c.contiene("_forma") y c["gira"] {
        sea p = _punto(punto, nulo, "empujar")
        sea centro = centro_cuerpo(c)
        sea rx = p[0] - centro[0]
        sea ry = p[1] - centro[1]
        c["vgiro"] = c["vgiro"] + matematica.grados((rx * fy - ry * fx) / (c["masa"] * c["_forma"]["inercia"]))
    }
}

# tocando(mundo, cuerpo): los cuerpos que tocaba en el último avanzar_fisica()
funcion tocando(cualquiera mundo, cualquiera c): lista {
    _es_mundo(mundo, "tocando")
    sea clave = "{c["id_fisica"]}"
    si mundo["toques"].contiene(clave) { devolver mundo["toques"][clave] }
    devolver []
}

funcion _apunta_toque(diccionario mundo, diccionario a, diccionario b): nulo {
    sea ka = "{a["id_fisica"]}"
    si no mundo["toques"].contiene(ka) { mundo["toques"][ka] = [] }
    sea ya = falso
    para cada diccionario t en mundo["toques"][ka] { si t["id_fisica"] == b["id_fisica"] { ya = verdadero } }
    si no ya { mundo["toques"][ka].agregar(b) }
}

# Mueve un cuerpo (dx, dy) sin meterlo en las paredes del mapa
funcion _desplazar(cualquiera mapa, diccionario c, numero dx, numero dy): nulo {
    si mapa == nulo o c["sensor"] {
        c["x"] = c["x"] + dx
        c["y"] = c["y"] + dy
        devolver nulo
    }
    sea vx = c["vx"]
    sea vy = c["vy"]
    sea suelo = c["en_suelo"]
    c["vx"] = dx
    c["vy"] = dy
    juego.mapa.mover(mapa, c, 1)
    c["vx"] = vx
    c["vy"] = vy
    c["en_suelo"] = suelo o c["en_suelo"]
}

# ¿se tocan? Si sí, [nx, ny, cuanto]: hacia dónde hay que mover 'a' para separarlos
funcion _solape(diccionario a, diccionario b): cualquiera {
    sea ax = a["x"] + a["ancho"] / 2
    sea ay = a["y"] + a["alto"] / 2
    sea bx = b["x"] + b["ancho"] / 2
    sea by = b["y"] + b["alto"] / 2
    sea dx = ax - bx
    sea dy = ay - by
    si a.contiene("radio") y b.contiene("radio") {      # dos círculos
        sea d = matematica.raiz(dx * dx + dy * dy)
        sea r = a["radio"] + b["radio"]
        si d >= r { devolver nulo }
        si d == 0 { devolver [0, -1, r] }
        devolver [dx / d, dy / d, r - d]
    }
    sea a_circulo = a.contiene("radio")
    si a_circulo != b.contiene("radio") {             # un círculo y una caja: las esquinas cuentan
        sea circ = si a_circulo { a } sino { b }
        sea caja = si a_circulo { b } sino { a }
        sea r = circ["radio"]
        sea cx = circ["x"] + r
        sea cy = circ["y"] + r
        sea ex = cx - matematica.maximo(caja["x"], matematica.minimo(cx, caja["x"] + caja["ancho"]))
        sea ey = cy - matematica.maximo(caja["y"], matematica.minimo(cy, caja["y"] + caja["alto"]))
        sea d2 = ex * ex + ey * ey
        si d2 >= r * r { devolver nulo }
        si d2 > 0 {                                     # si el centro está dentro, como dos cajas
            sea d = matematica.raiz(d2)
            si a_circulo { devolver [ex / d, ey / d, r - d] }
            devolver [-ex / d, -ey / d, r - d]
        }
    }
    sea px = (a["ancho"] + b["ancho"]) / 2 - matematica.abs(dx)
    sea py = (a["alto"] + b["alto"]) / 2 - matematica.abs(dy)
    si px <= 0 o py <= 0 { devolver nulo }
    si px < py { devolver [si dx < 0 { -1 } sino { 1 }, 0, px] }
    devolver [0, si dy < 0 { -1 } sino { 1 }, py]
}

funcion _paso_fisica(diccionario mundo, numero dt): nulo {
    sea g = mundo["gravedad"]
    sea mapa = mundo["mapa"]
    sea cuerpos = mundo["cuerpos"]
    # los fijos que se mueven (plataformas) llevan encima lo que tienen apoyado
    para cada diccionario c en cuerpos {
        si c["fijo"] y (c["vx"] != 0 o c["vy"] != 0) y no c.contiene("_forma") {
            sea mx = c["vx"] * dt
            sea my = c["vy"] * dt
            para cada diccionario vecino en cuerpos {
                si no vecino["fijo"] y no vecino["sensor"] y no vecino.contiene("_forma") y
                    vecino["x"] + vecino["ancho"] > c["x"] y vecino["x"] < c["x"] + c["ancho"] y
                    matematica.abs(vecino["y"] + vecino["alto"] - c["y"]) < 1.5 {
                    _desplazar(mapa, vecino, mx, si my < 0 { my } sino { 0 })
                }
            }
            c["x"] = c["x"] + mx
            c["y"] = c["y"] + my
        }
    }
    # la gravedad y el mapa
    para cada diccionario c en cuerpos {
        si c["fijo"] o c.contiene("_forma") { continuar }
        c["vx"] = c["vx"] + g[0] * c["gravedad"] * dt
        c["vy"] = c["vy"] + g[1] * c["gravedad"] * dt
        c["en_suelo"] = falso
        si mapa != nulo y no c["sensor"] {
            sea vx = c["vx"]
            sea vy = c["vy"]
            juego.mapa.mover(mapa, c, dt)
            sea e = c["rebote"]
            si c["en_suelo"] y vy > 0 {
                c["vy"] = si vy * e > 40 { -vy * e } sino { 0 }
                c["vx"] = c["vx"] * matematica.maximo(0, 1 - c["friccion"] * 8 * dt)
            }
            si c["techo"] y vy < 0 { c["vy"] = -vy * e }
            si c["pared"] != 0 { c["vx"] = -vx * e }
        } sino {
            c["x"] = c["x"] + c["vx"] * dt
            c["y"] = c["y"] + c["vy"] * dt
        }
    }
    # los choques entre cuerpos
    sea n = cuerpos.longitud()
    para (i = 0; i < n; i++) {
        sea a = cuerpos[i]
        si a.contiene("_forma") { continuar }
        sea izq = a["x"]
        sea der = izq + a["ancho"]
        sea arr = a["y"]
        sea aba = arr + a["alto"]
        para (j = i + 1; j < n; j++) {
            sea b = cuerpos[j]
            si b.contiene("_forma") { continuar }
            sea bx = b["x"]
            sea bz = b["y"]
            # lo rápido primero: si están lejos, nada
            si bx >= der o bx + b["ancho"] <= izq o bz >= aba o bz + b["alto"] <= arr { continuar }
            si a["fijo"] y b["fijo"] { continuar }
            sea s = _solape(a, b)
            si s == nulo { continuar }
            _apunta_toque(mundo, a, b)
            _apunta_toque(mundo, b, a)
            si a["sensor"] o b["sensor"] { continuar }
            sea ia = si a["fijo"] { 0 } sino { 1 / a["masa"] }
            sea ib = si b["fijo"] { 0 } sino { 1 / b["masa"] }
            sea nx = s[0]
            sea ny = s[1]
            # separarlos según su masa
            si no a["fijo"] { _desplazar(mapa, a, nx * s[2] * ia / (ia + ib), ny * s[2] * ia / (ia + ib)) }
            si no b["fijo"] { _desplazar(mapa, b, -nx * s[2] * ib / (ia + ib), -ny * s[2] * ib / (ia + ib)) }
            si ny < -0.5 { a["en_suelo"] = verdadero }
            si ny > 0.5 { b["en_suelo"] = verdadero }
            # si uno no se podía mover (contra una pared), el otro se aparta del todo
            sea s2 = _solape(a, b)
            si s2 != nulo y s2[2] > 0.01 {
                si no b["fijo"] y (a["fijo"] o ib > 0) { _desplazar(mapa, b, -s2[0] * s2[2], -s2[1] * s2[2]) }
                sino si no a["fijo"] { _desplazar(mapa, a, s2[0] * s2[2], s2[1] * s2[2]) }
            }
            # y que no sigan acercándose (con su rebote)
            sea v = (a["vx"] - b["vx"]) * nx + (a["vy"] - b["vy"]) * ny
            si v < 0 {
                sea e = matematica.maximo(a["rebote"], b["rebote"])
                si -v < 40 { e = 0 }                  # sin botecitos al estar apoyado
                sea imp = -(1 + e) * v / (ia + ib)
                a["vx"] = a["vx"] + imp * ia * nx
                a["vy"] = a["vy"] + imp * ia * ny
                b["vx"] = b["vx"] - imp * ib * nx
                b["vy"] = b["vy"] - imp * ib * ny
            }
            # apoyados uno en vecino: el de arriba se frena hacia la velocidad del de abajo
            si matematica.abs(ny) > 0.5 {
                sea f = matematica.minimo(1, (a["friccion"] + b["friccion"]) / 2 * 8 * dt)
                sea arriba = si ny < 0 { a } sino { b }
                sea abajo = si ny < 0 { b } sino { a }
                si no arriba["fijo"] { arriba["vx"] = arriba["vx"] + (abajo["vx"] - arriba["vx"]) * f }
            }
        }
    }
}

# avanzar_fisica(mundo[, dt]): mueve todo lo de un fotograma (en pasos
# pequeños, para que nada atraviese nada)
funcion avanzar_fisica(cualquiera mundo, cualquiera dt = nulo): nulo {
    _es_mundo(mundo, "avanzar_fisica")
    si dt == nulo { dt = juego.dt() }
    mundo["toques"] = {}
    si dt <= 0 { devolver nulo }
    sea rigidos = mundo["uniones"].longitud() > 0
    para cada diccionario c en mundo["cuerpos"] { si c.contiene("_forma") { rigidos = verdadero } }
    # con cuerpos que giran bastan 60 pasos por segundo (los impulsos van de un paso al siguiente)
    sea por_segundo = si rigidos y no mundo["_pasos_puestos"] { 60 } sino { mundo["pasos"] }
    sea pasos = matematica.maximo(1, matematica.techo(dt * por_segundo - 0.000001))
    si rigidos { _rigidos_leer(mundo) }
    para (k = 0; k < pasos; k++) {
        _paso_fisica(mundo, dt / pasos)
        si rigidos { _paso_rigido(mundo, dt / pasos) }
    }
    si rigidos { _rigidos_escribir(mundo) }
    # al acabar, en_suelo dice si está apoyado en algo
    para cada diccionario c en mundo["cuerpos"] {
        si no c["fijo"] y no c["en_suelo"] y mundo["mapa"] != nulo y no c["sensor"] y no c.contiene("_forma") {
            c["en_suelo"] = juego.mapa.solido(mundo["mapa"], matematica.piso((c["x"] + c["ancho"] / 2) / mundo["mapa"]["tamaño"]),
                matematica.piso((c["y"] + c["alto"] + 0.5) / mundo["mapa"]["tamaño"]))
        }
    }
}

# ── Física con giros ──
# Un cuerpo con "gira": verdadero, o con "puntos" (un polígono convexo), gira
# al chocar: lleva "angulo" (en grados, como dibujar()) y "vgiro" (grados por
# segundo). Sus esquinas chocan de verdad, rueda, vuelca y se apila. Con
# cuerda() y bisagra() se unen dos cuerpos (o un cuerpo y un punto fijo).
# Su (x, y) es la esquina de la caja sin girar, como en los demás: el centro
# no se mueve al girar, así que se dibuja con juego.dibujar(imagen, c["x"],
# c["y"], {"angulo": c["angulo"]}).
#
# Se resuelve como Box2D Lite: en cada paso se buscan los puntos de contacto
# y se ajustan las velocidades varias veces ("iteraciones" del mundo) con
# impulsos, empezando por los del paso anterior, para que las pilas se queden
# quietas. Los cuerpos que no giran también chocan con los que giran (como si
# no pudieran girar); entre ellos sigue todo como antes.

fijo _HUECO = 0.5          # lo que se deja meter un cuerpo en otro sin empujarlo (quita temblores)
fijo _CORREGIR = 0.2       # qué parte de lo que se han metido se corrige en cada paso

fijo _CORREGIR_UNION = 0.3     # en las uniones, algo más
fijo _SIN_BOTE = 40        # por debajo de esta velocidad (píxeles por segundo) no rebota

# ancho y alto de un polígono, por sus puntos
funcion _medir_puntos(diccionario c): nulo {
    sea ps = c["puntos"]
    sea uso = "cuerpo(): \"puntos\" es una lista de puntos [[x, y], [x, y], [x, y], ...] (al menos 3), desde (x, y)"
    si no (ps es lista) o ps.longitud() < 3 { lanzar ErrorTipo(uso) }
    si ps.longitud() > 16 { lanzar ErrorArgumento("cuerpo(): un polígono tiene como mucho 16 puntos") }
    sea x1 = 0
    sea y1 = 0
    para cada cualquiera p en ps {
        si no (p es lista) o p.longitud() < 2 o no (p[0] es numero) o no (p[1] es numero) { lanzar ErrorTipo(uso) }
        x1 = matematica.maximo(x1, p[0])
        y1 = matematica.maximo(y1, p[1])
    }
    c["ancho"] = x1
    c["alto"] = y1
}

# La forma del cuerpo desde su centro de masas: {"radio"} o {"puntos", "normales"},
# con "cm" (dónde está el centro desde (x, y)) e "inercia" (por unidad de masa)
funcion _preparar_rigido(diccionario c): nulo {
    si no c.contiene("angulo") { c["angulo"] = 0 }
    si no c.contiene("vgiro") { c["vgiro"] = 0 }
    si no c.contiene("gira") { c["gira"] = verdadero }
    para cada texto k en ["angulo", "vgiro"] {
        si no (c[k] es numero) { lanzar ErrorTipo("cuerpo(): \"{k}\" es un número (en grados)") }
    }
    si c.contiene("radio") {
        c["_forma"] = {"radio": c["radio"], "cm": [c["radio"], c["radio"]], "inercia": c["radio"] * c["radio"] / 2}
        devolver nulo
    }
    sea ps = []
    si c.contiene("puntos") {
        para cada lista p en c["puntos"] { ps.agregar([p[0], p[1]]) }
    } sino {
        ps = [[0, 0], [c["ancho"], 0], [c["ancho"], c["alto"]], [0, c["alto"]]]
    }
    # el centro de masas (el de la superficie) y hacia dónde van los puntos
    sea n = ps.longitud()
    sea area = 0
    sea cx = 0
    sea cy = 0
    para (i = 0; i < n; i++) {
        sea p = ps[i]
        sea q = ps[(i + 1) % n]
        sea cr = p[0] * q[1] - q[0] * p[1]
        area = area + cr
        cx = cx + (p[0] + q[0]) * cr
        cy = cy + (p[1] + q[1]) * cr
    }
    si matematica.abs(area) < 0.0001 { lanzar ErrorArgumento("cuerpo(): los puntos del polígono no encierran nada (están en línea)") }
    cx = cx / (3 * area)
    cy = cy / (3 * area)
    si area < 0 { ps = ps.invertir() }
    sea locales = []
    para cada lista p en ps { locales.agregar([p[0] - cx, p[1] - cy]) }
    sea normales = []
    sea arriba = 0
    sea abajo = 0
    para (i = 0; i < n; i++) {
        sea p = locales[i]
        sea q = locales[(i + 1) % n]
        sea r = locales[(i + 2) % n]
        si (q[0] - p[0]) * (r[1] - q[1]) - (q[1] - p[1]) * (r[0] - q[0]) < -0.0001 {
            lanzar ErrorArgumento("cuerpo(): el polígono tiene que ser convexo (sin entrantes); uno con entrantes se hace con varios")
        }
        sea ex = q[0] - p[0]
        sea ey = q[1] - p[1]
        sea l = matematica.raiz(ex * ex + ey * ey)
        si l < 0.0001 { lanzar ErrorArgumento("cuerpo(): el polígono tiene dos puntos repetidos seguidos") }
        normales.agregar([ey / l, -ex / l])
        sea cr = p[0] * q[1] - q[0] * p[1]
        arriba = arriba + cr * (p[0] * p[0] + p[1] * p[1] + p[0] * q[0] + p[1] * q[1] + q[0] * q[0] + q[1] * q[1])
        abajo = abajo + cr
    }
    c["_forma"] = {"puntos": locales, "normales": normales, "cm": [cx, cy], "inercia": arriba / (6 * abajo)}
}

# El centro de masas de un cuerpo, [x, y] (en uno que no gira, el de su caja)
funcion centro_cuerpo(cualquiera c): lista {
    si no (c es diccionario) o no c.contiene("id_fisica") { lanzar ErrorTipo("centro_cuerpo() espera un cuerpo de juego.cuerpo()") }
    si c.contiene("_forma") { devolver [c["x"] + c["_forma"]["cm"][0], c["y"] + c["_forma"]["cm"][1]] }
    devolver [c["x"] + c["ancho"] / 2, c["y"] + c["alto"] / 2]
}

# puntos_cuerpo(c): su contorno en el mundo, ya girado (para poligono())
funcion puntos_cuerpo(cualquiera c): lista {
    sea centro = centro_cuerpo(c)
    sea a = 0
    si c.contiene("_forma") { a = matematica.radianes(c["angulo"]) }
    sea co = matematica.coseno(a)
    sea se = matematica.seno(a)
    sea locales = []
    si c.contiene("radio") {
        para (i = 0; i < 24; i++) {
            sea t = i * matematica.PI / 12
            locales.agregar([c["radio"] * matematica.coseno(t), c["radio"] * matematica.seno(t)])
        }
    } sino si c.contiene("_forma") {
        locales = c["_forma"]["puntos"]
    } sino {
        sea w = c["ancho"] / 2
        sea h = c["alto"] / 2
        locales = [[-w, -h], [w, -h], [w, h], [-w, h]]
    }
    sea r = []
    para cada lista p en locales { r.agregar([centro[0] + p[0] * co - p[1] * se, centro[1] + p[0] * se + p[1] * co]) }
    devolver r
}

# dibujar_cuerpo(c[, color[, opciones]]): lo dibuja tal cual es (para probar,
# o para juegos de formas). Opciones: las de poligono() ("relleno", "capa").
# Con relleno, el borde va algo más oscuro (para que se distingan dos cajas juntas).
funcion dibujar_cuerpo(cualquiera c, cualquiera color = [220, 220, 220], cualquiera opciones = nulo): nulo {
    sea ps = puntos_cuerpo(c)
    sea op = {}
    si opciones != nulo {
        si no (opciones es diccionario) { lanzar ErrorTipo("dibujar_cuerpo(): las opciones son un diccionario (\"relleno\", \"capa\")") }
        para cada texto k en opciones { op[k] = opciones[k] }
    }
    juego.poligono(ps, color, op)
    si op.contiene("relleno") y no op["relleno"] { devolver nulo }
    sea borde = si color es lista y color.longitud() >= 3 { [color[0] * 0.6, color[1] * 0.6, color[2] * 0.6] } sino { [0, 0, 0] }
    op["relleno"] = falso
    juego.poligono(ps, borde, op)
    si c.contiene("radio") y c.contiene("_forma") {         # una raya, para que se vea girar
        sea centro = centro_cuerpo(c)
        sea a = matematica.radianes(c["angulo"])
        sea antes = nulo
        si op.contiene("capa") { antes = juego.capa(op["capa"]) }     # en la misma capa que el círculo
        juego.linea(centro[0], centro[1], centro[0] + c["radio"] * matematica.coseno(a),
            centro[1] + c["radio"] * matematica.seno(a), borde)
        si antes != nulo { juego.capa(antes) }
    }
}

# Pasa lo que puso el juego (x, y, angulo, vgiro) a lo de dentro (centro, radianes)
funcion _rigidos_leer(diccionario mundo): nulo {
    para cada diccionario c en mundo["cuerpos"] {
        si c.contiene("_forma") {
            sea f = c["_forma"]
            c["_px"] = c["x"] + f["cm"][0]
            c["_py"] = c["y"] + f["cm"][1]
            c["_a"] = matematica.radianes(c["angulo"])
            c["_w"] = matematica.radianes(c["vgiro"])
            c["_im"] = si c["fijo"] { 0 } sino { 1 / c["masa"] }
            c["_ii"] = si c["fijo"] o no c["gira"] { 0 } sino { 1 / (c["masa"] * f["inercia"]) }
            c["en_suelo"] = falso
        } sino {
            c["_a"] = 0
            c["_w"] = 0
            c["_ii"] = 0
            c["_im"] = si c["fijo"] { 0 } sino { 1 / c["masa"] }
        }
    }
}

funcion _rigidos_escribir(diccionario mundo): nulo {
    para cada diccionario c en mundo["cuerpos"] {
        si c.contiene("_forma") {
            sea f = c["_forma"]
            c["x"] = c["_px"] - f["cm"][0]
            c["y"] = c["_py"] - f["cm"][1]
            sea a = matematica.grados(c["_a"]) % 360
            c["angulo"] = si a > 180 { a - 360 } sino { a }
            c["vgiro"] = matematica.grados(c["_w"])
        }
    }
}

# Dónde está cada cuerpo en este paso: centro, esquinas y normales giradas, y su caja
funcion _geometria(diccionario c): nulo {
    si c.contiene("_forma") {
        sea f = c["_forma"]
        si f.contiene("radio") {
            sea r = f["radio"]
            c["_caja"] = [c["_px"] - r, c["_py"] - r, c["_px"] + r, c["_py"] + r]
            devolver nulo
        }
        sea px = c["_px"]
        sea py = c["_py"]
        sea co = matematica.coseno(c["_a"])
        sea se = matematica.seno(c["_a"])
        sea vs = []
        sea x0 = px
        sea y0 = py
        sea x1 = px
        sea y1 = py
        para cada lista p en f["puntos"] {
            sea x = px + p[0] * co - p[1] * se
            sea y = py + p[0] * se + p[1] * co
            vs.agregar([x, y])
            si x < x0 { x0 = x }
            si x > x1 { x1 = x }
            si y < y0 { y0 = y }
            si y > y1 { y1 = y }
        }
        sea ns = []
        para cada lista q en f["normales"] { ns.agregar([q[0] * co - q[1] * se, q[0] * se + q[1] * co]) }
        c["_v"] = vs
        c["_n"] = ns
        c["_caja"] = [x0, y0, x1, y1]
        devolver nulo
    }
    # uno que no gira: su caja (o su círculo), tal cual
    sea x = c["x"]
    sea y = c["y"]
    sea w = c["ancho"]
    sea h = c["alto"]
    c["_px"] = x + w / 2
    c["_py"] = y + h / 2
    c["_caja"] = [x, y, x + w, y + h]
    si no c.contiene("radio") {
        c["_v"] = [[x, y], [x + w, y], [x + w, y + h], [x, y + h]]
        c["_n"] = [[0, -1], [1, 0], [0, 1], [-1, 0]]
    }
}

funcion _radio_de(diccionario c): cualquiera {
    si c.contiene("_forma") {
        si c["_forma"].contiene("radio") { devolver c["_forma"]["radio"] }
        devolver nulo
    }
    si c.contiene("radio") { devolver c["radio"] }
    devolver nulo
}

# Los puntos de contacto entre a y b: [nx, ny, separacion, x, y, clave] con la
# normal de a hacia b y la separación negativa si se han metido uno en otro
funcion _contactos(diccionario a, diccionario b): lista {
    sea ra = _radio_de(a)
    sea rb = _radio_de(b)
    si ra != nulo y rb != nulo {
        sea dx = b["_px"] - a["_px"]
        sea dy = b["_py"] - a["_py"]
        sea d = matematica.raiz(dx * dx + dy * dy)
        sea s = d - ra - rb
        si s > 0 { devolver [] }
        sea nx = 0
        sea ny = 1
        si d > 0.0001 {
            nx = dx / d
            ny = dy / d
        }
        sea k = ra + s / 2
        devolver [[nx, ny, s, a["_px"] + nx * k, a["_py"] + ny * k, "cc"]]
    }
    si ra != nulo {
        sea cs = _poligono_circulo(b, a, ra)
        para cada lista c en cs {
            c[0] = -c[0]
            c[1] = -c[1]
        }
        devolver cs
    }
    si rb != nulo { devolver _poligono_circulo(a, b, rb) }
    devolver _poligonos(a, b)
}

# Polígono p contra el círculo c (normal de p hacia c)
funcion _poligono_circulo(diccionario p, diccionario c, numero r): lista {
    sea vs = p["_v"]
    sea ns = p["_n"]
    sea cx = c["_px"]
    sea cy = c["_py"]
    sea n = vs.longitud()
    sea mejor = -1000000000
    sea cual = 0
    para (i = 0; i < n; i++) {
        sea s = ns[i][0] * (cx - vs[i][0]) + ns[i][1] * (cy - vs[i][1])
        si s > r { devolver [] }
        si s > mejor {
            mejor = s
            cual = i
        }
    }
    sea v1 = vs[cual]
    sea v2 = vs[(cual + 1) % n]
    sea nx = ns[cual][0]
    sea ny = ns[cual][1]
    si mejor > 0.0001 {                                  # fuera: puede que dé en una esquina
        sea ex = v2[0] - v1[0]
        sea ey = v2[1] - v1[1]
        sea esquina = nulo
        si (cx - v1[0]) * ex + (cy - v1[1]) * ey <= 0 { esquina = v1 }
        sino si (cx - v2[0]) * -ex + (cy - v2[1]) * -ey <= 0 { esquina = v2 }
        si esquina != nulo {
            sea dx = cx - esquina[0]
            sea dy = cy - esquina[1]
            sea d = matematica.raiz(dx * dx + dy * dy)
            si d > r o d < 0.0001 { devolver [] }
            devolver [[dx / d, dy / d, d - r, esquina[0], esquina[1], "e"]]
        }
    }
    sea s = mejor - r
    devolver [[nx, ny, s, cx - nx * (r + s / 2), cy - ny * (r + s / 2), "l{cual}"]]
}

# La cara de 'a' que más separa a 'b': [separacion, cual]
funcion _mas_separados(diccionario a, diccionario b): lista {
    sea va = a["_v"]
    sea na = a["_n"]
    sea vb = b["_v"]
    sea mejor = -1000000000
    sea cual = 0
    sea n = va.longitud()
    para (i = 0; i < n; i++) {
        sea nx = na[i][0]
        sea ny = na[i][1]
        sea ox = va[i][0]
        sea oy = va[i][1]
        sea menor = 1000000000
        para cada lista q en vb {
            sea s = (q[0] - ox) * nx + (q[1] - oy) * ny
            si s < menor { menor = s }
        }
        si menor > mejor {
            mejor = menor
            cual = i
        }
        si mejor > 0 { devolver [mejor, cual] }        # ya se sabe que no se tocan
    }
    devolver [mejor, cual]
}

# Deja de un segmento lo que queda del lado positivo de t (t·p >= d)
funcion _recortar(lista p1, lista p2, numero tx, numero ty, numero d, texto corte): lista {
    sea d1 = p1[0] * tx + p1[1] * ty - d
    sea d2 = p2[0] * tx + p2[1] * ty - d
    sea r = []
    si d1 >= 0 { r.agregar(p1) }
    si d2 >= 0 { r.agregar(p2) }
    si d1 * d2 < 0 {
        sea f = d1 / (d1 - d2)
        r.agregar([p1[0] + (p2[0] - p1[0]) * f, p1[1] + (p2[1] - p1[1]) * f, corte])
    }
    devolver r
}

# Dos polígonos: la cara que menos se mete de uno de ellos (la de referencia)
# y la cara del otro que da contra ella, recortada por los lados de la primera
funcion _poligonos(diccionario a, diccionario b): lista {
    sea sa = _mas_separados(a, b)
    si sa[0] > 0 { devolver [] }
    sea sb = _mas_separados(b, a)
    si sb[0] > 0 { devolver [] }
    sea base = a
    sea contra = b
    sea cara = sa[1]
    sea vuelta = falso
    si sb[0] > sa[0] + 0.05 {
        base = b
        contra = a
        cara = sb[1]
        vuelta = verdadero
    }
    sea vr = base["_v"]
    sea nr = base["_n"][cara]
    sea nx = nr[0]
    sea ny = nr[1]
    # la cara del otro que más se le opone
    sea vi = contra["_v"]
    sea ni = contra["_n"]
    sea m = vi.longitud()
    sea otra = 0
    sea menor = 1000000000
    para (i = 0; i < m; i++) {
        sea d = ni[i][0] * nx + ni[i][1] * ny
        si d < menor {
            menor = d
            otra = i
        }
    }
    sea p1 = [vi[otra][0], vi[otra][1], "a"]
    sea p2 = [vi[(otra + 1) % m][0], vi[(otra + 1) % m][1], "b"]
    sea r1 = vr[cara]
    sea r2 = vr[(cara + 1) % vr.longitud()]
    sea tx = r2[0] - r1[0]
    sea ty = r2[1] - r1[1]
    sea tl = matematica.raiz(tx * tx + ty * ty)
    tx = tx / tl
    ty = ty / tl
    sea pts = _recortar(p1, p2, tx, ty, r1[0] * tx + r1[1] * ty, "c")
    si pts.longitud() < 2 { devolver [] }
    pts = _recortar(pts[0], pts[1], -tx, -ty, -(r2[0] * tx + r2[1] * ty), "d")
    si pts.longitud() < 2 { devolver [] }
    sea r = []
    sea signo = si vuelta { -1 } sino { 1 }
    para cada lista p en pts {
        sea s = (p[0] - r1[0]) * nx + (p[1] - r1[1]) * ny
        si s <= 0 {
            r.agregar([nx * signo, ny * signo, s, p[0] - nx * s / 2, p[1] - ny * s / 2,
                "{si vuelta { "v" } sino { "" }}{cara}.{otra}{p[2]}"])
        }
    }
    devolver r
}

# Una casilla sólida del mapa, como un cuerpo fijo (se guarda para la próxima vez)
funcion _casilla_cuerpo(diccionario mundo, numero col, numero fila, numero t): diccionario {
    sea k = "{col},{fila}"
    si mundo["_casillas"].contiene(k) { devolver mundo["_casillas"][k] }
    sea x = col * t
    sea y = fila * t
    sea c = {"id_fisica": "m" + k, "_px": x + t / 2, "_py": y + t / 2, "_a": 0, "_w": 0, "_im": 0, "_ii": 0,
        "vx": 0, "vy": 0, "_caja": [x, y, x + t, y + t],
        "_v": [[x, y], [x + t, y], [x + t, y + t], [x, y + t]], "_n": [[0, -1], [1, 0], [0, 1], [-1, 0]]}
    mundo["_casillas"][k] = c
    devolver c
}

# Un contacto es una lista (más rápida que un diccionario), con:
#  0 a, 1 b, 2 nx, 3 ny, 4 separación, 5 x, 6 y, 7 clave, 8 rozamiento, 9 rebote,
#  10 masa normal, 11 masa tangente, 12-15 brazos (rax, ray, rbx, rby),
#  16 cuánto corregir, 17 impulso normal, 18 impulso tangente

# Prepara un contacto para resolverlo: masas efectivas, cuánto corregir y el
# impulso del paso anterior (que se aplica ya: así empieza casi resuelto)
funcion _preparar_contacto(lista k, numero dt, diccionario cache): nulo {
    sea a = k[0]
    sea b = k[1]
    sea nx = k[2]
    sea ny = k[3]
    sea rax = k[5] - a["_px"]
    sea ray = k[6] - a["_py"]
    sea rbx = k[5] - b["_px"]
    sea rby = k[6] - b["_py"]
    sea ima = a["_im"]
    sea imb = b["_im"]
    sea iia = a["_ii"]
    sea iib = b["_ii"]
    sea rna = rax * ny - ray * nx
    sea rnb = rbx * ny - rby * nx
    sea rta = rax * -nx - ray * ny
    sea rtb = rbx * -nx - rby * ny
    sea bias = -k[4] - _HUECO
    bias = si bias > 0 { _CORREGIR / dt * bias } sino { 0 }
    sea dvx = b["vx"] - b["_w"] * rby - a["vx"] + a["_w"] * ray
    sea dvy = b["vy"] + b["_w"] * rbx - a["vy"] - a["_w"] * rax
    sea vn = dvx * nx + dvy * ny
    si vn < -_SIN_BOTE y -k[9] * vn > bias { bias = -k[9] * vn }
    sea pn = 0
    sea pt = 0
    si cache.contiene(k[7]) {
        sea antes = cache[k[7]]
        pn = antes[0]
        pt = antes[1]
    }
    k.agregar(1 / (ima + imb + iia * rna * rna + iib * rnb * rnb))
    k.agregar(1 / (ima + imb + iia * rta * rta + iib * rtb * rtb))
    k.agregar(rax)
    k.agregar(ray)
    k.agregar(rbx)
    k.agregar(rby)
    k.agregar(bias)
    k.agregar(pn)
    k.agregar(pt)
    si pn != 0 o pt != 0 {
        sea px = pn * nx + pt * ny
        sea py = pn * ny - pt * nx
        a["vx"] = a["vx"] - px * ima
        a["vy"] = a["vy"] - py * ima
        a["_w"] = a["_w"] - iia * (rax * py - ray * px)
        b["vx"] = b["vx"] + px * imb
        b["vy"] = b["vy"] + py * imb
        b["_w"] = b["_w"] + iib * (rbx * py - rby * px)
    }
}

funcion _resolver_contacto(lista k): nulo {
    sea a = k[0]
    sea b = k[1]
    sea nx = k[2]
    sea ny = k[3]
    sea rax = k[12]
    sea ray = k[13]
    sea rbx = k[14]
    sea rby = k[15]
    sea ima = a["_im"]
    sea imb = b["_im"]
    sea iia = a["_ii"]
    sea iib = b["_ii"]
    sea avx = a["vx"]
    sea avy = a["vy"]
    sea aw = a["_w"]
    sea bvx = b["vx"]
    sea bvy = b["vy"]
    sea bw = b["_w"]
    # que no se metan más (sin tirar nunca de ellos)
    sea antes = k[17]
    sea pn = antes + k[10] * (k[16] - ((bvx - bw * rby - avx + aw * ray) * nx + (bvy + bw * rbx - avy - aw * rax) * ny))
    si pn < 0 { pn = 0 }
    k[17] = pn
    sea d = pn - antes
    sea px = d * nx
    sea py = d * ny
    avx = avx - px * ima
    avy = avy - py * ima
    aw = aw - iia * (rax * py - ray * px)
    bvx = bvx + px * imb
    bvy = bvy + py * imb
    bw = bw + iib * (rbx * py - rby * px)
    # el rozamiento, a lo largo de la superficie (como mucho, mu por lo que aprieta)
    sea tope = k[8] * pn
    antes = k[18]
    sea pt = antes - k[11] * ((bvx - bw * rby - avx + aw * ray) * ny - (bvy + bw * rbx - avy - aw * rax) * nx)
    si pt > tope { pt = tope }
    si pt < -tope { pt = -tope }
    k[18] = pt
    d = pt - antes
    px = d * ny
    py = -d * nx
    a["vx"] = avx - px * ima
    a["vy"] = avy - py * ima
    a["_w"] = aw - iia * (rax * py - ray * px)
    b["vx"] = bvx + px * imb
    b["vy"] = bvy + py * imb
    b["_w"] = bw + iib * (rbx * py - rby * px)
}

funcion _apuntar_contactos(lista lista_k, lista cs, diccionario a, diccionario b, numero mu, numero e): nulo {
    para cada lista c en cs {
        lista_k.agregar([a, b, c[0], c[1], c[2], c[3], c[4], "{a["id_fisica"]}:{b["id_fisica"]}:{c[5]}", mu, e])
        si c[1] > 0.5 { a["en_suelo"] = verdadero }
        si c[1] < -0.5 { b["en_suelo"] = verdadero }
    }
}

funcion _paso_rigido(diccionario mundo, numero dt): nulo {
    sea g = mundo["gravedad"]
    sea cuerpos = mundo["cuerpos"]
    sea mapa = mundo["mapa"]
    # la gravedad, y dónde está cada uno
    para cada diccionario c en cuerpos {
        si c.contiene("_forma") y no c["fijo"] {
            c["vx"] = c["vx"] + g[0] * c["gravedad"] * dt
            c["vy"] = c["vy"] + g[1] * c["gravedad"] * dt
        }
        _geometria(c)
    }
    # los contactos: entre cuerpos (si al menos uno gira) y con el mapa
    sea ks = []
    sea sin_choque = mundo["_sin_choque"]
    sea n = cuerpos.longitud()
    para (i = 0; i < n; i++) {
        sea a = cuerpos[i]
        sea ra = a.contiene("_forma")
        sea ca = a["_caja"]
        para (j = i + 1; j < n; j++) {
            sea b = cuerpos[j]
            si no ra y no b.contiene("_forma") { continuar }
            sea cb = b["_caja"]
            si cb[0] > ca[2] o cb[2] < ca[0] o cb[1] > ca[3] o cb[3] < ca[1] { continuar }
            si a["fijo"] y b["fijo"] { continuar }
            si sin_choque.contiene("{a["id_fisica"]}:{b["id_fisica"]}") { continuar }
            sea cs = _contactos(a, b)
            si cs.longitud() == 0 { continuar }
            _apunta_toque(mundo, a, b)
            _apunta_toque(mundo, b, a)
            si a["sensor"] o b["sensor"] { continuar }
            _apuntar_contactos(ks, cs, a, b, matematica.raiz(a["friccion"] * b["friccion"]),
                matematica.maximo(a["rebote"], b["rebote"]))
        }
        si ra y mapa != nulo y no a["fijo"] y no a["sensor"] {
            sea t = mapa["tamaño"]
            para (fila = matematica.piso(ca[1] / t); fila <= matematica.piso(ca[3] / t); fila++) {
                para (col = matematica.piso(ca[0] / t); col <= matematica.piso(ca[2] / t); col++) {
                    si no juego.mapa.solido(mapa, col, fila) { continuar }
                    sea casilla = _casilla_cuerpo(mundo, col, fila, t)
                    sea cs = _contactos(a, casilla)
                    # sin tropezar con la junta entre dos casillas: la normal no
                    # puede ir hacia otra casilla sólida
                    sea buenos = []
                    para cada lista c en cs {
                        sea vecina = si matematica.abs(c[0]) > matematica.abs(c[1]) {
                            juego.mapa.solido(mapa, col - (si c[0] > 0 { 1 } sino { -1 }), fila)
                        } sino {
                            juego.mapa.solido(mapa, col, fila - (si c[1] > 0 { 1 } sino { -1 }))
                        }
                        si no vecina { buenos.agregar(c) }
                    }
                    _apuntar_contactos(ks, buenos, a, casilla, a["friccion"], a["rebote"])
                }
            }
        }
    }
    # las uniones y los contactos, ajustados varias veces
    sea cache = mundo["_cache"]
    para cada diccionario u en mundo["uniones"] { _preparar_union(u, dt) }
    para cada lista k en ks { _preparar_contacto(k, dt, cache) }
    sea uniones = mundo["uniones"]
    para (it = 0; it < mundo["iteraciones"]; it++) {
        para cada diccionario u en uniones { _resolver_union(u) }
        para cada lista k en ks { _resolver_contacto(k) }
    }
    sea nuevo = {}
    para cada lista k en ks { nuevo[k[7]] = [k[17], k[18]] }
    mundo["_cache"] = nuevo
    # y se mueven
    para cada diccionario c en cuerpos {
        si c.contiene("_forma") {
            c["_px"] = c["_px"] + c["vx"] * dt
            c["_py"] = c["_py"] + c["vy"] * dt
            c["_a"] = c["_a"] + c["_w"] * dt
        }
    }
}

# ── Uniones ──
# bisagra(mundo, a, b, punto): a y b quedan clavados por ese punto [x, y] del
# mundo y giran alrededor de él (una puerta, un péndulo, una rueda, los
# eslabones de una cadena). Con b nulo, a queda clavado al fondo. Lo unido
# por una bisagra no choca entre sí.
# cuerda(mundo, a, b[, opciones]): a y b no se pueden alejar más que el largo
# de la cuerda (sí acercarse). b es un cuerpo o un punto fijo [x, y].
# Opciones: "largo" (lo que estén separados ahora), "en_a" y "en_b" (dónde se
# ata, [x, y] desde el centro de cada uno sin girar; en el centro si no se
# dice) y "rigida" (una barra: ni se alejan ni se acercan).
# Devuelven la unión, que se quita con quitar_union(mundo, union). Con
# puntos_union(union) se sabe por dónde dibujarla.

sea _uniones_creadas = 0

funcion _sitio_cuerpo(diccionario c): lista {
    si c.contiene("_forma") { devolver [c["x"] + c["_forma"]["cm"][0], c["y"] + c["_forma"]["cm"][1], matematica.radianes(c["angulo"])] }
    devolver [c["x"] + c["ancho"] / 2, c["y"] + c["alto"] / 2, 0]
}

# De un punto del mundo a cómo se ve desde el cuerpo (sin girar)
funcion _a_local(diccionario c, lista p): lista {
    sea s = _sitio_cuerpo(c)
    sea dx = p[0] - s[0]
    sea dy = p[1] - s[1]
    sea co = matematica.coseno(s[2])
    sea se = matematica.seno(s[2])
    devolver [dx * co + dy * se, -dx * se + dy * co]
}

funcion _es_cuerpo_de(diccionario mundo, cualquiera c, texto fn): nulo {
    si no (c es diccionario) o no c.contiene("id_fisica") { lanzar ErrorTipo("{fn}() espera cuerpos de juego.cuerpo()") }
    sea esta = falso
    para cada diccionario cuerpo_o en mundo["cuerpos"] { si cuerpo_o["id_fisica"] == c["id_fisica"] { esta = verdadero } }
    si no esta { lanzar ErrorArgumento("{fn}(): ese cuerpo no está en este mundo") }
}

funcion bisagra(cualquiera mundo, cualquiera a, cualquiera b, cualquiera punto): diccionario {
    _es_mundo(mundo, "bisagra")
    _es_cuerpo_de(mundo, a, "bisagra")
    sea p = _punto(punto, nulo, "bisagra")
    _uniones_creadas = _uniones_creadas + 1
    sea u = {"union": "bisagra", "id_union": _uniones_creadas, "a": a, "b": b, "en_a": _a_local(a, p), "p": [0, 0]}
    si b == nulo {
        u["en_b"] = p
    } sino {
        _es_cuerpo_de(mundo, b, "bisagra")
        si b["id_fisica"] == a["id_fisica"] { lanzar ErrorArgumento("bisagra(): une dos cuerpos distintos (o uno y nulo, para clavarlo al fondo)") }
        u["en_b"] = _a_local(b, p)
        mundo["_sin_choque"]["{a["id_fisica"]}:{b["id_fisica"]}"] = verdadero
        mundo["_sin_choque"]["{b["id_fisica"]}:{a["id_fisica"]}"] = verdadero
    }
    mundo["uniones"].agregar(u)
    devolver u
}

funcion cuerda(cualquiera mundo, cualquiera a, cualquiera b, cualquiera opciones = nulo): diccionario {
    _es_mundo(mundo, "cuerda")
    _es_cuerpo_de(mundo, a, "cuerda")
    sea op = _ui_opciones(opciones, ["largo", "en_a", "en_b", "rigida"], "cuerda")
    sea en_a = _punto(_de(op, "en_a", [0, 0]), nulo, "cuerda")
    _uniones_creadas = _uniones_creadas + 1
    sea u = {"union": "cuerda", "id_union": _uniones_creadas, "a": a, "b": b, "en_a": en_a, "rigida": _de(op, "rigida", falso), "p": 0}
    si b es lista {
        u["en_b"] = _punto(b, nulo, "cuerda")
        u["b"] = nulo
    } sino {
        _es_cuerpo_de(mundo, b, "cuerda")
        si b["id_fisica"] == a["id_fisica"] { lanzar ErrorArgumento("cuerda(): ata dos cuerpos distintos (o uno y un punto [x, y])") }
        u["en_b"] = _punto(_de(op, "en_b", [0, 0]), nulo, "cuerda")
    }
    si no (u["rigida"] es logico) { lanzar ErrorTipo("cuerda(): \"rigida\" es verdadero o falso") }
    sea ps = puntos_union(u)
    sea dx = ps[1][0] - ps[0][0]
    sea dy = ps[1][1] - ps[0][1]
    u["largo"] = _de(op, "largo", matematica.raiz(dx * dx + dy * dy))
    si no (u["largo"] es numero) o u["largo"] < 0 { lanzar ErrorArgumento("cuerda(): \"largo\" es un número de píxeles (0 o más)") }
    mundo["uniones"].agregar(u)
    devolver u
}

funcion quitar_union(cualquiera mundo, cualquiera u): nulo {
    _es_mundo(mundo, "quitar_union")
    si no (u es diccionario) o no u.contiene("id_union") { lanzar ErrorTipo("quitar_union() espera una unión de cuerda() o bisagra()") }
    sea quedan = []
    para cada diccionario otra en mundo["uniones"] { si otra["id_union"] != u["id_union"] { quedan.agregar(otra) } }
    mundo["uniones"] = quedan
    si u["union"] == "bisagra" y u["b"] != nulo {
        sea ka = "{u["a"]["id_fisica"]}:{u["b"]["id_fisica"]}"
        sea kb = "{u["b"]["id_fisica"]}:{u["a"]["id_fisica"]}"
        sea sigue = falso                  # si no queda otra bisagra entre los dos, vuelven a chocar
        para cada diccionario otra en quedan {
            si otra["union"] == "bisagra" y otra["b"] != nulo {
                sea k = "{otra["a"]["id_fisica"]}:{otra["b"]["id_fisica"]}"
                si k == ka o k == kb { sigue = verdadero }
            }
        }
        si no sigue {
            si mundo["_sin_choque"].contiene(ka) { mundo["_sin_choque"].eliminar(ka) }
            si mundo["_sin_choque"].contiene(kb) { mundo["_sin_choque"].eliminar(kb) }
        }
    }
}

# puntos_union(u): [[x, y] en a, [x, y] en b]: por dónde va la cuerda o dónde está la bisagra
funcion puntos_union(cualquiera u): lista {
    si no (u es diccionario) o no u.contiene("union") { lanzar ErrorTipo("puntos_union() espera una unión de cuerda() o bisagra()") }
    sea r = []
    para cada texto lado en ["a", "b"] {
        sea c = u[lado]
        sea en = u["en_" + lado]
        si c == nulo {
            r.agregar([en[0], en[1]])
        } sino {
            sea s = _sitio_cuerpo(c)
            sea co = matematica.coseno(s[2])
            sea se = matematica.seno(s[2])
            r.agregar([s[0] + en[0] * co - en[1] * se, s[1] + en[0] * se + en[1] * co])
        }
    }
    devolver r
}

# El brazo (del centro al punto de la unión) ya girado; [0, 0] si es el fondo
funcion _brazo(cualquiera c, lista en): lista {
    si c == nulo { devolver [0, 0] }
    sea co = matematica.coseno(c["_a"])
    sea se = matematica.seno(c["_a"])
    devolver [en[0] * co - en[1] * se, en[0] * se + en[1] * co]
}

fijo _FONDO = {"vx": 0, "vy": 0, "_w": 0, "_im": 0, "_ii": 0}

funcion _preparar_union(diccionario u, numero dt): nulo {
    sea a = u["a"]
    sea b = si u["b"] == nulo { _FONDO } sino { u["b"] }
    _geometria(a)
    si u["b"] != nulo { _geometria(b) }
    sea r1 = _brazo(a, u["en_a"])
    sea r2 = _brazo(u["b"], u["en_b"])
    sea p2 = si u["b"] == nulo { u["en_b"] } sino { [b["_px"] + r2[0], b["_py"] + r2[1]] }
    sea dx = p2[0] - (a["_px"] + r1[0])
    sea dy = p2[1] - (a["_py"] + r1[1])
    u["r1"] = r1
    u["r2"] = r2
    u["activa"] = verdadero
    sea im = a["_im"] + b["_im"]
    sea ia = a["_ii"]
    sea ib = b["_ii"]
    si u["union"] == "bisagra" {
        sea k11 = im + ia * r1[1] * r1[1] + ib * r2[1] * r2[1]
        sea k12 = -ia * r1[0] * r1[1] - ib * r2[0] * r2[1]
        sea k22 = im + ia * r1[0] * r1[0] + ib * r2[0] * r2[0]
        sea det = k11 * k22 - k12 * k12
        si det == 0 {
            u["activa"] = falso
            devolver nulo
        }
        u["m"] = [k22 / det, -k12 / det, k11 / det]          # la inversa (simétrica)
        u["bias"] = [-_CORREGIR_UNION / dt * dx, -_CORREGIR_UNION / dt * dy]
        _empujar_union(a, b, r1, r2, u["p"][0], u["p"][1])
        devolver nulo
    }
    # cuerda: solo tira (una rígida, también empuja). Floja, deja acercarse lo
    # que le falta para tensarse en este paso, ni un poco más
    sea largo = matematica.raiz(dx * dx + dy * dy)
    sea estira = largo - u["largo"]
    si largo < 0.0001 o im == 0 {
        u["activa"] = falso
        u["p"] = 0
        devolver nulo
    }
    sea nx = dx / largo
    sea ny = dy / largo
    u["n"] = [nx, ny]
    sea rn1 = r1[0] * ny - r1[1] * nx
    sea rn2 = r2[0] * ny - r2[1] * nx
    u["m"] = 1 / (im + ia * rn1 * rn1 + ib * rn2 * rn2)
    u["bias"] = si estira < 0 y no u["rigida"] { -estira / dt } sino { -_CORREGIR_UNION / dt * estira }
    _empujar_union(a, b, r1, r2, u["p"] * nx, u["p"] * ny)
}

# Un impulso (px, py) a b en su punto, y el contrario a a
funcion _empujar_union(diccionario a, diccionario b, lista r1, lista r2, numero px, numero py): nulo {
    si px == 0 y py == 0 { devolver nulo }
    a["vx"] = a["vx"] - px * a["_im"]
    a["vy"] = a["vy"] - py * a["_im"]
    a["_w"] = a["_w"] - a["_ii"] * (r1[0] * py - r1[1] * px)
    si b["_im"] != 0 o b["_ii"] != 0 {
        b["vx"] = b["vx"] + px * b["_im"]
        b["vy"] = b["vy"] + py * b["_im"]
        b["_w"] = b["_w"] + b["_ii"] * (r2[0] * py - r2[1] * px)
    }
}

funcion _resolver_union(diccionario u): nulo {
    si no u["activa"] { devolver nulo }
    sea a = u["a"]
    sea b = si u["b"] == nulo { _FONDO } sino { u["b"] }
    sea r1 = u["r1"]
    sea r2 = u["r2"]
    sea dvx = b["vx"] - b["_w"] * r2[1] - a["vx"] + a["_w"] * r1[1]
    sea dvy = b["vy"] + b["_w"] * r2[0] - a["vy"] - a["_w"] * r1[0]
    si u["union"] == "bisagra" {
        sea m = u["m"]
        sea bx = u["bias"][0] - dvx
        sea by = u["bias"][1] - dvy
        sea px = m[0] * bx + m[1] * by
        sea py = m[1] * bx + m[2] * by
        u["p"] = [u["p"][0] + px, u["p"][1] + py]
        _empujar_union(a, b, r1, r2, px, py)
        devolver nulo
    }
    sea n = u["n"]
    sea l = u["m"] * (u["bias"] - (dvx * n[0] + dvy * n[1]))
    sea antes = u["p"]
    sea total = antes + l
    si no u["rigida"] { total = matematica.minimo(total, 0) }      # una cuerda solo tira
    u["p"] = total
    l = total - antes
    _empujar_union(a, b, r1, r2, l * n[0], l * n[1])
}

# ── Controles a gusto del jugador ──
# menu_controles() enseña cada acción con sus teclas y sus botones y deja
# cambiarlos: se elige una y se pulsa lo nuevo. Lo cambiado se guarda (con
# guardar(), como "lince_controles") y se aplica solo la próxima vez que el
# juego defina esa acción. Una tecla nueva sustituye a las teclas que tenía
# la acción; un botón de mando, a sus botones; una dirección de la palanca, a
# sus direcciones. Si otra acción ya la usaba, se intercambian.

sea _ctrl_guardados = nulo    # {acción: [entradas]} que eligió el jugador
sea _ctrl_originales = {}     # {acción: [entradas]} como las definió el juego
sea _ctrl = nulo              # el menú: qué fila está elegida y si espera una entrada

# Lo llama definir_accion() (en C): las entradas que eligió el jugador, o nulo
funcion _controles_de(texto nombre, lista entradas): cualquiera {
    si nombre.contiene("@") { devolver nulo }          # la copia de un jugador: tal cual
    si no _ctrl_originales.contiene(nombre) o _ctrl_guardados == nulo o no _ctrl_guardados.contiene(nombre) {
        _ctrl_originales[nombre] = entradas
    }
    si _ctrl_guardados == nulo {
        _ctrl_guardados = juego.cargar_partida("lince_controles", {})
        si no (_ctrl_guardados es diccionario) { _ctrl_guardados = {} }
    }
    sea finales = entradas
    si _ctrl_guardados.contiene(nombre) { finales = _ctrl_guardados[nombre] }
    para cada diccionario j en _jugadores { _definir_suya(nombre, finales, j) }   # y la de cada jugador
    si _ctrl_guardados.contiene(nombre) { devolver _ctrl_guardados[nombre] }
    devolver nulo
}

# "tecla", "raton", "boton", "eje" u "otra" (pantalla, inclinación)
funcion _clase_entrada(texto e): texto {
    si e.posicion("raton:") == 0 { devolver "raton" }
    si e.posicion("pantalla:") == 0 o e.posicion("inclinacion:") == 0 { devolver "otra" }
    si e.posicion("mando") == 0 {
        sea ultima = e[e.longitud() - 1]
        devolver si ultima == "+" o ultima == "-" { "eje" } sino { "boton" }
    }
    devolver "tecla"
}

funcion _cambiar_control(texto nombre, texto nueva): nulo {
    sea actuales = juego.acciones()
    sea tipo_nueva = _clase_entrada(nueva)
    sea viejas = []
    sea quedan = [nueva]
    para cada texto e en actuales[nombre] {
        si _clase_entrada(e) == tipo_nueva { viejas.agregar(e) } sino si e != nueva { quedan.agregar(e) }
    }
    # si otra acción la usaba, se queda con lo que tenía esta
    para cada texto vecina en actuales {
        si vecina == nombre o no actuales[vecina].contiene(nueva) { continuar }
        sea cambiadas = []
        para cada texto e en actuales[vecina] {
            si e == nueva {
                si viejas.longitud() > 0 { cambiadas.agregar(viejas[0]) }
            } sino {
                cambiadas.agregar(e)
            }
        }
        _ctrl_guardados[vecina] = cambiadas
        juego.definir_accion(vecina, cambiadas)
    }
    _ctrl_guardados[nombre] = quedan
    juego.definir_accion(nombre, quedan)
    juego.guardar_partida("lince_controles", _ctrl_guardados)
}

# restablecer_controles(): vuelven los controles del juego y se olvidan los del jugador
funcion restablecer_controles(): nulo {
    _ctrl_guardados = {}
    juego.olvidar_partida("lince_controles")
    para cada texto nombre en _ctrl_originales { juego.definir_accion(nombre, _ctrl_originales[nombre]) }
}

# Cómo se enseña una entrada: "ESPACIO", "A", "IZQ X-"
funcion _ver_entrada(texto e): texto {
    sea t = e
    si t.posicion("mando") == 0 { t = t.dividir(":")[1] }
    sino si t.posicion("raton:") == 0 { t = "ratón " + t.dividir(":")[1] }
    devolver t.reemplazar("_", " ").mayusculas()
}

funcion _ver_entradas(lista entradas, lista clases): texto {
    sea partes = []
    para cada texto e en entradas {
        si clases.contiene(_clase_entrada(e)) { partes.agregar(_ver_entrada(e)) }
    }
    devolver si partes.longitud() == 0 { "-" } sino { texto.unir(partes, " / ") }
}

fijo _CONTROLES_OPCIONES = ["acciones", "nombres", "escala", "fuente", "color", "color_elegido"]

# menu_controles([opciones]): la pantalla de los controles. Se llama en cada
# fotograma mientras se vea; devuelve "volver" cuando el jugador sale (con
# Volver, escape o B). Opciones: acciones (cuáles y en qué orden; todas por
# defecto), nombres ({acción: cómo se enseña}), escala (2), fuente, color y
# color_elegido.
funcion menu_controles(cualquiera opciones = nulo): cualquiera {
    sea aj = _ui_opciones(opciones, _CONTROLES_OPCIONES, "menu_controles")
    sea todas = juego.acciones()
    sea nombres = []
    si aj.contiene("acciones") {
        para cada texto a en aj["acciones"] {
            si no todas.contiene(a) { lanzar ErrorArgumento("menu_controles(): no hay ninguna acción '{a}'") }
            nombres.agregar(a)
        }
    } sino {
        para cada texto a en todas { nombres.agregar(a) }
    }
    sea filas = nombres.longitud() + 2               # y Restablecer y Volver
    sea ahora = juego.tiempo_real()
    si _ctrl == nulo o ahora - _ctrl["visto"] > 0.25 { _ctrl = {"elegida": 0, "esperando": nulo, "visto": ahora} }
    _ctrl["visto"] = ahora
    # las columnas, según lo que ocupan; si no cabe, la letra más pequeña
    sea textos = [[traducir("ACCIÓN")], [traducir("TECLADO")], [traducir("MANDO")]]
    para cada texto n en nombres {
        textos[0].agregar(traducir(si aj.contiene("nombres") y aj["nombres"].contiene(n) { aj["nombres"][n] } sino { n }))
        textos[1].agregar(_ver_entradas(todas[n], ["tecla", "raton"]))
        textos[2].agregar(_ver_entradas(todas[n], ["boton", "eje"]))
    }
    sea escala = _de(aj, "escala", 2)
    sea letra = _ui_letra(aj, escala)
    sea col = []
    mientras verdadero {
        letra = _ui_letra(aj, escala)
        sea hueco = juego.medir_texto("Ay", letra)[1] * 2
        col = [juego.ancho() * 0.06]
        para (k = 0; k < 2; k++) {
            sea mayor = 0
            para cada texto t en textos[k] { mayor = matematica.maximo(mayor, juego.ancho_texto(t, letra)) }
            col.agregar(col[k] + mayor + hueco)
        }
        sea ultimo = 0
        para cada texto t en textos[2] { ultimo = matematica.maximo(ultimo, juego.ancho_texto(t, letra)) }
        si col[2] + ultimo <= juego.ancho() * 0.96 o escala <= 1 o aj.contiene("fuente") { romper }
        escala = escala - 1
    }
    sea alto = juego.medir_texto("Ay", letra)[1]
    sea paso = alto * 1.7
    sea arriba = matematica.maximo(alto * 3, juego.alto() / 2 - paso * (filas + 1) / 2)
    sea resultado = nulo
    si _ctrl["esperando"] != nulo {
        sea e = juego.entrada_pulsada()
        si e == "escape" { _ctrl["esperando"] = nulo }
        sino si e != nulo {
            _cambiar_control(_ctrl["esperando"], e)
            _ctrl["esperando"] = nulo
        }
    } sino {
        _ctrl["elegida"] = (_ctrl["elegida"] + _ui_paso + filas) % filas
        sea r = juego.raton()
        sea mov = juego.movimiento_raton()
        sea tocada = falso
        sea fila_raton = matematica.piso((r[1] - arriba - paso + paso * 0.25) / paso)
        si fila_raton >= 0 y fila_raton < filas {
            si mov[0] != 0 o mov[1] != 0 o juego.clic(1) { _ctrl["elegida"] = fila_raton }
            si juego.clic(1) { tocada = verdadero }
        }
        si tocada o _ui_aceptar() {
            sea i = _ctrl["elegida"]
            si i < nombres.longitud() { _ctrl["esperando"] = nombres[i] }
            sino si i == nombres.longitud() { restablecer_controles() }
            sino { resultado = "volver" }
        } sino si _ui_atras() {
            resultado = "volver"
        }
    }
    # dibujar
    sea camara = juego.camara_actual()
    juego.camara()
    sea gris = [150, 150, 170]
    sea normal = _de(aj, "color", [210, 210, 220])
    sea amarillo = _de(aj, "color_elegido", [255, 220, 80])
    funcion escribir_en(texto t, numero x, numero fila_y, lista color): nulo {
        sea op = {"color": color}
        para cada texto c en letra { op[c] = letra[c] }
        juego.texto(t, x, fila_y, op)
    }
    escribir_en(textos[0][0], col[0], arriba, gris)
    escribir_en(textos[1][0], col[1], arriba, gris)
    escribir_en(textos[2][0], col[2], arriba, gris)
    para (i = 0; i < filas; i++) {
        sea fila_y = arriba + (i + 1) * paso
        sea elegida = i == _ctrl["elegida"]
        si elegida { juego.rectangulo(col[0] - alto * 0.5, fila_y - alto * 0.35, juego.ancho() - col[0] * 2 + alto, alto * 1.7, [255, 255, 255, 40]) }
        sea color = si elegida { amarillo } sino { normal }
        si i < nombres.longitud() {
            sea n = nombres[i]
            sea visible = textos[0][i + 1]
            escribir_en(visible, col[0], fila_y, color)
            si _ctrl["esperando"] == n {
                escribir_en(traducir("PULSA UNA TECLA O UN BOTÓN"), col[1], fila_y, amarillo)
            } sino {
                escribir_en(textos[1][i + 1], col[1], fila_y, color)
                escribir_en(textos[2][i + 1], col[2], fila_y, color)
            }
        } sino si i == nombres.longitud() {
            escribir_en(traducir("Restablecer"), col[0], fila_y, color)
        } sino {
            escribir_en(traducir("Volver"), col[0], fila_y, color)
        }
    }
    sea ayuda = traducir(si _ctrl["esperando"] != nulo { "ESC: NO CAMBIAR" } sino { "ENTRAR O A: CAMBIAR    ESC O B: VOLVER" })
    escribir_en(ayuda, col[0], arriba + (filas + 1.5) * paso, gris)
    juego.camara(camara)
    si resultado != nulo { _ctrl = nulo }
    devolver resultado
}

# ── Varios jugadores en el mismo equipo ──
# Cada mando es un jugador (y el teclado, otro): se une pulsando un botón, con
# unirse() en cada fotograma o con la pantalla de menu_jugadores(). Desde ese
# momento, juego.accion("saltar", 2) es la acción del jugador 2, que solo mira
# su mando: las entradas "mando:..." de la acción pasan a ser de su mando, y
# las del teclado y el ratón solo cuentan para el jugador del teclado. Vale
# igual en accion, accion_pulsada, accion_soltada, direccion (el tercer
# argumento), combo, pulsaciones, mantenida y estado_accion. Las acciones se
# definen una vez, como siempre, con "mando:a"; Lince hace la copia de cada
# jugador ("saltar@2") y la rehace si se vuelven a definir.

fijo _JUGADORES_OPCIONES = ["maximo", "teclado", "botones", "teclas"]
sea _jugadores = []     # [{"numero", "dispositivo": "teclado" o "mando", "mando": 1 a 4 o nulo}]

# Las entradas de una acción que son de ese jugador
funcion _entradas_suyas(lista entradas, diccionario j): lista {
    sea r = []
    para cada texto e en entradas {
        sea de_mando = e.posicion("mando") == 0
        si j["dispositivo"] == "teclado" {
            si no de_mando { r.agregar(e) }
        } sino si e.posicion("mando:") == 0 {
            r.agregar("mando{j["mando"]}:" + e.extraer(6, e.longitud()))
        } sino si e.posicion("mando{j["mando"]}:") == 0 {
            r.agregar(e)
        }
    }
    devolver r
}

funcion _definir_suya(texto nombre, lista entradas, diccionario j): nulo {
    juego.definir_accion("{nombre}@{j["numero"]}", _entradas_suyas(entradas, j))
}

# Rehace las copias de todas las acciones para todos los jugadores; las de un
# número que ya no tiene jugador se quedan sin entradas (nunca se pulsan)
funcion _rehacer_jugadores(numero antes): nulo {
    sea todas = juego.acciones()
    para cada texto nombre en todas {
        para cada diccionario j en _jugadores { _definir_suya(nombre, todas[nombre], j) }
        para (k = _jugadores.longitud() + 1; k <= antes; k++) { juego.definir_accion("{nombre}@{k}", []) }
    }
}

funcion _usado(texto dispositivo, cualquiera mando): logico {
    para cada diccionario j en _jugadores {
        si j["dispositivo"] == dispositivo y j["mando"] == mando { devolver verdadero }
    }
    devolver falso
}

funcion _nuevo_jugador(texto dispositivo, cualquiera mando): numero {
    sea j = {"numero": _jugadores.longitud() + 1, "dispositivo": dispositivo, "mando": mando}
    _jugadores.agregar(j)
    sea todas = juego.acciones()
    para cada texto nombre en todas { _definir_suya(nombre, todas[nombre], j) }
    devolver j["numero"]
}

# unirse([opciones]): en cada fotograma, mientras se espera a los jugadores.
# Un mando conectado que pulse A o INICIO (o el teclado, con ENTRAR o
# ESPACIO) que aún no sea de nadie se une como el jugador siguiente. Devuelve
# el número del que se acaba de unir, o nulo. Opciones: "maximo" (4),
# "teclado" (verdadero: el teclado también puede ser un jugador), "botones"
# (["a", "inicio"]) y "teclas" (["entrar", "espacio"]).
funcion unirse(cualquiera opciones = nulo): cualquiera {
    sea op = _ui_opciones(opciones, _JUGADORES_OPCIONES, "unirse")
    sea maximo = _de(op, "maximo", 4)
    si no (maximo es numero) o maximo < 1 o maximo > 8 { lanzar ErrorArgumento("unirse(): \"maximo\" va de 1 a 8 jugadores") }
    si _jugadores.longitud() >= maximo { devolver nulo }
    para (m = 1; m <= 4; m++) {
        si _usado("mando", m) o no juego.mando_conectado(m) { continuar }
        para cada texto b en _de(op, "botones", ["a", "inicio"]) {
            si juego.boton_pulsado(b, m) { devolver _nuevo_jugador("mando", m) }
        }
    }
    si _de(op, "teclado", verdadero) y no _usado("teclado", nulo) {
        para cada texto t en _de(op, "teclas", ["entrar", "espacio"]) {
            si juego.tecla_pulsada(t) { devolver _nuevo_jugador("teclado", nulo) }
        }
    }
    devolver nulo
}

# jugadores(): los que se han unido, en orden: [{"numero", "dispositivo"
# ("teclado" o "mando"), "mando" (1 a 4, o nulo), "conectado"}]. Si se
# desconecta su mando, "conectado" es falso (para pausar) y, al volver a
# conectarlo, sigue siendo el mismo jugador.
funcion jugadores(): lista {
    sea r = []
    para cada diccionario j en _jugadores {
        r.agregar({"numero": j["numero"], "dispositivo": j["dispositivo"], "mando": j["mando"],
            "conectado": j["dispositivo"] == "teclado" o juego.mando_conectado(j["mando"])})
    }
    devolver r
}

# quitar_jugador(n): se va; los de detrás pasan a tener un número menos
funcion quitar_jugador(numero n): nulo {
    si n < 1 o n > _jugadores.longitud() o matematica.piso(n) != n { lanzar ErrorArgumento("quitar_jugador(): no hay jugador {n}") }
    sea antes = _jugadores.longitud()
    sea quedan = []
    para cada diccionario j en _jugadores {
        si j["numero"] != n {
            j["numero"] = quedan.longitud() + 1
            quedan.agregar(j)
        }
    }
    _jugadores = quedan
    _rehacer_jugadores(antes)
}

# olvidar_jugadores(): se van todos (para volver a la pantalla de unirse)
funcion olvidar_jugadores(): nulo {
    sea antes = _jugadores.longitud()
    _jugadores = []
    _rehacer_jugadores(antes)
}

# pantalla_partida(n): las zonas de la pantalla para n jugadores (de 1 a 4),
# para la "zona" de camara(): uno, toda; dos, una mitad cada uno (lado a lado,
# o una encima de otra con "lado_a_lado": falso); tres y cuatro, en cuartos
funcion pantalla_partida(numero n, cualquiera opciones = nulo): lista {
    sea op = _ui_opciones(opciones, ["lado_a_lado"], "pantalla_partida")
    si n < 1 o n > 4 o matematica.piso(n) != n { lanzar ErrorArgumento("pantalla_partida(): de 1 a 4 jugadores") }
    sea w = juego.ancho()
    sea h = juego.alto()
    si n == 1 { devolver [[0, 0, w, h]] }
    si n == 2 {
        si _de(op, "lado_a_lado", verdadero) { devolver [[0, 0, w / 2, h], [w / 2, 0, w - w / 2, h]] }
        devolver [[0, 0, w, h / 2], [0, h / 2, w, h - h / 2]]
    }
    sea zonas = [[0, 0, w / 2, h / 2], [w / 2, 0, w - w / 2, h / 2], [0, h / 2, w / 2, h - h / 2], [w / 2, h / 2, w - w / 2, h - h / 2]]
    sea r = []
    para (k = 0; k < n; k++) { r.agregar(zonas[k]) }
    devolver r
}

# menu_jugadores([opciones]): la pantalla de «pulsa un botón para unirte», en
# cada fotograma (como menu_controles). Enseña un hueco por jugador. El que
# se ha unido se va con B (o ESCAPE, el del teclado), y cualquiera de ellos
# empieza con INICIO (o ENTRAR) cuando son al menos "minimo". Devuelve nulo
# mientras se espera, la lista de jugadores() al empezar, o "volver" si se
# pulsa B o ESCAPE sin nadie unido. Opciones: las de unirse(), "minimo" (1),
# "titulo", "escala" (2), "fuente", "color" y "color_elegido".
sea _mj_listo = 0       # el fotograma en que se unió alguien (para que esa pulsación no empiece ya)

funcion menu_jugadores(cualquiera opciones = nulo): cualquiera {
    sea op = _ui_opciones(opciones, ["maximo", "teclado", "botones", "teclas", "minimo", "titulo", "escala", "fuente", "color",
        "color_elegido"], "menu_jugadores")
    sea para_unirse = {}
    para cada texto c en _JUGADORES_OPCIONES { si op.contiene(c) { para_unirse[c] = op[c] } }
    sea maximo = _de(op, "maximo", 4)
    sea minimo = _de(op, "minimo", 1)
    si no (minimo es numero) o minimo < 1 o minimo > maximo { lanzar ErrorArgumento("menu_jugadores(): \"minimo\" va de 1 a \"maximo\"") }
    sea resultado = nulo
    sea nuevo = unirse(para_unirse)
    si nuevo == nulo {
        # irse (B o ESCAPE) o empezar (INICIO o ENTRAR), cada uno con lo suyo
        para cada diccionario j en jugadores() {
            sea m = j["mando"]
            sea irse = si m == nulo { juego.tecla_pulsada("escape") } sino { juego.boton_pulsado("b", m) }
            sea empezar = si m == nulo { juego.tecla_pulsada("entrar") } sino { juego.boton_pulsado("inicio", m) }
            si irse {
                quitar_jugador(j["numero"])
                romper
            }
            si empezar y _jugadores.longitud() >= minimo { resultado = jugadores() }
        }
        si resultado == nulo y _jugadores.longitud() == 0 y (juego.tecla_pulsada("escape") o juego.boton_pulsado("b")) {
            resultado = "volver"
        }
    }
    # dibujar
    sea camara = juego.camara_actual()
    juego.camara()
    # los textos, y la letra más pequeña si no caben
    sea hay_teclado = _de(op, "teclado", verdadero)
    sea titulo = traducir(_de(op, "titulo", "JUGADORES"))
    sea filas = []
    para (k = 1; k <= maximo; k++) {
        si k <= _jugadores.longitud() {
            sea j = _jugadores[k - 1]
            sea de = si j["dispositivo"] == "teclado" { traducir("TECLADO") } sino { traducir("MANDO {}", [j["mando"]]) }
            filas.agregar(traducir("JUGADOR {}: {}", [k, de]))
        } sino {
            filas.agregar(traducir(si hay_teclado { "PULSA A O ENTRAR PARA UNIRTE" } sino { "PULSA A PARA UNIRTE" }))
        }
    }
    sea pie = [traducir(si _jugadores.longitud() > 0 { "B O ESCAPE: SALIR" } sino { "B O ESCAPE: VOLVER" })]
    si _jugadores.longitud() >= minimo { pie = [traducir("INICIO O ENTRAR: EMPEZAR")] + pie }
    sea escala = _de(op, "escala", 2)
    sea letra = _ui_letra(op, escala)
    mientras escala > 1 y no op.contiene("fuente") {
        sea mayor = 0
        para cada texto t en filas + pie + [titulo] { mayor = matematica.maximo(mayor, juego.ancho_texto(t, letra)) }
        si mayor <= juego.ancho() * 0.94 y juego.medir_texto("Ay", letra)[1] * 2 * (maximo + 4) <= juego.alto() * 0.95 { romper }
        escala = escala - 1
        letra = _ui_letra(op, escala)
    }
    sea alto = juego.medir_texto("Ay", letra)[1]
    sea gris = [150, 150, 170]
    sea normal = _de(op, "color", [210, 210, 220])
    sea amarillo = _de(op, "color_elegido", [255, 220, 80])
    funcion escribir_en(texto t, numero y, lista color): nulo {
        sea o2 = {"color": color, "alinear": "centro"}
        para cada texto c en letra { o2[c] = letra[c] }
        juego.texto(t, juego.ancho() / 2, y, o2)
    }
    sea paso = alto * 2
    sea arriba = juego.alto() / 2 - paso * (maximo + 4) / 2
    escribir_en(titulo, arriba, normal)
    para (k = 1; k <= maximo; k++) {
        escribir_en(filas[k - 1], arriba + (k + 1) * paso, si k <= _jugadores.longitud() { amarillo } sino { gris })
    }
    para (k = 0; k < pie.longitud(); k++) { escribir_en(pie[k], arriba + (maximo + 2.5 + k * 0.7) * paso, gris) }
    juego.camara(camara)
    devolver resultado
}

# ── La cámara: de la pantalla al mundo y al revés ──
# Con la cámara de ahora (camara_actual(): zoom, giro y zona incluidos), sin el
# temblor. El zoom y el giro van alrededor del centro de la zona.

funcion _punto(cualquiera x, cualquiera y, texto fn): lista {
    si x es lista y y == nulo y x.longitud() >= 2 { devolver [x[0], x[1]] }
    si no (x es numero) o no (y es numero) { lanzar ErrorTipo("{fn}() espera (x, y) o una lista [x, y]") }
    devolver [x, y]
}

funcion _zona_camara(diccionario c): lista {
    si c["zona"] != nulo { devolver c["zona"] }
    devolver [0, 0, juego.ancho(), juego.alto()]
}

# a_mundo(x, y): el punto del mundo que se ve en (x, y) de la pantalla; para
# saber dónde ha tocado o hecho clic el jugador: juego.a_mundo(juego.raton())
funcion a_mundo(cualquiera x, cualquiera y = nulo): lista {
    sea p = _punto(x, y, "a_mundo")
    sea c = juego.camara_actual()
    sea z = _zona_camara(c)
    sea dx = p[0] - (z[0] + z[2] / 2)
    sea dy = p[1] - (z[1] + z[3] / 2)
    sea g = matematica.radianes(c["angulo"])
    devolver [c["x"] + z[2] / 2 + (dx * matematica.coseno(g) + dy * matematica.seno(g)) / c["zoom"],
        c["y"] + z[3] / 2 + (dy * matematica.coseno(g) - dx * matematica.seno(g)) / c["zoom"]]
}

# a_pantalla(x, y): dónde se ve en la pantalla el punto (x, y) del mundo
funcion a_pantalla(cualquiera x, cualquiera y = nulo): lista {
    sea p = _punto(x, y, "a_pantalla")
    sea c = juego.camara_actual()
    sea z = _zona_camara(c)
    sea dx = (p[0] - c["x"] - z[2] / 2) * c["zoom"]
    sea dy = (p[1] - c["y"] - z[3] / 2) * c["zoom"]
    sea g = matematica.radianes(c["angulo"])
    devolver [z[0] + z[2] / 2 + dx * matematica.coseno(g) - dy * matematica.seno(g),
        z[1] + z[3] / 2 + dx * matematica.seno(g) + dy * matematica.coseno(g)]
}

# ── Sonido que sale de un sitio del mundo ──
# reproducir_en(sonido, x, y[, opciones]): como reproducir(), pero se oye por
# la izquierda o por la derecha según dónde se ve (x, y) en la pantalla, y más
# bajo cuanto más lejos queda de lo que se ve. Opciones: las de reproducir() y
# "alcance" (a cuántos píxeles fuera de la pantalla deja de oírse; por
# defecto, la mitad de su ancho). mover_voz(voz, x, y) lo vuelve a calcular,
# para lo que suena mientras se mueve (un coche, la cascada al pasar).

sea _voces_en = {}    # {voz: {"volumen", "alcance"}} de lo que salió de reproducir_en()

funcion _oido(numero x, numero y, numero alcance): lista {
    sea p = a_pantalla(x, y)
    sea z = _zona_camara(juego.camara_actual())
    sea mitad = z[2] / 2
    sea lado = matematica.maximo(-1, matematica.minimo(1, (p[0] - z[0] - mitad) / mitad)) * 0.8
    sea dx = matematica.maximo(0, matematica.maximo(z[0] - p[0], p[0] - z[0] - z[2]))
    sea dy = matematica.maximo(0, matematica.maximo(z[1] - p[1], p[1] - z[1] - z[3]))
    sea d = matematica.raiz(dx * dx + dy * dy)
    devolver [matematica.maximo(0, 1 - d / alcance), lado]
}

funcion reproducir_en(cualquiera sonido, numero x, numero y, cualquiera opciones = nulo): numero {
    sea op = {}
    si opciones != nulo {
        si no (opciones es diccionario) { lanzar ErrorTipo("reproducir_en(): las opciones son un diccionario, como las de reproducir()") }
        para cada texto c en opciones { op[c] = opciones[c] }
    }
    sea alcance = _de(op, "alcance", juego.ancho() / 2)
    si no (alcance es numero) o alcance <= 0 { lanzar ErrorArgumento("reproducir_en(): \"alcance\" son los píxeles fuera de la pantalla hasta dejar de oírse (más que 0)") }
    si op.contiene("alcance") { op.eliminar("alcance") }
    si op.contiene("lado") { lanzar ErrorArgumento("reproducir_en(): el lado sale de dónde está (x, y); para ponerlo a mano, reproducir()") }
    sea volumen = _de(op, "volumen", 1)
    sea oido = _oido(x, y, alcance)
    op["volumen"] = matematica.maximo(0, matematica.minimo(1, volumen * oido[0]))
    op["lado"] = oido[1]
    sea voz = juego.reproducir(sonido, op)
    sea siguen = {}                              # de paso, se olvidan las que ya acabaron
    para cada texto k en _voces_en { si juego.sonando(a_numero(k)) { siguen[k] = _voces_en[k] } }
    _voces_en = siguen
    si voz > 0 { _voces_en["{voz}"] = {"volumen": volumen, "alcance": alcance} }
    devolver voz
}

# mover_voz(voz, x, y): devuelve si sigue sonando
funcion mover_voz(numero voz, numero x, numero y): logico {
    sea k = "{voz}"
    si no _voces_en.contiene(k) {
        si juego.sonando(voz) { lanzar ErrorArgumento("mover_voz(): esa voz no salió de reproducir_en()") }
        devolver falso
    }
    sea oido = _oido(x, y, _voces_en[k]["alcance"])
    sea v = matematica.maximo(0, matematica.minimo(1, _voces_en[k]["volumen"] * oido[0]))
    si juego.cambiar_voz(voz, {"volumen": v, "lado": oido[1], "fundido": 0.05}) { devolver verdadero }
    _voces_en.eliminar(k)
    devolver falso
}

# ── Texto en una caja ──

# texto_caja(t, x, y, ancho, alto[, opciones]): escribe el texto partido en
# líneas dentro de esa caja; si no cabe entero, la última línea acaba en
# "..." y devuelve lo que falta (para la página siguiente), o "" si cabe.
# Opciones: las de texto() (fuente, escala, color, alinear, capa) y vertical
# ("arriba", "centro" o "abajo": dónde va el texto dentro de la caja). Con
# "medir": verdadero no escribe nada: solo devuelve lo que faltaría.
funcion texto_caja(texto t, numero x, numero y, numero ancho, numero alto,
        cualquiera opciones = nulo): texto {
    sea aj = _ui_opciones(opciones, ["fuente", "escala", "color", "alinear", "capa", "vertical", "medir"], "texto_caja")
    sea letra = {}
    para cada texto c en aj {
        si c != "vertical" y c != "medir" { letra[c] = aj[c] }
    }
    si no letra.contiene("escala") y no letra.contiene("fuente") { letra["escala"] = 2 }
    sea alto_linea = juego.medir_texto("Ay\nAy", letra)[1] - juego.medir_texto("Ay", letra)[1]
    sea alto_letra = juego.medir_texto("Ay", letra)[1]
    sea lineas = _partir_lineas(t, ancho, letra)
    sea caben = 0
    mientras caben < lineas.longitud() y caben * alto_linea + alto_letra <= alto + 0.001 { caben = caben + 1 }
    sea resto = ""
    si caben < lineas.longitud() {
        # lo que falta, sin repetir lo escrito: las líneas que no caben, juntas
        sea quedan = []
        para (k = caben; k < lineas.longitud(); k++) { quedan.agregar(lineas[k]) }
        resto = texto.unir(quedan, " ")
        si caben > 0 {
            sea u = lineas[caben - 1]
            mientras u != "" y juego.ancho_texto(u + "...", letra) > ancho {
                sea palabras = u.dividir(" ")
                si palabras.longitud() > 1 {
                    # la última palabra pasa a la página siguiente
                    resto = palabras[palabras.longitud() - 1] + " " + resto
                    palabras.eliminar(palabras.longitud() - 1)
                    u = texto.unir(palabras, " ")
                } sino {
                    u = u.extraer(0, u.longitud() - 1)
                }
            }
            lineas[caben - 1] = u + "..."
        }
    }
    si _de(aj, "medir", falso) { devolver resto }
    sea total = si caben == 0 { 0 } sino { (caben - 1) * alto_linea + alto_letra }
    sea v = _de(aj, "vertical", "arriba")
    si v == "centro" { y = y + (alto - total) / 2 }
    sino si v == "abajo" { y = y + alto - total }
    sino si v != "arriba" { lanzar ErrorArgumento("texto_caja(): \"vertical\" es \"arriba\", \"centro\" o \"abajo\"") }
    sea px = x
    si letra.contiene("alinear") y letra["alinear"] == "centro" { px = x + ancho / 2 }
    sino si letra.contiene("alinear") y letra["alinear"] == "derecha" { px = x + ancho }
    para (k = 0; k < caben; k++) { juego.texto(lineas[k], px, y + k * alto_linea, letra) }
    devolver resto
}

# ── Idiomas ──
# Cada idioma es un archivo idiomas/<código>.txt junto al juego (en.txt,
# fr.txt…), con una traducción por línea, «texto original = traducción»; las
# líneas que empiezan por # son comentarios, \n es un salto de línea y
# «idioma = English» es el nombre del idioma para el menú. traducir() da la
# traducción, o el texto tal cual si no la hay. La primera vez se elige solo:
# el que eligió el jugador con menu_idiomas() o, si no, el del sistema.
sea _idioma = nulo                # el código del idioma elegido, o nulo
sea _traducciones = {}
sea _idioma_elegido = falso       # ya se ha elegido (o mirado) el idioma

funcion _leer_idioma(texto codigo): cualquiera {
    sea ruta = "idiomas/" + codigo + ".txt"
    si no archivos.existe(ruta) { devolver nulo }
    sea d = {}
    para cada texto linea en archivos.leer(ruta).dividir("\n") {
        sea l = linea.recortar()
        si l == "" o l.empieza_con("#") { continuar }
        sea i = l.posicion(" = ")
        sea salto = 3
        si i < 0 {
            i = l.posicion("=")
            salto = 1
        }
        si i <= 0 { continuar }
        sea clave = l.extraer(0, i).recortar().reemplazar("\\n", "\n")
        d[clave] = l.extraer(i + salto, l.longitud()).recortar().reemplazar("\\n", "\n")
    }
    devolver d
}

funcion _codigo_idioma_bien(cualquiera c): logico {
    si no (c es texto) o c == "" o c.longitud() > 16 { devolver falso }
    para cada texto letra en c {
        si no letra.es_letra() y no letra.es_numero() y letra != "_" y letra != "-" { devolver falso }
    }
    devolver verdadero
}

funcion _elegir_idioma_inicial(): nulo {
    si _idioma_elegido { devolver nulo }
    _idioma_elegido = verdadero
    sea hay = idiomas()
    si hay.longitud() == 0 { devolver nulo }
    sea guardado = nulo
    intentar { guardado = juego.cargar_partida("lince_idioma") } capturar (error e) { guardado = nulo }
    si guardado es texto y hay.contiene(guardado) {
        idioma(guardado)
        devolver nulo
    }
    sea sistema = juego._idioma_sistema()
    si hay.contiene(sistema) { idioma(sistema) }
}

# idioma(código): elige el idioma ("" o nulo: los textos como están escritos);
# idioma(): el que hay, o nulo
funcion idioma(cualquiera codigo = "?"): cualquiera {
    si codigo == "?" {
        _elegir_idioma_inicial()
        devolver _idioma
    }
    _idioma_elegido = verdadero
    si codigo == nulo o codigo == "" {
        _idioma = nulo
        _traducciones = {}
        devolver nulo
    }
    si no _codigo_idioma_bien(codigo) {
        lanzar ErrorTipo("idioma() espera el código de un idioma, como \"en\" (el de idiomas/en.txt)")
    }
    sea d = _leer_idioma(codigo)
    si d == nulo {
        lanzar ErrorArgumento("idioma(): no está idiomas/{codigo}.txt (cada idioma es un archivo en la carpeta idiomas del juego)")
    }
    _idioma = codigo
    _traducciones = d
    devolver codigo
}

# idiomas(): {código: nombre} de los idiomas que tiene el juego
funcion idiomas(): diccionario {
    sea r = {}
    si no archivos.existe("idiomas") y archivos.listar("idiomas").longitud() == 0 { devolver r }
    sea nombres = archivos.listar("idiomas")
    nombres.ordenar()
    para cada texto a en nombres {
        si a.termina_con(".txt") {
            sea c = a.extraer(0, a.longitud() - 4)
            si _codigo_idioma_bien(c) {
                sea d = _leer_idioma(c)
                si d != nulo { r[c] = _de(d, "idioma", c) }
            }
        }
    }
    devolver r
}

# traducir(t[, valores]): la traducción de t en el idioma elegido (o t, si no
# la hay), con cada {} cambiado por un valor, en orden: valores es uno solo o
# una lista. traducir("Vidas: {}", vidas), traducir("{} de {}", [a, b])
funcion traducir(texto t, cualquiera valores = nulo): texto {
    si no _idioma_elegido { _elegir_idioma_inicial() }
    sea r = si _traducciones.contiene(t) { _traducciones[t] } sino { t }
    si valores == nulo { devolver r }
    si no (valores es lista) { valores = [valores] }
    para cada cualquiera v en valores {
        sea i = r.posicion("{}")
        si i < 0 { romper }
        r = r.extraer(0, i) + a_texto(v) + r.extraer(i + 2, r.longitud())
    }
    devolver r
}

fijo _IDIOMAS_OPCIONES = ["x", "y", "escala", "fuente", "color", "color_elegido", "separacion", "sonido_mover", "sonido_elegir"]

# menu_idiomas([opciones]): un menú con los idiomas del juego (por su nombre)
# y «Volver». Elegir uno lo pone y lo guarda para la próxima vez. Se llama en
# cada fotograma mientras se vea; devuelve el código elegido, "volver" al
# salir (también con escape o B), o nulo. Opciones: las de menu().
funcion menu_idiomas(cualquiera opciones = nulo): cualquiera {
    sea aj = _ui_opciones(opciones, _IDIOMAS_OPCIONES, "menu_idiomas")
    sea hay = idiomas()
    sea codigos = []
    sea textos = []
    para cada texto c en hay {
        codigos.agregar(c)
        textos.agregar(hay[c])
    }
    textos.agregar("Volver")
    aj["atras"] = "Volver"
    sea e = menu(textos, aj)
    si e == nulo { devolver nulo }
    para (i = 0; i < codigos.longitud(); i++) {
        si textos[i] == e {
            idioma(codigos[i])
            intentar { juego.guardar_partida("lince_idioma", codigos[i]) } capturar (error x) {}
            devolver codigos[i]
        }
    }
    devolver "volver"
}
