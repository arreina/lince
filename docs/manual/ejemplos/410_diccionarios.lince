# @seccion: Diccionarios
# @titulo: Crear, leer y recorrer
# @nota: Las claves son texto o número. `para cada` sobre un diccionario recorre las claves, y `claves()` y `valores()` las dan como listas.
sea persona = {"nombre": "Ana", "edad": 22}
persona["ciudad"] = "Córdoba"

escribir(persona["nombre"])
escribir(persona.longitud())

para cada texto clave en persona {
    escribir(clave + " = " + persona[clave])
}

# Como listas: se pueden ordenar, contar o pasar a otra función
escribir(persona.claves())
escribir(persona.valores())
escribir(persona.claves().ordenar())
