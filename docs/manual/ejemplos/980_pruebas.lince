# @seccion: Módulos y librerías
# @titulo: El módulo `pruebas`
# @nota: Pruebas unitarias para tus programas: `afirmar` comprueba una condición, `igual` compara valores (también listas y diccionarios), `lanza` comprueba que una función da error y `resumen` imprime el total y termina con código 1 si algo falló, ideal para la integración continua.
importar "pruebas"

funcion doble(numero n): numero {
    devolver n * 2
}

pruebas.suite("doble")
pruebas.afirmar("doble de 4 es 8", doble(4) == 8)
pruebas.igual("una lista de dobles", [doble(1), doble(2)], [2, 4])
pruebas.lanza("dividir por cero da error", funcion(): nulo { sea x = 1 / 0 })
pruebas.resumen()
