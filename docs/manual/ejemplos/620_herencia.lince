# @seccion: Clases
# @titulo: Herencia
# @nota: `extiende` hereda; `padre(...)` llama al constructor de arriba.
clase Figura {
    funcion crear(texto nombre): nulo { mi.nombre = nombre }
    funcion describir(): texto { devolver "soy un " + mi.nombre }
}

clase Cuadrado extiende Figura {
    funcion crear(numero lado): nulo {
        padre("cuadrado")
        mi.lado = lado
    }
    funcion area(): numero { devolver mi.lado * mi.lado }
}

sea c = Cuadrado(5)
escribir(c.describir())
escribir(c.area())
