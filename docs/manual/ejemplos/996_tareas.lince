# @seccion: Módulos y librerías
# @titulo: Concurrencia con `tareas`
# @nota: Cada tarea corre una función en un proceso aparte, así que varias pueden trabajar a la vez en distintos núcleos y no comparten memoria (no hay carreras de datos): lo que entra y sale viaja copiado. `iniciar` lanza una tarea y `esperar` recoge su resultado; `mapear` aplica una función a cada elemento de una lista en paralelo y devuelve los resultados en orden. Un error dentro de la tarea llega como `ErrorTarea`. No disponible en Windows.
importar "tareas"

funcion cuadrado(val numero n): numero {
    devolver n * n
}

sea a = tareas.iniciar(cuadrado, [6])
sea b = tareas.iniciar(cuadrado, [7])
escribir(tareas.esperar(a) + tareas.esperar(b))

escribir(tareas.mapear([1, 2, 3, 4, 5], cuadrado))

intentar {
    tareas.esperar(tareas.iniciar(funcion(): nulo { lanzar Error("algo falló") }))
} capturar (ErrorTarea e) {
    escribir("la tarea falló: " + e.mensaje)
}
