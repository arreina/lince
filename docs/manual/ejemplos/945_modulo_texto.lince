# @seccion: Módulos y librerías
# @titulo: El módulo `texto`
# @nota: Lo que se hace con textos y no es un método: partirlos por un separador, unir una lista, darles la vuelta buscar dónde aparece algo (−1 si no está) y escribir números con los decimales justos o con los miles separados.
importar "texto"

sea partes = "rojo,verde,azul".dividir(",")
escribir(partes)
escribir(texto.unir(partes, " y "))
escribir("lince".invertir())
escribir("{"perspicaz".posicion("pica")} {"lince".posicion("x")}")
escribir(texto.decimales(3.5, 2))
escribir(texto.miles(1234567))
escribir(texto.miles(1234.5))
