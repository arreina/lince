# @seccion: Módulos y librerías
# @titulo: El módulo `texto`
# @nota: Lo que se hace con textos y no es un método: partirlos por un separador, unir una lista, darles la vuelta y buscar dónde aparece algo (−1 si no está).
importar "texto"

sea partes = texto.dividir("rojo,verde,azul", ",")
escribir(partes)
escribir(texto.unir(partes, " y "))
escribir(texto.invertir("lince"))
escribir("{texto.posicion("perspicaz", "pica")} {texto.posicion("lince", "x")}")
