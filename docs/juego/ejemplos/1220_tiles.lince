# @seccion: Mapas
# @titulo: Tiles y tiles animados
# @nota: Lo normal es pintar el nivel con una hoja de tiles: a cada carácter, `[hoja, cuadro]`, o `[hoja, [cuadros], segundos]` para uno animado (el agua, las monedas). Los tiles se ajustan al tamaño de la casilla. `juego.casilla` y `juego.poner_casilla` leen y cambian una casilla (coger una moneda, abrir una puerta), y `juego.buscar_en_mapa` dice dónde están.
importar "juego"

juego.abrir("Tiles", 480, 270)
fijo TILES = juego.hoja("recursos/tiles.png", 16)
fijo NIVEL = juego.mapa.crear([
    "...............",
    "..c.......c....",
    "...............",
    "......$$$......",
    "....-----..x...",
    "............xx.",
    "hhhhhh~~~hhhhhh",
    "tttttt~~~tttttt"
], 32)
mientras juego.abierto() {
    juego.limpiar([120, 190, 240])
    juego.mapa.dibujar(NIVEL, {
        "h": [TILES, 0], "t": [TILES, 1], "x": [TILES, 5], "-": [TILES, 12], "c": [TILES, 10],
        "~": [TILES, [3, 4], 0.4],                 # agua: dos cuadros
        "$": [TILES, [6, 7, 8, 9], 0.12]           # monedas que giran
    })
    juego.texto("MONEDAS: {juego.mapa.buscar(NIVEL, "$").longitud()}", 10, 8, {"escala": 2})
    juego.presentar()
}
