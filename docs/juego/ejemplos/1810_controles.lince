# @seccion: Controles
# @titulo: Que el jugador elija sus teclas
# @nota: `juego.menu_controles()` enseña cada acción con sus teclas y sus botones, y deja cambiarlos: se elige una y se pulsa lo nuevo. Si otra acción ya lo usaba, se intercambian. Lo cambiado **se guarda solo** y se aplica solo la próxima vez que el juego defina esa acción, sin hacer nada más. Devuelve `"volver"` al salir. `juego.restablecer_controles()` vuelve a los del juego.
# @fotogramas: 3
importar "juego"

juego.abrir("Controles", 480, 270)
juego.definir_accion("izquierda", ["izquierda", "a", "mando:izq_x-"])
juego.definir_accion("derecha", ["derecha", "d", "mando:izq_x+"])
juego.definir_accion("saltar", ["espacio", "mando:a"])
juego.definir_accion("disparar", ["z", "mando:x"])
mientras juego.abierto() {
    juego.limpiar([20, 22, 36])
    si juego.menu_controles({"nombres": {"izquierda": "Izquierda", "derecha": "Derecha", "saltar": "Saltar", "disparar": "Disparar"}}) == "volver" {
        juego.salir()
    }
    juego.presentar()
}
