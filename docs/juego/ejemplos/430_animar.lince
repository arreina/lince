# @seccion: Hojas de sprites
# @titulo: Animaciones a partir de un dibujo
# @nota: Con un solo dibujo, `juego.animar(imagen, tipo)` hace los cuadros de una animación: `"andar"` y `"correr"` mueven las piernas; `"respirar"`, `"saltar"`, `"golpe"`, `"morir"`, `"flotar"` y `"girar"` mueven el dibujo entero. Da una hoja, así que se puede cambiar después por una dibujada a mano sin tocar el resto.
# @fotogramas: 25
importar "juego"

juego.abrir("Animar", 480, 270)
fijo DIBUJO = juego.hoja("recursos/lince.png", 16)
fijo QUIETO = juego.sprite(["..X..", ".XXX.", "XXXXX", ".X.X.", ".X.X."], {"X": [230, 140, 60]})
fijo TIPOS = ["respirar", "saltar", "flotar", "girar", "morir"]
sea hojas = []
para cada texto t en TIPOS { hojas.agregar(juego.animar(QUIETO, t)) }
mientras juego.abierto() {
    juego.limpiar([25, 35, 50])
    para (i = 0; i < TIPOS.longitud(); i++) {
        juego.dibujar(hojas[i], 30 + i * 90, 90, {"cuadro": juego.cuadro(hojas[i]["cuadros"], 8), "escala": 8})
        juego.texto(TIPOS[i].mayusculas(), 30 + i * 90, 190, 1)
    }
    juego.presentar()
}
