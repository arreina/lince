# @seccion: Texto y letras
# @titulo: Texto con la letra incluida
# @nota: Lince trae una letra de píxeles (mayúsculas, cifras, signos; las tildes y la ñ se marcan). `escala` la agranda, `color` la pinta y `alinear` (`"centro"` o `"derecha"`) cambia de qué lado cuenta la `x`. `juego.ancho_texto()` dice lo que ocupa, para centrar a mano.
importar "juego"

juego.abrir("Texto", 480, 270)
mientras juego.abierto() {
    juego.limpiar([20, 20, 30])
    juego.texto("PUNTOS: 1250", 20, 20, 2)
    juego.texto("¡NIVEL 3!", 240, 90, {"escala": 5, "alinear": "centro", "color": [255, 210, 60]})
    juego.texto("VIDAS 3", 460, 20, {"escala": 2, "alinear": "derecha", "color": [240, 90, 90]})
    sea ancho = juego.ancho_texto("PULSA ESPACIO", 2)
    juego.texto("PULSA ESPACIO", (480 - ancho) / 2, 200, 2)
    juego.presentar()
}
