# @seccion: Móvil
# @titulo: Deslizar el dedo
# @nota: `juego.deslizamiento()` da el gesto en el fotograma en que se levanta el dedo: `"direccion"` ("arriba", "abajo", "izquierda" o "derecha"), `"dx"`, `"dy"`, `"desde"`, `"hasta"` y `"duracion"`; si no, `nulo`. Un recorrido más corto que `"distancia"` (48 por defecto) es un toque, no un deslizamiento. Con `"zona": [x, y, ancho, alto]` solo cuentan los que empiezan ahí. En el ordenador, arrastrar con el botón izquierdo del ratón hace lo mismo.
# @nota: `juego.deslizando()` da el gesto mientras el dedo sigue apoyado: aquí, para dibujar la flecha. En las pruebas, `"30:deslizar:100:300:250:300"` en el guion desliza de un punto al otro.
# @guion: 5:deslizar:200:150:330:150:6,20:deslizar:200:60:200:180:6
# @fotogramas: 40
importar "juego"

fijo LADO = 50
fijo X0 = 140
fijo Y0 = 35
sea casilla = [0, 0]
sea ultima = "ninguna"
juego.abrir("Deslizar", 480, 270)
mientras juego.abierto() {
    sea g = juego.deslizamiento({"distancia": 40})
    si g != nulo {
        ultima = g["direccion"]
        si ultima == "derecha" y casilla[0] < 3 { casilla[0] = casilla[0] + 1 }
        si ultima == "izquierda" y casilla[0] > 0 { casilla[0] = casilla[0] - 1 }
        si ultima == "abajo" y casilla[1] < 3 { casilla[1] = casilla[1] + 1 }
        si ultima == "arriba" y casilla[1] > 0 { casilla[1] = casilla[1] - 1 }
    }
    juego.limpiar([25, 25, 35])
    para (fila = 0; fila < 4; fila++) {
        para (col = 0; col < 4; col++) {
            juego.rectangulo(X0 + col * LADO + 2, Y0 + fila * LADO + 2, LADO - 4, LADO - 4, [50, 50, 70])
        }
    }
    juego.rectangulo(X0 + casilla[0] * LADO + 8, Y0 + casilla[1] * LADO + 8, LADO - 16, LADO - 16, [240, 190, 60])
    sea d = juego.deslizando()
    si d != nulo {
        juego.linea(d["desde"][0], d["desde"][1], d["hasta"][0], d["hasta"][1], [255, 255, 255])
        juego.circulo(d["hasta"][0], d["hasta"][1], 6, [255, 255, 255])
    }
    juego.texto("ÚLTIMA: {ultima}", 20, 245, {"escala": 1})
    juego.presentar()
}
