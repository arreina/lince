# @seccion: Choques
# @titulo: ¿Se tocan?
# @nota: `juego.colision(a, b)` dice si se tocan dos cosas, cada una un punto `[x, y]` (un clic), una caja `[x, y, ancho, alto]` (un botón, un personaje; también un diccionario con `x`, `y`, `ancho` y `alto`) o un círculo `{"centro": [x, y], "radio": r}`.
# @nota: `juego.caja(cosa, x, y)` da el rectángulo de lo que se ve de verdad al dibujar una imagen, una hoja o un animador, sin el hueco transparente de alrededor: para que los choques sean justos.
importar "juego"

juego.abrir("Choques", 480, 270)
fijo LINCE = juego.hoja("recursos/lince.png", 16)
mientras juego.abierto() {
    juego.limpiar([25, 25, 35])
    sea toca = juego.colision([60, 60, 100, 60], [130, 90, 80, 80])
    juego.rectangulo(60, 60, 100, 60, [230, 100, 90, 200])
    juego.rectangulo(130, 90, 80, 80, [90, 160, 230, 200])
    juego.texto("COLISIÓN: {toca}", 60, 190, {"escala": 2})
    juego.dibujar(LINCE, 300, 60, {"escala": 6})
    sea c = juego.caja(LINCE, 300, 60, {"escala": 6})
    juego.contorno(300, 60, 96, 96, [90, 90, 110])                # la celda entera
    juego.contorno(c[0], c[1], c[2], c[3], [255, 220, 80])        # lo que se ve
    juego.texto("CAJA: {c}", 300, 190, {"escala": 1})
    juego.presentar()
}
