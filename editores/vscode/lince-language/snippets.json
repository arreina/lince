{
  "Variable": {
    "prefix": "sea",
    "body": [
      "sea ${1:nombre} = ${2:valor}"
    ],
    "description": "Declara una variable"
  },
  "Constante": {
    "prefix": "fijo",
    "body": [
      "fijo ${1:NOMBRE} = ${2:valor}"
    ],
    "description": "Declara una constante"
  },
  "Lista": {
    "prefix": "lista",
    "body": [
      "sea lista ${1:nombre} = [${2:1, 2, 3}]"
    ],
    "description": "Declara una lista"
  },
  "Diccionario": {
    "prefix": "dic",
    "body": [
      "sea diccionario ${1:nombre} = {\"${2:clave}\": ${3:valor}}"
    ],
    "description": "Declara un diccionario"
  },
  "Función": {
    "prefix": "fun",
    "body": [
      "funcion ${1:nombre}(${2:numero} ${3:param}): ${4:nulo} {",
      "\t$0",
      "}"
    ],
    "description": "Define una función"
  },
  "Función sin parámetros": {
    "prefix": "fun0",
    "body": [
      "funcion ${1:nombre}(): ${2:nulo} {",
      "\t$0",
      "}"
    ],
    "description": "Define una función sin parámetros"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "sea ${1:f} = funcion(${2:numero} ${3:x}): ${4:numero} {",
      "\tdevolver ${5:x}",
      "}"
    ],
    "description": "Función anónima"
  },
  "Generador": {
    "prefix": "generador",
    "body": [
      "generador ${1:contar}(numero ${2:n}): numero {",
      "\tpara (${3:i} = 0; ${3:i} < ${2:n}; ${3:i}++) {",
      "\t\tproducir ${3:i}",
      "\t}",
      "}"
    ],
    "description": "Función generadora"
  },
  "Tarea": {
    "prefix": "tarea",
    "body": [
      "tarea ${1:nombre}() {",
      "\t$2",
      "\tesperar(${3:0.5})",
      "\t$0",
      "}"
    ],
    "description": "Código que se para a esperar sin parar el juego"
  },
  "Si": {
    "prefix": "si",
    "body": [
      "si ${1:condicion} {",
      "\t$0",
      "}"
    ],
    "description": "Condicional"
  },
  "Si / sino": {
    "prefix": "sino",
    "body": [
      "si ${1:condicion} {",
      "\t$2",
      "} sino {",
      "\t$0",
      "}"
    ],
    "description": "Condicional con alternativa"
  },
  "Elegir": {
    "prefix": "elegir",
    "body": [
      "elegir ${1:valor} {",
      "\tcaso ${2:1} {",
      "\t\t$3",
      "\t}",
      "\totro {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Selección múltiple"
  },
  "Para clásico": {
    "prefix": "para",
    "body": [
      "para (${1:i} = 0; ${1:i} < ${2:10}; ${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "Bucle con contador"
  },
  "Para cada": {
    "prefix": "cada",
    "body": [
      "para cada ${1:numero} ${2:x} en ${3:[1, 2, 3]} {",
      "\t$0",
      "}"
    ],
    "description": "Recorre una colección"
  },
  "Mientras": {
    "prefix": "mientras",
    "body": [
      "mientras ${1:condicion} {",
      "\t$0",
      "}"
    ],
    "description": "Bucle mientras"
  },
  "Hacer mientras": {
    "prefix": "hacer",
    "body": [
      "hacer {",
      "\t$0",
      "} mientras (${1:condicion})"
    ],
    "description": "Bucle que se ejecuta al menos una vez"
  },
  "Clase": {
    "prefix": "clase",
    "body": [
      "clase ${1:Nombre} {",
      "\tfuncion crear(${2:numero} ${3:param}): nulo {",
      "\t\tmi.${3:param} = ${3:param}",
      "\t}",
      "\t$0",
      "}"
    ],
    "description": "Define una clase"
  },
  "Clase con herencia": {
    "prefix": "clasex",
    "body": [
      "clase ${1:Nombre} extiende ${2:Padre} {",
      "\tfuncion crear(${3:numero} ${4:param}): nulo {",
      "\t\tpadre(${4:param})",
      "\t}",
      "\t$0",
      "}"
    ],
    "description": "Clase que extiende a otra"
  },
  "Clase abstracta": {
    "prefix": "abstracta",
    "body": [
      "abstracta clase ${1:Figura} {",
      "\tabstracto funcion ${2:area}(): ${3:numero}",
      "\t$0",
      "}"
    ],
    "description": "Clase que no se instancia"
  },
  "Método estático": {
    "prefix": "estatico",
    "body": [
      "estatico funcion ${1:nombre}(): ${2:nulo} {",
      "\t$0",
      "}"
    ],
    "description": "Método de la clase"
  },
  "Campo privado": {
    "prefix": "privado",
    "body": [
      "privado sea ${1:nombre} = ${2:0}"
    ],
    "description": "Campo con visibilidad privada"
  },
  "Propiedad": {
    "prefix": "propiedad",
    "body": [
      "obtener ${1:valor}(): ${2:numero} {",
      "\tdevolver mi._${1:valor}",
      "}",
      "fijar ${1:valor}(${2:numero} ${3:v}): nulo {",
      "\tmi._${1:valor} = ${3:v}",
      "}"
    ],
    "description": "Pareja obtener / fijar"
  },
  "Interfaz": {
    "prefix": "interfaz",
    "body": [
      "interfaz ${1:Forma} {",
      "\tfuncion ${2:area}(): ${3:numero}",
      "}"
    ],
    "description": "Define una interfaz"
  },
  "Enumeración": {
    "prefix": "enumeracion",
    "body": [
      "enumeracion ${1:Color} {",
      "\t${2:Rojo}",
      "\t${3:Verde}",
      "}"
    ],
    "description": "Define una enumeración"
  },
  "Intentar": {
    "prefix": "intentar",
    "body": [
      "intentar {",
      "\t$1",
      "} capturar (${2:error} ${3:e}) {",
      "\tescribir(${3:e}.mensaje)",
      "}"
    ],
    "description": "Captura errores"
  },
  "Intentar con finalmente": {
    "prefix": "finalmente",
    "body": [
      "intentar {",
      "\t$1",
      "} capturar (${2:error} ${3:e}) {",
      "\tescribir(${3:e}.mensaje)",
      "} finalmente {",
      "\t$0",
      "}"
    ],
    "description": "Captura errores y siempre limpia"
  },
  "Lanzar": {
    "prefix": "lanzar",
    "body": [
      "lanzar Error(\"${1:mensaje}\")"
    ],
    "description": "Lanza un error"
  },
  "Importar módulo": {
    "prefix": "importar",
    "body": [
      "importar \"${1:matematica}\""
    ],
    "description": "Importa un módulo estándar"
  },
  "Importar con alias": {
    "prefix": "importarc",
    "body": [
      "importar \"./${1:libreria}\" como ${2:lib}"
    ],
    "description": "Importa un archivo con espacio de nombres"
  },
  "Escribir": {
    "prefix": "esc",
    "body": [
      "escribir(${1:\"mensaje\"})"
    ],
    "description": "Escribe en pantalla"
  }
}
