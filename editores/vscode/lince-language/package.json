{
  "name": "lince-language",
  "displayName": "Lince",
  "description": "Lince, el lenguaje de programación en español: resaltado, snippets, errores en vivo y autocompletado",
  "version": "0.8.0",
  "publisher": "arreina",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/arreina/lince"
  },
  "contributes": {
    "languages": [
      {
        "id": "lince",
        "aliases": [
          "Lince",
          "lince"
        ],
        "extensions": [
          ".lince"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lince",
        "scopeName": "source.lince",
        "path": "./lince.tmLanguage.json"
      }
    ],
    "themes": [],
    "snippets": [
      {
        "language": "lince",
        "path": "./snippets.json"
      }
    ],
    "configuration": {
      "title": "Lince",
      "properties": {
        "lince.ruta": {
          "type": "string",
          "default": "lince",
          "description": "Ruta del ejecutable de Lince (se usa como «lince lsp»)."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lince"
  ]
}
