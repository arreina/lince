# 🐆 Lince — Plataformas
#
# Lleva al lince hasta la bandera. Flechas o A / D para andar, espacio (o W,
# flecha arriba) para saltar; con mando, el stick o la cruceta y el botón A.
# Salta encima de los escarabajos para quitarlos de en medio y recoge monedas.
# F11 pantalla completa. Esc sale.
#
# Muestra: un nivel escrito como texto (cada carácter es una casilla) que
# juego.mapa convierte en un mapa: juego.mover_en_mapa mueve al lince con
# gravedad sin atravesar paredes y con plataformas que se cruzan desde abajo.
# Sprites dibujados con texto y animados como hoja de sprites, una cámara que
# sigue al jugador con un marcador fijo, acciones (cada control se define una
# vez para teclado y mando a la vez), partículas, escenas con fundido (la
# portada y el nivel) y efectos de sonido generados (juego.efecto).
importar "juego"
importar "matematica"

fijo CASILLA = 32
fijo ANCHO = 640
fijo ALTO = 480
fijo GRAVEDAD = 1500
fijo SALTO = -590
fijo VELOCIDAD = 230

# ── El nivel ─────────────────────────────────────────────────────────
#   #  suelo     =  plataforma     o  moneda     E  escarabajo
#   P  salida    M  meta (bandera)
fijo MAPA = [
".................................................................................",
".................................................................................",
".................................................................................",
"..............................o.o.o..............................................",
"...........................=========.................ooo.........................",
"..................o..................................=====...............o.......",
".................===.......................o..o.............................M....",
"..........o.o.............................======.........o.o.....====.......M....",
".........=====.......E.............o.o..............E...=====...............M....",
"...................#####......E...=====.....................................M....",
"..P...........................######...........o.o.o..........E.............M....",
".........E.........................................................#######..#....",
"#########################....###########...######################....############",
"#########################....###########...######################....############",
"#########################....###########...######################....############"
]
fijo COLUMNAS = MAPA[0].longitud()
fijo FILAS = MAPA.longitud()

# ── Sprites hechos con texto: un carácter por píxel ──────────────────
# El lince tiene tres cuadros (quieto y dos pasos) uno al lado del otro:
# es una hoja de sprites de 3 cuadros de 12×13.
fijo COLORES_LINCE = {"O": [235, 150, 60], "K": [40, 30, 30], "W": [250, 240, 225]}
fijo CUERPO = [
    "..K......K..",
    "..OO....OO..",
    "..OOOOOOOO..",
    ".OOKOOOOKOO.",
    ".OOOOOOOOOO.",
    ".OWWWOOWWWO.",
    "..OWWKKWWO..",
    "...OOOOOO...",
    "..OOOOOOOO..",
    ".OOOOOOOOOO.",
    ".OOOOOOOOOO."
]
fijo PATAS = [["..OO....OO..", "..KK....KK.."],
              [".OO......OO.", ".KK......KK."],
              ["...OO..OO...", "...KK..KK..."]]

funcion hoja_del_lince(): lista {
    sea filas = []
    para cada texto fila en CUERPO {
        filas.agregar(fila + fila + fila)
    }
    para cada numero i en rango(0, 2) {
        filas.agregar(PATAS[0][i] + PATAS[1][i] + PATAS[2][i])
    }
    devolver filas
}

# ── Estado ──────────────────────────────────────────────────────────
fijo JW = 22                         # tamaño del lince para chocar
fijo JH = 26
# El lince: lo que juego.mover_en_mapa necesita (posición, tamaño y velocidad)
sea yo = {"x": 0, "y": 0, "ancho": JW, "alto": JH, "vx": 0, "vy": 0, "en_suelo": falso}
sea mira_izquierda = falso
sea monedas = []
sea enemigos = []
sea recogidas = 0
sea vidas = 3
sea estado = "jugando"              # "jugando", "ganado" o "perdido"
sea reloj = 0
sea invulnerable = 0

funcion volver_a_salir(): nulo {
    sea salida = juego.buscar_en_mapa(NIVEL, "P")[0]
    yo["x"] = salida[0] * CASILLA + 5
    yo["y"] = salida[1] * CASILLA + 6
    yo["vx"] = 0
    yo["vy"] = 0
}

funcion empezar(): nulo {
    monedas = []
    enemigos = []
    para cada lista p en juego.buscar_en_mapa(NIVEL, "o") {
        monedas.agregar({"x": p[0] * CASILLA + 10, "y": p[1] * CASILLA + 10, "viva": verdadero})
    }
    para cada lista p en juego.buscar_en_mapa(NIVEL, "E") {
        enemigos.agregar({"x": p[0] * CASILLA + 4, "y": p[1] * CASILLA + 20, "dir": -1, "vivo": verdadero})
    }
    recogidas = 0
    vidas = 3
    reloj = 0
    invulnerable = 0
    estado = "jugando"
    volver_a_salir()
}

funcion herido(): nulo {
    si invulnerable > 0 { devolver nulo }
    vidas = vidas - 1
    juego.efecto("perder", {"largo": 0.5})
    si vidas == 0 {
        estado = "perdido"
    } sino {
        invulnerable = 1.5
        volver_a_salir()
    }
}

# ── Física ───────────────────────────────────────────────────────────
# ¿Se puede andar por encima de esta casilla? (suelo o plataforma)
funcion pisable(val numero c, val numero f): logico {
    devolver juego.solido(NIVEL, c, f) o juego.casilla(NIVEL, c, f) == "="
}

funcion mover_jugador(val numero dt): nulo {
    yo["vx"] = juego.direccion("izquierda", "derecha") * VELOCIDAD
    si yo["vx"] < 0 { mira_izquierda = verdadero }
    si yo["vx"] > 0 { mira_izquierda = falso }
    si yo["en_suelo"] y juego.accion_pulsada("saltar") {
        yo["vy"] = SALTO
        juego.efecto("salto", {"volumen": 0.3})
        polvo()
    }
    yo["vy"] = matematica.minimo(yo["vy"] + GRAVEDAD * dt, 900)

    # el mapa lo mueve sin atravesar paredes y dice si está en el suelo
    sea cayendo = yo["vy"]
    sea estaba_en_suelo = yo["en_suelo"]
    juego.mover_en_mapa(NIVEL, yo, dt)
    si yo["en_suelo"] y no estaba_en_suelo y cayendo > 400 { polvo() }      # aterriza de una buena caída
    si yo["y"] > FILAS * CASILLA { herido() }
    si juego.casilla(NIVEL, matematica.piso((yo["x"] + JW / 2) / CASILLA), matematica.piso((yo["y"] + JH / 2) / CASILLA)) == "M" {
        estado = "ganado"
        juego.efecto("subir")
        juego.particulas(yo["x"] + JW / 2, yo["y"], {"cantidad": 120, "color": [255, 220, 80], "color_final": [255, 80, 80, 0],
                                           "velocidad": [80, 320], "direccion": -90, "apertura": 120,
                                           "gravedad": 500, "vida": [0.8, 1.6], "tamaño": 5})
    }
}

funcion mover_enemigos(val numero dt): nulo {
    para cada diccionario bicho en enemigos {
        si bicho["vivo"] {
            # anda hasta una pared o un borde, y se da la vuelta
            sea nx = bicho["x"] + bicho["dir"] * 60 * dt
            sea delante = nx
            si bicho["dir"] > 0 { delante = nx + 24 }
            sea c = matematica.piso(delante / CASILLA)
            sea f = matematica.piso((bicho["y"] + 6) / CASILLA)
            si juego.solido(NIVEL, c, f) o no pisable(c, f + 1) {
                bicho["dir"] = -bicho["dir"]
            } sino {
                bicho["x"] = nx
            }
            # ¿choca con el lince? Si cae encima, lo aplasta
            si juego.colision(yo["x"], yo["y"], JW, JH, bicho["x"], bicho["y"], 24, 12) {
                si yo["vy"] > 0 y yo["y"] + JH - bicho["y"] < 14 {
                    bicho["vivo"] = falso
                    yo["vy"] = SALTO * 0.6
                    juego.efecto("golpe")
                    juego.particulas(bicho["x"] + 12, bicho["y"] + 6, {"cantidad": 25, "color": [120, 70, 160],
                                     "velocidad": [60, 200], "gravedad": 600, "vida": [0.4, 0.7], "tamaño": [3, 6]})
                } sino {
                    herido()
                }
            }
        }
    }
    para cada diccionario m en monedas {
        si m["viva"] y juego.colision(yo["x"], yo["y"], JW, JH, m["x"], m["y"], 12, 12) {
            m["viva"] = falso
            recogidas = recogidas + 1
            juego.efecto("moneda", {"volumen": 0.35})
            juego.particulas(m["x"] + 6, m["y"] + 6, {"cantidad": 16, "color": [250, 200, 50], "color_final": [255, 255, 255, 0],
                                                      "velocidad": [40, 140], "vida": [0.3, 0.6], "tamaño": [3, 5]})
        }
    }
}

# Polvo bajo los pies al saltar o al caer
funcion polvo(): nulo {
    juego.particulas(yo["x"] + JW / 2, yo["y"] + JH, {"cantidad": 10, "color": [235, 225, 200, 200], "velocidad": [20, 70],
                                             "direccion": -90, "apertura": 160, "vida": [0.2, 0.4],
                                             "tamaño": 5, "tamaño_final": 1})
}

# ── Portada ──────────────────────────────────────────────────────────
funcion portada(): nulo {
    juego.limpiar([120, 190, 235])
    juego.rectangulo(0, ALTO - 96, ANCHO, 96, [150, 95, 55])
    juego.rectangulo(0, ALTO - 96, ANCHO, 12, [90, 180, 70])
    sea t = "EL LINCE SALTARIN"
    juego.texto(t, (ANCHO - juego.ancho_texto(t, 5)) / 2, 120, 5, [255, 255, 255])
    # el lince corre en el sitio: cuadros 1 y 2 de la hoja, 10 por segundo
    juego.dibujar(LINCE, ANCHO / 2 - 36, ALTO - 96 - 78, {"celda": [12, 13], "cuadro": 1 + juego.cuadro(2, 10), "escala": 6})
    si juego.cuadro(2, 2) == 0 {
        sea p = "PULSA ESPACIO PARA EMPEZAR"
        juego.texto(p, (ANCHO - juego.ancho_texto(p, 2)) / 2, 220, 2, [255, 240, 200])
    }
    si juego.accion_pulsada("empezar") {
        empezar()
        juego.cambiar_escena("nivel", 0.6)
    }
}

# ── Un fotograma del nivel ────────────────────────────────────────────
funcion nivel(val numero dt): nulo {
    si estado == "jugando" {
        reloj = reloj + dt
        invulnerable = matematica.maximo(0, invulnerable - dt)
        mover_jugador(dt)
        mover_enemigos(dt)
    } sino si juego.accion_pulsada("empezar") {
        empezar()
    }

    # ── el mundo, con la cámara siguiendo al lince ──
    juego.limpiar([120, 190, 235])
    sea cam_x = matematica.limitar(yo["x"] - ANCHO / 2, 0, COLUMNAS * CASILLA - ANCHO)
    juego.camara(cam_x, 0)
    sea c_ini = matematica.piso(cam_x / CASILLA)
    para cada numero f en rango(0, FILAS) {
        para cada numero c en rango(c_ini, c_ini + ANCHO / CASILLA + 2) {
            sea t = juego.casilla(NIVEL, c, f)
            sea x = c * CASILLA
            sea arriba = f * CASILLA
            si t == "#" {
                juego.rectangulo(x, arriba, CASILLA, CASILLA, [150, 95, 55])
                si no juego.solido(NIVEL, c, f - 1) { juego.rectangulo(x, arriba, CASILLA, 8, [90, 180, 70]) }
            } sino si t == "=" {
                juego.rectangulo(x, arriba, CASILLA, 12, [180, 130, 80])
                juego.contorno(x, arriba, CASILLA, 12, [120, 80, 45])
            } sino si t == "M" y juego.casilla(NIVEL, c, f - 1) != "M" {
                juego.rectangulo(x + 14, arriba, 4, CASILLA * 5, [240, 240, 240])
                juego.rectangulo(x + 18, arriba + 2, 26, 18, [230, 60, 60])
            }
        }
    }
    para cada diccionario m en monedas {
        si m["viva"] {
            juego.dibujar(MONEDA, m["x"], m["y"] + matematica.seno(juego.tiempo() * 5 + m["x"]) * 3, {"escala": 2})
        }
    }
    para cada diccionario bicho en enemigos {
        si bicho["vivo"] { juego.dibujar(ESCARABAJO, bicho["x"], bicho["y"], {"escala": 2, "espejo": bicho["dir"] > 0}) }
    }
    sea cuadro = 0
    si no yo["en_suelo"] {
        cuadro = 1
    } sino si yo["vx"] != 0 {
        cuadro = 1 + juego.cuadro(2, 10)
    }
    si invulnerable == 0 o matematica.piso(invulnerable * 12) % 2 == 0 {
        juego.dibujar(LINCE, yo["x"] - 1, yo["y"], {"celda": [12, 13], "cuadro": cuadro, "escala": 2, "espejo": mira_izquierda})
    }

    juego.dibujar_particulas()

    # ── marcador, fijo en pantalla ──
    juego.camara()
    juego.dibujar(MONEDA, 12, 12, {"escala": 2})
    juego.texto("x " + a_texto(recogidas), 32, 14, 2, [255, 255, 255])
    juego.texto("VIDAS " + a_texto(vidas), 120, 14, 2, [255, 255, 255])
    sea t = "TIEMPO " + a_texto(matematica.piso(reloj))
    juego.texto(t, ANCHO - juego.ancho_texto(t, 2) - 12, 14, 2, [255, 255, 255])
    si estado != "jugando" {
        juego.rectangulo(0, 180, ANCHO, 110, [0, 0, 0, 160])
        sea m = "HAS LLEGADO!"
        si estado == "perdido" { m = "FIN DEL JUEGO" }
        juego.texto(m, (ANCHO - juego.ancho_texto(m, 4)) / 2, 200, 4, [255, 220, 80])
        sea r = a_texto(recogidas) + " MONEDAS EN " + a_texto(matematica.piso(reloj)) + " S - ESPACIO PARA REPETIR"
        juego.texto(r, (ANCHO - juego.ancho_texto(r, 2)) / 2, 250, 2, [255, 255, 255])
    }
}

juego.abrir("Plataformas", ANCHO, ALTO)

# ── Controles: cada acción con su teclado y su mando ─────────────────
juego.definir_accion("izquierda", ["izquierda", "a", "mando:izquierda", "mando:izq_x-"])
juego.definir_accion("derecha", ["derecha", "d", "mando:derecha", "mando:izq_x+"])
juego.definir_accion("saltar", ["espacio", "arriba", "w", "mando:a"])
juego.definir_accion("empezar", ["espacio", "entrar", "mando:a", "mando:inicio"])
# El nivel como mapa de casillas: '#' es pared y '=' plataforma (se atraviesa desde abajo)
fijo NIVEL = juego.mapa(MAPA, CASILLA, {"plataformas": "="})

fijo LINCE = juego.sprite(hoja_del_lince(), COLORES_LINCE)
fijo ESCARABAJO = juego.sprite([
    "...MMMMMM...",
    "..MMMMMMMM..",
    ".MMWKMMWKMM.",
    ".MMMMMMMMMM.",
    "MMMMMMMMMMMM",
    ".K.K....K.K."
], {"M": [120, 70, 160], "W": [255, 255, 255], "K": [30, 20, 40]})
fijo MONEDA = juego.sprite([
    "..YY..",
    ".YYYY.",
    "YYWYYY",
    "YYWYYY",
    ".YYYY.",
    "..YY.."
], {"Y": [250, 200, 50], "W": [255, 250, 220]})
si no juego.recargado() {                   # al recargar en caliente sigue la partida
    empezar()
    juego.cambiar_escena("portada")
}

mientras juego.abierto() {
    si juego.tecla_pulsada("escape") { juego.salir() }
    si juego.tecla_pulsada("f11") { juego.pantalla_completa() }
    si juego.escena() == "portada" { portada() } sino { nivel(juego.dt()) }
    juego.presentar()
}
