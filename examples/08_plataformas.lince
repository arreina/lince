# 🐆 Lince — Plataformas
#
# Lleva al lince hasta la bandera. Flechas o A / D para andar, espacio (o W,
# flecha arriba) para saltar; con mando, el stick o la cruceta y el botón A.
# Salta encima de los escarabajos para quitarlos de en medio y recoge monedas.
# F11 pantalla completa. Esc sale.
#
# Muestra: un nivel escrito como texto (cada carácter es una casilla), sprites
# dibujados con texto y animados como hoja de sprites, gravedad y colisiones
# con el mapa, una cámara que sigue al jugador con un marcador fijo, y
# acciones: cada control se define una vez para teclado y mando a la vez.
importar "juego"
importar "matematica"

fijo CASILLA = 32
fijo ANCHO = 640
fijo ALTO = 480
fijo GRAVEDAD = 1500
fijo SALTO = -590
fijo VELOCIDAD = 230

# ── El nivel ─────────────────────────────────────────────────────────
#   #  suelo     =  plataforma     o  moneda     E  escarabajo
#   P  salida    M  meta (bandera)
fijo MAPA = [
".................................................................................",
".................................................................................",
".................................................................................",
"..............................o.o.o..............................................",
"...........................=========.................ooo.........................",
"..................o..................................=====...............o.......",
".................===.......................o..o.............................M....",
"..........o.o.............................======.........o.o.....====.......M....",
".........=====.......E.............o.o..............E...=====...............M....",
"...................#####......E...=====.....................................M....",
"..P...........................######...........o.o.o..........E.............M....",
".........E.........................................................#######..#....",
"#########################....###########...######################....############",
"#########################....###########...######################....############",
"#########################....###########...######################....############"
]
fijo COLUMNAS = MAPA[0].longitud()
fijo FILAS = MAPA.longitud()

# ── Sprites hechos con texto: un carácter por píxel ──────────────────
# El lince tiene tres cuadros (quieto y dos pasos) uno al lado del otro:
# es una hoja de sprites de 3 cuadros de 12×13.
fijo COLORES_LINCE = {"O": [235, 150, 60], "K": [40, 30, 30], "W": [250, 240, 225]}
fijo CUERPO = [
    "..K......K..",
    "..OO....OO..",
    "..OOOOOOOO..",
    ".OOKOOOOKOO.",
    ".OOOOOOOOOO.",
    ".OWWWOOWWWO.",
    "..OWWKKWWO..",
    "...OOOOOO...",
    "..OOOOOOOO..",
    ".OOOOOOOOOO.",
    ".OOOOOOOOOO."
]
fijo PATAS = [["..OO....OO..", "..KK....KK.."],
              [".OO......OO.", ".KK......KK."],
              ["...OO..OO...", "...KK..KK..."]]

funcion hoja_del_lince(): lista {
    sea filas = []
    para cada texto fila en CUERPO {
        filas.agregar(fila + fila + fila)
    }
    para cada numero i en rango(0, 2) {
        filas.agregar(PATAS[0][i] + PATAS[1][i] + PATAS[2][i])
    }
    devolver filas
}

# ── Estado ──────────────────────────────────────────────────────────
sea px = 0
sea py = 0
sea vx = 0
sea vy = 0
sea en_suelo = falso
sea mira_izquierda = falso
sea monedas = []
sea enemigos = []
sea recogidas = 0
sea vidas = 3
sea estado = "jugando"              # "jugando", "ganado" o "perdido"
sea reloj = 0
sea invulnerable = 0

funcion casilla(val numero c, val numero f): texto {
    si c < 0 o c >= COLUMNAS o f < 0 o f >= FILAS { devolver "." }
    devolver MAPA[f][c]
}

funcion solido(val numero c, val numero f): logico {
    si c < 0 o c >= COLUMNAS { devolver verdadero }         # bordes del nivel
    sea t = casilla(c, f)
    devolver t == "#" o t == "="
}

# ¿Toca algo sólido un rectángulo del mundo?
funcion choca(val numero x, val numero arriba, val numero w, val numero h): logico {
    sea c0 = matematica.piso(x / CASILLA)
    sea c1 = matematica.piso((x + w - 1) / CASILLA)
    sea f0 = matematica.piso(arriba / CASILLA)
    sea f1 = matematica.piso((arriba + h - 1) / CASILLA)
    para cada numero f en rango(f0, f1 + 1) {
        para cada numero c en rango(c0, c1 + 1) {
            si solido(c, f) { devolver verdadero }
        }
    }
    devolver falso
}

funcion volver_a_salir(): nulo {
    para cada numero f en rango(0, FILAS) {
        para cada numero c en rango(0, COLUMNAS) {
            si casilla(c, f) == "P" {
                px = c * CASILLA + 5
                py = f * CASILLA + 6
            }
        }
    }
    vx = 0
    vy = 0
}

funcion empezar(): nulo {
    monedas = []
    enemigos = []
    para cada numero f en rango(0, FILAS) {
        para cada numero c en rango(0, COLUMNAS) {
            sea t = casilla(c, f)
            si t == "o" { monedas.agregar({"x": c * CASILLA + 10, "y": f * CASILLA + 10, "viva": verdadero}) }
            si t == "E" { enemigos.agregar({"x": c * CASILLA + 4, "y": f * CASILLA + 20, "dir": -1, "vivo": verdadero}) }
        }
    }
    recogidas = 0
    vidas = 3
    reloj = 0
    invulnerable = 0
    estado = "jugando"
    volver_a_salir()
}

funcion herido(): nulo {
    si invulnerable > 0 { devolver nulo }
    vidas = vidas - 1
    juego.pitido(140, 300)
    si vidas == 0 {
        estado = "perdido"
    } sino {
        invulnerable = 1.5
        volver_a_salir()
    }
}

# ── Física ───────────────────────────────────────────────────────────
fijo JW = 22
fijo JH = 26

funcion mover_jugador(val numero dt): nulo {
    vx = juego.direccion("izquierda", "derecha") * VELOCIDAD
    si vx < 0 { mira_izquierda = verdadero }
    si vx > 0 { mira_izquierda = falso }
    si en_suelo y juego.accion_pulsada("saltar") {
        vy = SALTO
        juego.pitido(660, 50, 0.15)
    }
    vy = matematica.minimo(vy + GRAVEDAD * dt, 900)

    # horizontal: si choca, se arrima a la pared
    sea nx = px + vx * dt
    si choca(nx, py, JW, JH) {
        si vx > 0 { nx = matematica.piso((nx + JW) / CASILLA) * CASILLA - JW }
        si vx < 0 { nx = (matematica.piso(nx / CASILLA) + 1) * CASILLA }
    }
    px = nx

    # vertical: al caer sobre algo se queda en el suelo
    sea ny = py + vy * dt
    en_suelo = falso
    si choca(px, ny, JW, JH) {
        si vy > 0 {
            ny = matematica.piso((ny + JH) / CASILLA) * CASILLA - JH
            en_suelo = verdadero
        } sino {
            ny = (matematica.piso(ny / CASILLA) + 1) * CASILLA
        }
        vy = 0
    }
    py = ny
    si py > FILAS * CASILLA { herido() }
    si casilla(matematica.piso((px + JW / 2) / CASILLA), matematica.piso((py + JH / 2) / CASILLA)) == "M" {
        estado = "ganado"
        juego.pitido(880, 400)
    }
}

funcion mover_enemigos(val numero dt): nulo {
    para cada diccionario bicho en enemigos {
        si bicho["vivo"] {
            # anda hasta una pared o un borde, y se da la vuelta
            sea nx = bicho["x"] + bicho["dir"] * 60 * dt
            sea delante = nx
            si bicho["dir"] > 0 { delante = nx + 24 }
            sea c = matematica.piso(delante / CASILLA)
            sea f = matematica.piso((bicho["y"] + 6) / CASILLA)
            si solido(c, f) o no solido(c, f + 1) {
                bicho["dir"] = -bicho["dir"]
            } sino {
                bicho["x"] = nx
            }
            # ¿choca con el lince? Si cae encima, lo aplasta
            si juego.colision(px, py, JW, JH, bicho["x"], bicho["y"], 24, 12) {
                si vy > 0 y py + JH - bicho["y"] < 14 {
                    bicho["vivo"] = falso
                    vy = SALTO * 0.6
                    juego.pitido(300, 80)
                } sino {
                    herido()
                }
            }
        }
    }
    para cada diccionario m en monedas {
        si m["viva"] y juego.colision(px, py, JW, JH, m["x"], m["y"], 12, 12) {
            m["viva"] = falso
            recogidas = recogidas + 1
            juego.pitido(1320, 60, 0.15)
        }
    }
}

juego.abrir("Plataformas", ANCHO, ALTO)

# ── Controles: cada acción con su teclado y su mando ─────────────────
juego.definir_accion("izquierda", ["izquierda", "a", "mando:izquierda", "mando:izq_x-"])
juego.definir_accion("derecha", ["derecha", "d", "mando:derecha", "mando:izq_x+"])
juego.definir_accion("saltar", ["espacio", "arriba", "w", "mando:a"])
juego.definir_accion("empezar", ["espacio", "entrar", "mando:a", "mando:inicio"])
sea lince = juego.sprite(hoja_del_lince(), COLORES_LINCE)
sea escarabajo = juego.sprite([
    "...MMMMMM...",
    "..MMMMMMMM..",
    ".MMWKMMWKMM.",
    ".MMMMMMMMMM.",
    "MMMMMMMMMMMM",
    ".K.K....K.K."
], {"M": [120, 70, 160], "W": [255, 255, 255], "K": [30, 20, 40]})
sea moneda = juego.sprite([
    "..YY..",
    ".YYYY.",
    "YYWYYY",
    "YYWYYY",
    ".YYYY.",
    "..YY.."
], {"Y": [250, 200, 50], "W": [255, 250, 220]})
empezar()

mientras juego.abierto() {
    sea dt = juego.dt()
    si juego.tecla_pulsada("escape") { juego.salir() }
    si juego.tecla_pulsada("f11") { juego.pantalla_completa() }

    si estado == "jugando" {
        reloj = reloj + dt
        invulnerable = matematica.maximo(0, invulnerable - dt)
        mover_jugador(dt)
        mover_enemigos(dt)
    } sino si juego.accion_pulsada("empezar") {
        empezar()
    }

    # ── el mundo, con la cámara siguiendo al lince ──
    juego.limpiar([120, 190, 235])
    sea cam_x = matematica.limitar(px - ANCHO / 2, 0, COLUMNAS * CASILLA - ANCHO)
    juego.camara(cam_x, 0)
    sea c_ini = matematica.piso(cam_x / CASILLA)
    para cada numero f en rango(0, FILAS) {
        para cada numero c en rango(c_ini, c_ini + ANCHO / CASILLA + 2) {
            sea t = casilla(c, f)
            sea x = c * CASILLA
            sea arriba = f * CASILLA
            si t == "#" {
                juego.rectangulo(x, arriba, CASILLA, CASILLA, [150, 95, 55])
                si no solido(c, f - 1) { juego.rectangulo(x, arriba, CASILLA, 8, [90, 180, 70]) }
            } sino si t == "=" {
                juego.rectangulo(x, arriba, CASILLA, 12, [180, 130, 80])
                juego.contorno(x, arriba, CASILLA, 12, [120, 80, 45])
            } sino si t == "M" y casilla(c, f - 1) != "M" {
                juego.rectangulo(x + 14, arriba, 4, CASILLA * 5, [240, 240, 240])
                juego.rectangulo(x + 18, arriba + 2, 26, 18, [230, 60, 60])
            }
        }
    }
    para cada diccionario m en monedas {
        si m["viva"] {
            juego.dibujar(moneda, m["x"], m["y"] + matematica.seno(juego.tiempo() * 5 + m["x"]) * 3, {"escala": 2})
        }
    }
    para cada diccionario bicho en enemigos {
        si bicho["vivo"] { juego.dibujar(escarabajo, bicho["x"], bicho["y"], {"escala": 2, "espejo": bicho["dir"] > 0}) }
    }
    sea cuadro = 0
    si no en_suelo {
        cuadro = 1
    } sino si vx != 0 {
        cuadro = 1 + matematica.piso(juego.tiempo() * 10) % 2
    }
    si invulnerable == 0 o matematica.piso(invulnerable * 12) % 2 == 0 {
        juego.dibujar(lince, px - 1, py, {"celda": [12, 13], "cuadro": cuadro, "escala": 2, "espejo": mira_izquierda})
    }

    # ── marcador, fijo en pantalla ──
    juego.camara()
    juego.dibujar(moneda, 12, 12, {"escala": 2})
    juego.texto("x " + a_texto(recogidas), 32, 14, 2, [255, 255, 255])
    juego.texto("VIDAS " + a_texto(vidas), 120, 14, 2, [255, 255, 255])
    sea t = "TIEMPO " + a_texto(matematica.piso(reloj))
    juego.texto(t, ANCHO - juego.ancho_texto(t, 2) - 12, 14, 2, [255, 255, 255])
    si estado != "jugando" {
        juego.rectangulo(0, 180, ANCHO, 110, [0, 0, 0, 160])
        sea m = "HAS LLEGADO!"
        si estado == "perdido" { m = "FIN DEL JUEGO" }
        juego.texto(m, (ANCHO - juego.ancho_texto(m, 4)) / 2, 200, 4, [255, 220, 80])
        sea r = a_texto(recogidas) + " MONEDAS EN " + a_texto(matematica.piso(reloj)) + " S - ESPACIO PARA REPETIR"
        juego.texto(r, (ANCHO - juego.ancho_texto(r, 2)) / 2, 250, 2, [255, 255, 255])
    }
    juego.presentar()
}
