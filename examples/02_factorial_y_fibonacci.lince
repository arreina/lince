# 🐆 Lince — Factorial y Fibonacci
#
# Dos ejercicios de recursión clásicos, cada uno resuelto de las dos
# formas habituales, para comparar.
#
# Muestra: funciones con tipo de retorno, recursión, bucles 'mientras',
#          acumuladores y el módulo 'matematica'.

importar "matematica"

# ── Factorial ─────────────────────────────────────────────────

funcion factorial_recursivo(val numero n): numero {
    si n <= 1 {
        devolver 1
    }
    devolver n * factorial_recursivo(n - 1)
}

funcion factorial_iterativo(val numero n): numero {
    sea resultado = 1
    para (i = 2; i <= n; i++) {
        resultado = resultado * i
    }
    devolver resultado
}

escribir("── Factorial ──")
para cada numero n en rango(0, 8) {
    escribir(n + "! = " + factorial_recursivo(n))
}

escribir("")
escribir("Las tres formas dan lo mismo para 6:")
escribir("  recursivo  → " + factorial_recursivo(6))
escribir("  iterativo  → " + factorial_iterativo(6))
escribir("  matematica → " + matematica.factorial(6))

# ── Fibonacci ─────────────────────────────────────────────────

# Directo pero costoso: recalcula los mismos valores una y otra vez.
funcion fib_recursivo(val numero n): numero {
    si n < 2 {
        devolver n
    }
    devolver fib_recursivo(n - 1) + fib_recursivo(n - 2)
}

# Iterativo: guarda sólo los dos últimos valores.
funcion fib_iterativo(val numero n): numero {
    sea anterior = 0
    sea actual   = 1
    si n == 0 { devolver 0 }
    para (i = 1; i < n; i++) {
        sea siguiente = anterior + actual
        anterior = actual
        actual   = siguiente
    }
    devolver actual
}

escribir("")
escribir("── Fibonacci ──")

sea lista primeros = []
para cada numero i en rango(0, 12) {
    primeros.agregar(fib_iterativo(i))
}
escribir("Los 12 primeros: " + primeros)

escribir("")
escribir("Ambas versiones coinciden:")
para cada numero i en rango(0, 10) {
    sea r = fib_recursivo(i)
    sea t = fib_iterativo(i)
    si r != t {
        escribir("  ¡discrepancia en " + i + "!")
    }
}
escribir("  comprobado de 0 a 9 ✓")
