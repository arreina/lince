# 🐆 Lince — En el móvil
#
# Para probar Lince en un móvil Android (android/construir.sh), y también en
# el ordenador. Se juega con un mando en la pantalla, como los juegos de móvil:
# la palanca aparece donde se pone el pulgar izquierdo, A salta y B corre (en
# el ordenador, con el ratón, que cuenta como un dedo; o con las flechas,
# espacio y Mayús, o con un mando). El mando de la pantalla sale solo, con los
# botones que usan las acciones. Cada dedo en la pantalla se ve como un círculo con
# su número. Inclinar el móvil también mueve al lince, y al saltar vibra. Una
# estrella parpadea con una tarea, y el juego cuenta en un archivo cuántas
# veces se ha abierto. El botón «atrás» del móvil (o Esc) sale.
#
# Muestra: juego.mando_tactil() (las acciones con "mando:..." funcionan igual
#          con el de la pantalla), juego.toques(), tareas, efectos de sonido
#          y guardar datos.
importar "juego"
importar "archivos"
importar "matematica"

fijo ANCHO = 480
fijo ALTO = 270
fijo SUELO = 200

juego.abrir("Lince en el móvil", ANCHO, ALTO, {"escala": 2})
juego.definir_accion("izquierda", ["izquierda", "a", "mando:izquierda", "mando:izq_x-", "inclinacion:x-"])
juego.definir_accion("derecha", ["derecha", "d", "mando:derecha", "mando:izq_x+", "inclinacion:x+"])
juego.definir_accion("saltar", ["espacio", "arriba", "mando:a"])
juego.definir_accion("correr", ["mayus", "mando:b"])
juego.mando_tactil({"siempre": verdadero})        # en el móvil sale solo; así también en el ordenador
juego.definir_accion("salir", ["escape"])

fijo LINCE = juego.sprite([
    ".X......X.",
    ".XX....XX.",
    ".XYXXXXYX.",
    "XYYYYYYYYX",
    "XYGKYYGKYX",
    "XYYYPPYYYX",
    "XWYYYYYYWX",
    ".XWWKKWWX.",
    "..XXXXXX.."
], {"X": [70, 45, 25], "Y": [255, 200, 80], "G": [90, 200, 90], "K": [20, 20, 20],
    "P": [230, 120, 140], "W": [255, 250, 240]})

# Cuántas veces se ha abierto (en el móvil, en la carpeta privada del juego)
fijo ARCHIVO = "veces.txt"
sea veces = 1
si archivos.existe(ARCHIVO) { veces = a_numero(archivos.leer(ARCHIVO)) + 1 }
archivos.escribir(ARCHIVO, a_texto(veces))

sea px = ANCHO / 2
sea py = SUELO
sea vy = 0
sea mira_izquierda = falso
sea brillo = 0
sea saltos = 0

# Una estrella que parpadea sola, con una tarea
tarea parpadear() {
    mientras verdadero {
        brillo = 1
        esperar(0.15)
        brillo = 0
        esperar(0.6)
    }
}
parpadear()

mientras juego.abierto() {
    si juego.accion_pulsada("salir") { juego.salir() }
    sea dt = juego.dt()
    sea direccion = juego.direccion("izquierda", "derecha")
    sea rapidez = si juego.accion("correr") { 300 } sino { 160 }
    px = matematica.limitar(px + direccion * rapidez * dt, 20, ANCHO - 20)
    si direccion < 0 { mira_izquierda = verdadero }
    si direccion > 0 { mira_izquierda = falso }
    si juego.accion_pulsada("saltar") y py >= SUELO {
        vy = -330
        saltos++
        juego.efecto("salto", {"volumen": 0.4})
        juego.vibrar(0.05)                           # un toque en la mano (y en el mando)
    }
    vy += 900 * dt
    py = matematica.minimo(py + vy * dt, SUELO)

    juego.limpiar([25, 30, 50])
    juego.rectangulo(0, SUELO, ANCHO, ALTO - SUELO, [50, 70, 60])
    si brillo > 0 { juego.circulo(440, 40, 10, [255, 240, 120]) } sino { juego.circulo(440, 40, 4, [200, 190, 120]) }
    juego.dibujar(LINCE, px, py - 18, {"escala": 4, "centrado": verdadero, "espejo": mira_izquierda})
    juego.texto("LINCE EN EL MÓVIL", 12, 10, 2, [255, 200, 80])
    juego.texto("ABIERTO {veces} VECES - SALTOS: {saltos}", 12, 32, 1, [220, 220, 230])
    juego.texto("TÁCTIL: {si juego.tactil() { "SÍ" } sino { "NO" }} - {matematica.redondear(juego.fps())} FPS", 12, 44, 1, [220, 220, 230])

    # cada dedo, con su número
    sea dedos = juego.toques()
    para cada diccionario t en dedos {
        juego.circulo(t["x"], t["y"], 18, [120, 200, 255, 120])
        juego.texto(a_texto(t["id"] % 100), t["x"] - 4, t["y"] - 4, 1, [255, 255, 255])
    }
    sea incl = juego.inclinacion()
    juego.texto("INCLINACIÓN: {matematica.redondear(incl[0] * 10) / 10}, {matematica.redondear(incl[1] * 10) / 10}", 12, 68, 1, [220, 220, 230])
    juego.texto("DEDOS: {dedos.longitud()} - PALANCA: {matematica.redondear(juego.eje("izq_x") * 10) / 10}" +
            "{si juego.accion("correr") { " - CORRE" } sino { "" }}", 12, 56, 1, [220, 220, 230])
    juego.presentar()
}
