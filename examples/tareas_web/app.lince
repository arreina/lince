# 🐆 Lince — Tareas
#
# Aplicación con interfaz web: Lince sirve las páginas y guarda los datos en
# SQLite. Ejecútala desde esta carpeta:
#
#   lince app.lince              abre la aplicación en su propia ventana
#   lince app.lince --servidor   solo el servidor (http://localhost:8080)
#
# Para repartirla como un único ejecutable:
#
#   lince compilar app.lince --incluir plantillas
#
# Cada petición se atiende en un proceso aparte, así que no se puede guardar
# nada en variables entre peticiones: todo va a la base de datos, que se abre
# dentro de cada manejador.

importar "servidor"
importar "plantillas"
importar "sqlite"
importar "texto"

fijo BASE = "tareas.db"

funcion abrir_bd(): numero {
    sea bd = sqlite.abrir(BASE)
    sqlite.ejecutar(bd, "CREATE TABLE IF NOT EXISTS tareas (id INTEGER PRIMARY KEY, texto TEXT NOT NULL, hecha INTEGER NOT NULL DEFAULT 0)")
    devolver bd
}

funcion pagina(): diccionario {
    sea bd = abrir_bd()
    sea lista tareas = sqlite.consultar(bd, "SELECT id, texto, hecha FROM tareas ORDER BY hecha, id")
    sea pendientes = sqlite.consultar(bd, "SELECT COUNT(*) AS n FROM tareas WHERE hecha = 0")[0]["n"]
    sqlite.cerrar(bd)
    devolver servidor.html(plantillas.archivo("plantillas/pagina.html", {
        "tareas": tareas,
        "pendientes": pendientes
    }))
}

servidor.obtener("/", funcion(val diccionario peticion): diccionario {
    devolver pagina()
})

servidor.enviar("/anadir", funcion(val diccionario peticion): diccionario {
    sea campos = servidor.formulario(peticion["cuerpo"])
    sea nuevo = campos["texto"].recortar()
    si nuevo != "" {
        sea bd = abrir_bd()
        sqlite.ejecutar(bd, "INSERT INTO tareas (texto) VALUES (?)", [nuevo])
        sqlite.cerrar(bd)
    }
    devolver servidor.redirigir("/")
})

servidor.enviar("/alternar/:id", funcion(val diccionario peticion): diccionario {
    sea bd = abrir_bd()
    sqlite.ejecutar(bd, "UPDATE tareas SET hecha = 1 - hecha WHERE id = ?", [texto.a_numero(peticion["params"]["id"])])
    sqlite.cerrar(bd)
    devolver servidor.redirigir("/")
})

servidor.enviar("/borrar/:id", funcion(val diccionario peticion): diccionario {
    sea bd = abrir_bd()
    sqlite.ejecutar(bd, "DELETE FROM tareas WHERE id = ?", [texto.a_numero(peticion["params"]["id"])])
    sqlite.cerrar(bd)
    devolver servidor.redirigir("/")
})

servidor.estaticos("plantillas/estaticos")

si argumentos().contiene("--servidor") {
    servidor.escuchar(8080)
} sino {
    servidor.ventana(8765, 520, 640)
}
