importar "juego"

# Antes de abrir la ventana, dibujar es un error
intentar {
    juego.limpiar()
    escribir("MAL: no falló")
} capturar (Error e) {
    escribir("error sin ventana: ok")
}

juego.abrir("Prueba", 100, 80)
escribir("abierto: " + a_texto(juego.abierto()))
escribir("tamaño: " + a_texto(juego.ancho()) + "x" + a_texto(juego.alto()))

juego.limpiar([0, 0, 0])
juego.rectangulo(10, 10, 20, 20, [255, 0, 0])
juego.rectangulo(40, 10, 20, 20, "#00ff00")
juego.circulo(80, 60, 8, [0, 0, 255])
juego.linea(0, 79, 99, 79, [255, 255, 255])
juego.texto("Ñandú", 2, 40, 1, [255, 255, 0])
escribir("ancho texto: " + a_texto(juego.ancho_texto("Hola", 2)))
escribir("colisión: " + a_texto(juego.colision(0, 0, 10, 10, 5, 5, 10, 10)) + " " + a_texto(juego.colision(0, 0, 10, 10, 20, 20, 5, 5)))
juego.captura("captura.bmp")
juego.presentar()
escribir("tecla espacio: " + a_texto(juego.tecla("espacio")))
escribir("raton: " + a_texto(juego.raton().longitud()))

intentar {
    juego.tecla("noexiste_xyz")
    escribir("MAL: tecla desconocida aceptada")
} capturar (Error e) {
    escribir("tecla desconocida: ok")
}
intentar {
    juego.rectangulo(0, 0, 5, 5, "rojo")
    escribir("MAL: color inválido aceptado")
} capturar (ErrorTipo e) {
    escribir("color inválido: ok")
}
juego.pitido(440, 50)
juego.salir()
escribir("abierto tras salir: " + a_texto(juego.abierto()))
juego.cerrar()
