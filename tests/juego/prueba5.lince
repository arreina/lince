# Prueba de los mapas de casillas: plataformas y vista cenital
importar "juego"
juego.abrir("Mapas", 160, 128)
sea m = juego.mapa.crear([
    "########",
    "#......#",
    "#..==..#",
    "#......#",
    "#.#..#.#",
    "#.#..#.#",
    "#......#",
    "########"
], 16, {"plataformas": "="})
escribir("tamaño: " + a_texto(m["columnas"]) + "x" + a_texto(m["filas"]) + " " + a_texto(m["ancho"]))
escribir("casilla: " + juego.mapa.casilla(m, 0, 0) + juego.mapa.casilla(m, 1, 1) + juego.mapa.casilla(m, 3, 2) + "[" + juego.mapa.casilla(m, 99, 0) + "]")
escribir("solido: " + a_texto(juego.mapa.solido(m, 0, 0)) + " " + a_texto(juego.mapa.solido(m, 1, 1)) + " " + a_texto(juego.mapa.solido(m, -1, 3)) + " " + a_texto(juego.mapa.solido(m, 3, -1)))
juego.mapa.poner(m, 1, 1, "o")
escribir("buscar: " + a_texto(juego.mapa.buscar(m, "o=").longitud()))
sea en = juego.mapa.casilla_en(m, 40, 20)
escribir("casilla_en: " + a_texto(en[0]) + " " + a_texto(en[1]))

# con gravedad: cae y se queda en el suelo (fila 6, arriba en y = 96)
sea p = {"x": 20, "y": 20, "ancho": 10, "alto": 12, "vx": 0, "vy": 0}
para cada numero i en rango(0, 120) {
    p["vy"] = p["vy"] + 900 / 60
    juego.mapa.mover(m, p, 1 / 60)
}
escribir("cae: " + a_texto(p["y"] + p["alto"]) + " " + a_texto(p["en_suelo"]) + " " + a_texto(p["vy"]))
# contra una pared: se arrima
p["vx"] = 500
juego.mapa.mover(m, p, 0.2)
escribir("pared: " + a_texto(p["x"] + p["ancho"]) + " " + a_texto(p["pared"]))
# plataforma: desde abajo la atraviesa; al caer, se queda encima (arriba en y = 32)
sea q = {"x": 50, "y": 50, "ancho": 10, "alto": 10, "vx": 0, "vy": -300}
juego.mapa.mover(m, q, 0.1)
escribir("atraviesa: " + a_texto(q["y"] < 32) + " " + a_texto(q["techo"]))
q["vy"] = 200
juego.mapa.mover(m, q, 0.1)
escribir("pisa: " + a_texto(q["y"] + q["alto"]) + " " + a_texto(q["en_suelo"]))

# vista cenital: sin gravedad, choca en las dos direcciones
sea r = {"x": 18, "y": 100, "ancho": 12, "alto": 12, "vx": 0, "vy": -400}
juego.mapa.mover(m, r, 0.5)
escribir("cenital: " + a_texto(r["y"]) + " " + a_texto(r["techo"]))

# camino: rodea las paredes
sea c = juego.mapa.camino(m, [1, 5], [6, 5])
escribir("camino: " + a_texto(c.longitud()) + " termina en " + a_texto(c[c.longitud() - 1][0]))
escribir("sin camino: " + a_texto(juego.mapa.camino(m, [1, 1], [0, 0]).longitud()))
escribir("diagonal: " + a_texto(juego.mapa.camino(m, [1, 1], [6, 1], verdadero).longitud()))

juego.limpiar([0, 0, 0])
juego.mapa.dibujar(m, {"#": [255, 0, 0], "=": [0, 0, 255]})
juego.captura("mapa.bmp")
juego.presentar()
intentar {
    juego.mapa.crear(["ñ"], 16)
} capturar (error e) {
    escribir("no ascii: " + e.mensaje)
}

# tiles: una hoja de 2×2 con separación de 1 píxel (hecha con sprite, sin archivos)
fijo HOJA = juego.hoja(juego.sprite([
    "RR.GG",
    "RR.GG",
    ".....",
    "BB.YY",
    "BB.YY"
], {"R": [255, 0, 0], "G": [0, 255, 0], "B": [0, 0, 255], "Y": [255, 255, 0]}), 2, {"separacion": 1})
escribir("hoja: " + a_texto(HOJA["columnas"]) + " " + a_texto(HOJA["cuadros"]))
sea t = juego.mapa.crear(["ABCDE"], 16)
juego.limpiar([0, 0, 0])
juego.mapa.dibujar(t, {"A": [HOJA, 0], "B": [HOJA, 1], "C": [HOJA, 2], "D": [HOJA, -1], "E": [HOJA, [1, 2], 0.5]})
juego.dibujar(HOJA, 0, 20, {"cuadro": 2, "escala": 4})
juego.captura("tiles.bmp")
intentar {
    juego.mapa.dibujar(t, {"A": HOJA})
} capturar (error e) {
    escribir("hoja sin cuadro: " + e.mensaje)
}
intentar {
    juego.hoja(HOJA, 2, {"separasion": 1})
} capturar (error e) {
    escribir("opcion: " + e.mensaje)
}
