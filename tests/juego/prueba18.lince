# Partidas guardadas: guardar, cargar (con valores por defecto), olvidar
importar "juego"

escribir("nada: {juego.cargar_partida("partida")}")
sea opciones = juego.cargar_partida("opciones", {"musica": 0.8, "idioma": "es"})
escribir("por defecto: {opciones["musica"]}")
juego.guardar_partida("partida", {"nivel": 3, "nombre": "Ñandú", "records": [120, 95.5], "llaves": {"roja": verdadero}})
juego.guardar_partida("opciones", {"musica": 0.25})
sea p = juego.cargar_partida("partida")
escribir("nivel: {p["nivel"]}, {p["nombre"]}, {p["records"][1]}, {p["llaves"]["roja"]}")
sea op = juego.cargar_partida("opciones", {"musica": 0.8, "idioma": "es"})
escribir("opciones: {op["musica"]} {op["idioma"]}")
juego.guardar_partida("partida", {"nivel": 4})
escribir("otra vez: {juego.cargar_partida("partida")["nivel"]}")
escribir("olvidar: {juego.olvidar_partida("partida")} {juego.olvidar_partida("partida")}")
escribir("carpeta: {juego.carpeta_guardado().contiene("prueba18")}")
intentar { juego.guardar_partida("../fuera", 1) } capturar (error e) { escribir("error: {e.mensaje}") }
intentar { juego.guardar_partida("f", juego.cargar_partida) } capturar (error e) { escribir("error: {e.mensaje}") }
