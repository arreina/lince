# Prueba de las animaciones generadas (animar) y de guardar_imagen
importar "juego"
juego.abrir("Animar", 64, 32)
# 4×6: cuerpo arriba y dos piernas de 3 filas separadas por un hueco
fijo PJ = juego.sprite([
    "XXXX",
    "XXXX",
    "XXXX",
    "X..X",
    "X..X",
    "X..X"
], {"X": [255, 0, 0]})
sea andar = juego.animar(PJ, "andar")
escribir("andar: " + a_texto(andar["cuadros"]) + " " + a_texto(andar["celda"][0]) + "x" + a_texto(andar["celda"][1]) +
         " relleno " + a_texto(andar["relleno"][0]))
escribir("misma hoja: " + a_texto(juego.animar(PJ, "andar")["imagen"] == andar["imagen"]))
para cada texto t en ["respirar", "correr", "saltar", "golpe", "morir", "flotar", "girar"] {
    sea h = juego.animar(PJ, t, {"cuadros": 4})
    escribir(t + ": " + a_texto(h["cuadros"]))
}
escribir("frente: " + a_texto(juego.animar(PJ, "andar", {"vista": "frente"})["relleno"][0]))
# el cuadro 0 de andar: la pierna izquierda levantada (sin pie abajo), la derecha apoyada
juego.limpiar([0, 0, 0])
juego.dibujar(andar, 0, 0, {"cuadro": 0, "escala": 4})
juego.captura("andar.bmp")
juego.presentar()
# guardar_imagen escribe un PNG que se vuelve a leer igual
juego.guardar_imagen(andar, "andar.png")
sea leida = juego.imagen("andar.png")
escribir("png: " + a_texto(leida["ancho"]) + "x" + a_texto(leida["alto"]))
escribir("desde archivo: " + a_texto(juego.animar("andar.png", "girar", {"cuadros": 2})["cuadros"]))
para cada lista intento en [["saltar", {"cuadro": 3}], ["bailar", nulo], ["andar", {"vista": "arriba"}], ["andar", {"cuadros": 0}]] {
    intentar {
        juego.animar(PJ, intento[0], intento[1])
    } capturar (error e) {
        escribir("error: " + e.mensaje)
    }
}
intentar {
    juego.animar(juego.sprite(["..."], {"X": [1, 1, 1]}), "andar")
} capturar (error e) {
    escribir("error: " + e.mensaje)
}
# juntar: la forma tradicional, un dibujo por fotograma (tamaños distintos: centrados y abajo)
fijo F1 = juego.sprite(["AA", "AA"], {"A": [0, 0, 255]})
fijo F2 = juego.sprite(["BBBB", "BBBB", "BBBB"], {"B": [0, 255, 0]})
sea juntas = juego.juntar([F1, F2, "andar.png"])
escribir("juntar: " + a_texto(juntas["cuadros"]) + " " + a_texto(juntas["celda"][0]) + "x" + a_texto(juntas["celda"][1]))
escribir("juntar otra vez: " + a_texto(juego.juntar([F1, F2, "andar.png"])["imagen"] == juntas["imagen"]))
juego.limpiar([0, 0, 0])
juego.dibujar(juntas, 0, 0, {"cuadro": 0})
juego.captura("juntar.bmp")
intentar {
    juego.juntar([F1, 7])
} capturar (error e) {
    escribir("error: " + e.mensaje)
}
# hoja que se divide sola: fila 0 con 3 cuadros (uno más bajo), fila 1 con 2
fijo SOLA = juego.hoja(juego.sprite([
    "RR....BB",
    "RR.GG.BB",
    "RR.GG.BB",
    "........",
    "YY.MM...",
    "YY.MM..."
], {"R": [255, 0, 0], "G": [0, 255, 0], "B": [0, 0, 255], "Y": [255, 255, 0], "M": [255, 0, 255]}))
escribir("sola: " + a_texto(SOLA["cuadros"]) + " filas " + a_texto(SOLA["filas"]) + " " + a_texto(SOLA["por_fila"][0]) +
         "+" + a_texto(SOLA["por_fila"][1]) + " celda " + a_texto(SOLA["celda"][0]) + "x" + a_texto(SOLA["celda"][1]))
fijo CUENTA = juego.hoja(juego.sprite(["RRGGBB", "RRGGBB"], {"R": [255, 0, 0], "G": [0, 255, 0], "B": [0, 0, 255]}), {"columnas": 3})
escribir("por cuenta: " + a_texto(CUENTA["cuadros"]) + " " + a_texto(CUENTA["celda"][0]) + "x" + a_texto(CUENTA["celda"][1]))
juego.limpiar([0, 0, 0])
juego.dibujar(SOLA, 0, 0, {"fila": 0, "cuadro": 1, "escala": 4})       # verde 2×2, abajo en una celda de 2×3
juego.dibujar(SOLA, 20, 0, {"fila": 1, "cuadro": 3, "escala": 4})      # da la vuelta en la fila: magenta
juego.dibujar(CUENTA, 40, 0, {"cuadro": 2, "escala": 4})               # azul
juego.captura("hojas.bmp")
intentar {
    juego.dibujar(SOLA, 0, 0, {"fila": 5})
} capturar (error e) {
    escribir("error: " + e.mensaje)
}
intentar {
    juego.hoja(juego.sprite(["XX"], {"X": [1, 1, 1]}))
} capturar (error e) {
    escribir("error: " + e.mensaje)
}
intentar {
    juego.guardar_imagen(PJ, "pj.bmp")
} capturar (error e) {
    escribir("error: " + e.mensaje)
}
