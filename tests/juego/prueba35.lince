# 2.6: pruebas de juegos. Juega juego35.lince (que smoke.sh copia aquí) con
# jugar(), mira píxeles y compara capturas. smoke.sh mira la salida.
importar "juego"

sea r = juego.jugar("juego35.lince", {"guion": "10:derecha:20,5:toque:80:45\n8:raton:1:1:2, 12:mando1:a",
    "capturas": [0, 40], "escribir": "hola", "semilla": 7})
escribir("ok: {r["ok"]} {r["codigo"]}")
escribir(r["salida"].recortar())
escribir("capturas: {r["capturas"]}")
escribir("pixel: {juego.pixel(r["capturas"][1], 52, 45)} {juego.pixel(r["capturas"][0], 0, 0)}")
sea otra = juego.jugar("juego35.lince", {"fotogramas": 3, "semilla": 7, "escena": "menu", "argumentos": ["rojo"], "capturas": [2]})
escribir("otra: " + otra["salida"].recortar().reemplazar("\n", " / "))
escribir("roja: {juego.pixel(otra["capturas"][0], 12, 42)}")

# comparar
sea c = juego.comparar_imagenes(r["capturas"][0], r["capturas"][1])
escribir("comparar: {c["distintos"]} de {c["total"]} {c["mismo_tamaño"]}")
escribir("consigo misma: {juego.comparar_imagenes(r["capturas"][0], r["capturas"][0])["parte"]}")
escribir("tolerancia: {juego.comparar_imagenes(r["capturas"][1], otra["capturas"][0], {"tolerancia": 255})["distintos"]}")

# igual_que_antes: la primera vez la guarda; luego compara
escribir("primera: {juego.igual_que_antes(r["capturas"][1], "andando")}")
escribir("segunda: {juego.igual_que_antes(r["capturas"][1], "andando")}")
escribir("cambia: {juego.igual_que_antes(r["capturas"][0], "andando")}")
escribir("con margen: {juego.igual_que_antes(r["capturas"][0], "andando", {"margen": 0.1})}")
escribir("diferencias: {juego.pixel("capturas/fotograma_0_diferencias.png", 52, 45)}")

para cada funcion intento en [
    funcion(): nulo { juego.jugar("no_existe.lince") },
    funcion(): nulo { juego.jugar("juego35.lince", {"guion": ["derecha"]}) },
    funcion(): nulo { juego.jugar("juego35.lince", {"guion": ["5:toque:3"]}) },
    funcion(): nulo { juego.jugar("juego35.lince", {"capturas": [10], "fotogramas": 5}) },
    funcion(): nulo { juego.jugar("juego35.lince", {"fotograma": 5}) },
    funcion(): nulo { juego.pixel("no_existe.png", 0, 0) },
    funcion(): nulo { juego.pixel(r["capturas"][0], 500, 0) },
    funcion(): nulo { juego.comparar_imagenes(r["capturas"][0], r["capturas"][1], {"tolerancia": 300}) },
    funcion(): nulo { juego.igual_que_antes("no_existe.png", "x") },
    funcion(): nulo { juego.igual_que_antes(r["capturas"][0], "x", {"margen": 2}) }
] {
    intentar { intento() } capturar (error x) { escribir("error: {x.mensaje}") }
}
