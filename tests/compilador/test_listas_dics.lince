# TEST COMPILADOR: listas y diccionarios
sea lista nums = [1, 2, 3, 4, 5]

# Acceso y longitud
escribir(nums.longitud())
escribir(nums[0])
escribir(nums[-1])

# Agregar y eliminar
nums.agregar(6)
escribir(nums.longitud())
escribir(nums[5])
nums.eliminar(0)
escribir(nums.longitud())
escribir(nums[0])

# contiene
escribir(nums.contiene(3))
escribir(nums.contiene(99))

# Para cada
sea total = 0
para cada numero n en nums {
    total = total + n
}
escribir(total)

# Lista anidada
sea lista mat = [[1, 2], [3, 4], [5, 6]]
escribir(mat.longitud())
para cada elemento fila en mat {
    para cada numero v en fila {
        escribir(v)
    }
}

# Diccionario
sea diccionario persona = {"nombre": "Ana", "edad": 22}
escribir(persona["nombre"])
escribir(persona["edad"])
escribir(persona.longitud())
escribir(persona.contiene("nombre"))
escribir(persona.contiene("ciudad"))

persona["ciudad"] = "Madrid"
escribir(persona.longitud())
escribir(persona["ciudad"])

persona.eliminar("edad")
escribir(persona.longitud())

# Métodos de lista nuevos: el binario nativo debe dar lo mismo que el
# intérprete (ordenar sin comparador, que es lo que admite compilado).
sea lista desord = [42, 7, 19, 3]
escribir(desord.ordenar())
escribir(desord)
escribir(desord.invertir())
escribir(desord.posicion(19))
escribir(desord.posicion(99))
sea lista base = [1, 2, 3]
sea lista cop = base.copiar()
cop.agregar(9)
escribir(base.longitud())
escribir(cop.longitud())
base.insertar(1, 99)
escribir(base)
# Diccionario grande: antes se corrompía la memoria a las 64 claves.
sea diccionario muchas = {}
para cada numero i en rango(0, 200) {
    muchas["k" + i] = i
}
escribir(muchas.longitud())
escribir(muchas["k199"])
