# TEST COMPILADOR: módulos
importar "matematica"

# Constantes
sea pi_ok = matematica.PI > 3.14 y matematica.PI < 3.15
escribir(pi_ok)

# Funciones básicas
escribir(matematica.abs(-7))
escribir(matematica.piso(3.9))
escribir(matematica.techo(3.1))
escribir(matematica.redondear(3.5))
escribir(matematica.truncar(3.9))
escribir(matematica.raiz(25))
escribir(matematica.potencia(2, 8))
escribir(matematica.maximo(3, 9))
escribir(matematica.minimo(3, 9))
escribir(matematica.factorial(5))
escribir(matematica.combinaciones(5, 2))
escribir(matematica.log2(8))
escribir(matematica.log10(100))
escribir(matematica.seno(0))
escribir(matematica.coseno(0))
escribir(matematica.es_entero(4.0))
escribir(matematica.es_entero(4.5))

importar "archivos"
archivos.escribir("/tmp/lince_comp_mod.txt", "contenido de prueba")
escribir(archivos.existe("/tmp/lince_comp_mod.txt"))
sea c = archivos.leer("/tmp/lince_comp_mod.txt")
escribir(c)
archivos.eliminar("/tmp/lince_comp_mod.txt")
escribir(archivos.existe("/tmp/lince_comp_mod.txt"))

importar "expresiones"
escribir(expresiones.coincidir("hola123", "[0-9]+"))
escribir(expresiones.coincidir("hola", "^[0-9]+$"))
sea r = expresiones.buscar("precio 42 euros", "[0-9]+")
escribir(r)
sea nums = expresiones.todos("a1 b2 c3", "[0-9]+")
escribir(nums.longitud())
escribir(expresiones.reemplazar("hola mundo", "mundo", "Lince"))
