importar "cripto"
escribir(cripto.sha256("abc"))
escribir(cripto.sha256(""))
escribir(cripto.sha1("abc"))
escribir(cripto.md5("abc"))
escribir(cripto.hmac_sha256("key", "The quick brown fox jumps over the lazy dog"))
escribir(cripto.base64("Hola, Lince ñ"))
escribir(cripto.desbase64(cripto.base64("Hola, Lince ñ")))
escribir(cripto.desbase64("no es base64"))
escribir(cripto.hex("Lince"))
escribir(cripto.deshex("4c696e6365"))
escribir(cripto.deshex("zz"))
