importar "sqlite"
sea bd = sqlite.abrir(":memoria:")
sqlite.ejecutar(bd, "CREATE TABLE tareas (id INTEGER PRIMARY KEY, titulo TEXT, hecha INTEGER, nota TEXT); INSERT INTO tareas (titulo, hecha) VALUES ('uno', 0)")
sqlite.ejecutar(bd, "INSERT INTO tareas (titulo, hecha, nota) VALUES (?, ?, ?)", ["it's \"dos\"", verdadero, "ñandú"])
escribir(sqlite.ultimo_id(bd))
escribir(sqlite.consultar(bd, "SELECT * FROM tareas ORDER BY id"))
escribir(sqlite.consultar(bd, "SELECT titulo FROM tareas WHERE id = ?", [2]))
escribir(sqlite.ejecutar(bd, "UPDATE tareas SET hecha = 1"))
intentar {
    sqlite.consultar(bd, "SELECT * FROM no_existe")
} capturar (ErrorBD e) {
    escribir("error: " + e.mensaje)
}
sqlite.cerrar(bd)
intentar {
    sqlite.consultar(bd, "SELECT 1")
} capturar (ErrorBD e) {
    escribir("error: " + e.mensaje)
}
