# Lo obsoleto sigue funcionando en la 1.9, y avisa una vez por cosa al ejecutar
importar "texto"
importar "juego"
funcion doble(val numero x): numero { devolver x * 2 }
escribir(texto.dividir("a,b", ","))
escribir(texto.dividir("c,d", ","))
escribir("a,b".dividir(","))
sea m = juego.fisica({"gravedad": 10})
juego.cuerpo(m, {"x": 0, "y": 0, "ancho": 1, "alto": 1})
escribir(juego.fisica.mundo()["gravedad"])
