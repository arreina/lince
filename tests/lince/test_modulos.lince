# TEST: modulos
importar "matematica"
importar "texto"

# Matematica
escribir(matematica.abs(-5))
escribir(matematica.piso(3.9))
escribir(matematica.techo(3.1))
escribir(matematica.redondear(3.5))
escribir(matematica.potencia(2, 10))
escribir(matematica.raiz(25))
escribir(matematica.maximo(3, 7))
escribir(matematica.minimo(3, 7))
escribir(matematica.seno(0))
escribir(matematica.coseno(0))

# Constantes
sea pi_redondeado = matematica.redondear(matematica.PI * 100) / 100
escribir(pi_redondeado)

# Texto
sea partes = "a,b,c,d".dividir(",")
escribir(partes.longitud())
escribir(texto.unir(partes, "-"))
escribir(("ab" * 3))
escribir("Lince".invertir())
escribir(texto.formato("Hola {}, tienes {} años", ["Ana", 22]))
escribir("hola mundo".posicion("mundo"))
escribir("aababc".contar("a"))
escribir("hola mundo".extraer(0, 4))
escribir("42".es_numero())
escribir("hola".es_numero())
escribir(("" == ""))
escribir("hola".empieza_con("ho"))
escribir("hola".termina_con("la"))
escribir("7".rellenar_izq(3, "0"))
escribir("hi".rellenar_der(5, "."))
escribir("ok".centrar(6, "-"))
