# TEST: matematica
importar "matematica"

# Funciones básicas existentes
escribir(matematica.abs(-5))
escribir(matematica.piso(3.9))
escribir(matematica.techo(3.1))
escribir(matematica.redondear(3.5))
escribir(matematica.raiz(25))
escribir(matematica.potencia(2, 8))
escribir(matematica.maximo(3, 7))
escribir(matematica.minimo(3, 7))
escribir(matematica.seno(0))
escribir(matematica.coseno(0))
escribir(matematica.tangente(0))
escribir(matematica.logaritmo(1))

# Nuevas funciones
escribir(matematica.truncar(3.9))
escribir(matematica.truncar(-3.9))
escribir(matematica.truncar(5.0))
escribir(matematica.es_entero(4.0))
escribir(matematica.es_entero(4.5))
escribir(matematica.factorial(0))
escribir(matematica.factorial(1))
escribir(matematica.factorial(5))
escribir(matematica.factorial(10))
escribir(matematica.combinaciones(5, 0))
escribir(matematica.combinaciones(5, 2))
escribir(matematica.combinaciones(5, 5))
escribir(matematica.log2(1))
escribir(matematica.log2(8))
escribir(matematica.log10(1))
escribir(matematica.log10(1000))

# Constantes
sea pi_ok = matematica.PI > 3.14 y matematica.PI < 3.15
escribir(pi_ok)
sea e_ok = matematica.E > 2.71 y matematica.E < 2.72
escribir(e_ok)

# semilla: misma semilla, misma secuencia
matematica.semilla(42)
sea s1 = matematica.aleatorio(1, 1000) * 1000000 + matematica.aleatorio(1, 1000)
matematica.semilla(42)
sea s2 = matematica.aleatorio(1, 1000) * 1000000 + matematica.aleatorio(1, 1000)
escribir(s1 == s2)
sea dentro = verdadero
para cada numero i en rango(0, 2000) {
    sea r = matematica.aleatorio(1, 6)
    si r < 1 o r > 6 o no matematica.es_entero(r) { dentro = falso }
}
escribir(dentro)
# utilidades para juegos
escribir(matematica.distancia(0, 0, 3, 4))
escribir(matematica.angulo(0, 0, 0, 10))
escribir(matematica.interpolar(10, 20, 0.25))
escribir(matematica.limitar(15, 0, 10))
escribir(matematica.limitar(-3, 0, 10))
escribir(matematica.signo(-7))
escribir(matematica.redondear(matematica.grados(matematica.radianes(45))))
# vectores ([x, y])
escribir(matematica.longitud(3, 4))
escribir(matematica.normalizar(3, 4))
escribir(matematica.normalizar(0, 0))
sea v = matematica.vector(90, 10)
escribir(matematica.redondear(v[0]) + " " + matematica.redondear(v[1]))
sea g = matematica.rotar(1, 0, 90)
escribir(matematica.redondear(g[0]) + " " + matematica.redondear(g[1]))
escribir(matematica.acercar(10, 20, 3))
escribir(matematica.acercar(10, 11, 3))
escribir(matematica.acercar(10, 0, 4))
