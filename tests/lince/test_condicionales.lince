# TEST: condicionales
sea x = 10

si x > 5 {
    escribir("mayor")
}

si x > 20 {
    escribir("ERROR")
} sino {
    escribir("no mayor que 20")
}

si x == 5 {
    escribir("ERROR")
} sino si x == 10 {
    escribir("es 10")
} sino {
    escribir("ERROR")
}

# Condicional con logicos
sea a = verdadero
sea b = falso

si a y no b {
    escribir("a y no b")
}

si a o b {
    escribir("a o b")
}

# Condicionales anidados
para (i = 1; i <= 5; i++) {
    si i % 2 == 0 {
        escribir("par")
    } sino {
        escribir("impar")
    }
}

# 'y' y 'o' como nombres: solo son operadores entre dos valores
x = 3
sea y = 4
sea o = verdadero
si x > 2 y y > 3 { escribir("y como nombre y como operador") }
si falso o o { escribir("o también") }
y = y + 1
y += 1
y++
escribir(y)
sea punto = {"x": x, "y": y}
escribir(punto["y"])
si x == 3 y
   y == 7 { escribir("en dos líneas") }
sea dentro = x > 0
    y y < 10
escribir(dentro)
funcion mover(val numero x, val numero y): lista { devolver [x + 1, y + 1] }
escribir(mover(x, y))
intentar { escribir(5 % 0) } capturar (error e) { escribir(e.tipo) }
