# TEST: casos_limite
importar "matematica"

# Números especiales
escribir(0 / 1)
escribir(1 / 3)
escribir(matematica.piso(-1.5))
escribir(matematica.techo(-1.5))
escribir(matematica.abs(-999))
escribir(matematica.maximo(-5, -3))
escribir(matematica.minimo(-5, -3))

# Listas vacías
sea lista vacia = []
escribir(vacia.longitud())
vacia.agregar(1)
escribir(vacia.longitud())
vacia.eliminar(0)
escribir(vacia.longitud())

# Texto vacío
sea t = ""
escribir(t.longitud())
escribir(t.contiene("a"))

# Diccionario vacío
sea diccionario d = {}
escribir(d.longitud())
d["clave"] = "valor"
escribir(d.longitud())

# Anidamiento profundo
sea lista anidada = [[1, 2], [3, 4], [5, 6]]
para cada elemento fila en anidada {
    para cada numero n en fila {
        escribir(n)
    }
}

# Errores capturados correctamente
intentar {
    lanzar Error("prueba")
} capturar (error e) {
    escribir(e.tipo)
    escribir(e.mensaje)
}

intentar {
    sea lista nums = [1, 2, 3]
    para cada texto t en nums {
        escribir(t)
    }
} capturar (ErrorTipo e) {
    escribir("tipo capturado")
}

# División por cero
intentar {
    sea x = 1 / 0
    escribir(x)
} capturar (ErrorMatematico e) {
    escribir("division por cero")
}

# Cadena de errores — finalmente siempre se ejecuta
sea ejecutado = falso
intentar {
    intentar {
        lanzar Error("interior")
    } capturar (error e) {
        lanzar Error("re-lanzado")
    }
} capturar (error e) {
    ejecutado = verdadero
    escribir(e.mensaje)
}
escribir(ejecutado)
