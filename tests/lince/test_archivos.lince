# TEST: archivos
importar "archivos"

# Escribir y leer
archivos.escribir("lince_test_arc.txt", "hola mundo")
escribir(archivos.existe("lince_test_arc.txt"))
sea contenido = archivos.leer("lince_test_arc.txt")
escribir(contenido)

# Agregar
archivos.agregar("lince_test_arc.txt", "\nlinea dos")
sea c2 = archivos.leer("lince_test_arc.txt")
escribir(c2.contiene("linea dos"))

# Copiar
archivos.copiar("lince_test_arc.txt", "lince_copia_arc.txt")
escribir(archivos.existe("lince_copia_arc.txt"))

# Mover
archivos.mover("lince_copia_arc.txt", "lince_movido_arc.txt")
escribir(archivos.existe("lince_movido_arc.txt"))
escribir(archivos.existe("lince_copia_arc.txt"))

# Eliminar
archivos.eliminar("lince_test_arc.txt")
archivos.eliminar("lince_movido_arc.txt")
escribir(archivos.existe("lince_test_arc.txt"))

# Directorios
archivos.crear_directorio("lince_dir_arc")
escribir(archivos.es_directorio("lince_dir_arc"))
escribir(archivos.es_directorio("."))
escribir(archivos.es_directorio("lince_test_arc.txt"))

# Listar
archivos.escribir("lince_dir_arc/a.txt", "a")
archivos.escribir("lince_dir_arc/b.txt", "b")
sea archivos_dir = archivos.listar("lince_dir_arc")
escribir(archivos_dir.longitud() >= 2)

# Limpiar
archivos.eliminar("lince_dir_arc/a.txt")
archivos.eliminar("lince_dir_arc/b.txt")
