# TEST: generadores
generador contar(numero hasta): numero {
    sea i = 0
    mientras i < hasta {
        producir i
        i = i + 1
    }
}

para cada numero n en contar(4) {
    escribir(n)
}

# rango() básico
para cada numero n en rango(3) {
    escribir(n)
}

# rango con inicio y fin
para cada numero n en rango(2, 5) {
    escribir(n)
}

# rango con paso
para cada numero n en rango(0, 10, 4) {
    escribir(n)
}

# Generador de textos
generador saludos(): texto {
    producir "hola"
    producir "adios"
    producir "hasta luego"
}
para cada texto s en saludos() {
    escribir(s)
}

# Generador vacío
generador vacio(): numero {
    sea x = 0
    mientras x > 10 {
        producir x
    }
}
sea lista r = []
para cada numero n en vacio() {
    r.agregar(n)
}
escribir(r.longitud())

# Generador con parámetro y filtro
generador multiplos(numero base, numero hasta): numero {
    para cada numero n en rango(hasta) {
        si n % base == 0 {
            producir n
        }
    }
}
para cada numero n en multiplos(3, 10) {
    escribir(n)
}

# Los valores salen de uno en uno, según se piden: puede no acabar nunca
generador naturales(): numero {
    sea i = 0
    intentar {
        mientras verdadero {
            escribir("produce {i}")
            producir i
            i++
        }
    } capturar (error e) {
        escribir("no debería: {e.mensaje}")
    } finalmente {
        escribir("naturales: cerrado")
    }
}
para cada numero n en naturales() {
    escribir("usa {n}")
    si n == 2 { romper }
}
funcion primero_mayor(numero x): numero {
    para cada numero n en naturales() {
        si n > x { devolver n }
    }
    devolver -1
}
escribir(primero_mayor(1))

# Uno dentro de otro
generador dobles(numero hasta): numero {
    para cada numero p en multiplos(2, hasta) { producir p * 2 }
}
para cada numero d en dobles(7) { escribir(d) }

# Un error dentro del generador, o en el cuerpo del bucle
generador roto(): numero {
    producir 1
    producir 1 / "x"
}
intentar {
    para cada numero v en roto() { escribir("roto da {v}") }
} capturar (error e) {
    escribir("capturado: {e.mensaje}")
}
intentar {
    para cada numero v en naturales() { si v == 1 { lanzar Error("en el cuerpo") } }
} capturar (error e) {
    escribir("capturado: {e.mensaje}")
}

# Sin límite de valores
sea cuantos = 0
para cada numero v en rango(25000) { cuantos++ }
escribir(cuantos)
generador muchos(): numero { para (i = 0; i < 20000; i++) { producir i } }
cuantos = 0
para cada numero v en muchos() { cuantos++ }
escribir(cuantos)
sea suma = 0
para cada numero v en rango(0, 1, 0.25) { suma += v }
escribir(suma)
intentar { rango("a") } capturar (error e) { escribir(e.mensaje) }

# Guardado en una variable, sigue por donde iba; se para al soltarlo
generador contador(): numero {
    sea i = 0
    intentar {
        mientras verdadero {
            producir i
            i++
        }
    } capturar (error e) {
        escribir("no debería")
    } finalmente {
        escribir("contador: cerrado")
    }
}
sea g = contador()
escribir(g)
para cada numero n en g { si n == 2 { romper } }
para cada numero n en g {
    escribir("sigue en {n}")
    si n == 4 { romper }
}
g = nulo
sea dos = rango(2)
para cada numero x en dos { escribir("rango {x}") }
para cada numero x en dos { escribir("otra vez {x}") }
generador propio(): numero {
    producir 1
    para cada numero x en yo { producir x }
}
sea yo = propio()
intentar { para cada numero x en yo { escribir(x) } } capturar (error e) { escribir(e.mensaje) }

# mapear, filtrar y reducir también con generadores (y rango)
generador cubos(numero n): numero {
    para (i = 1; i <= n; i++) { producir i * i * i }
}
escribir(filtrar(rango(10), funcion(numero x): logico { devolver x % 3 == 0 }))
escribir(mapear(cubos(3), funcion(numero x): numero { devolver x + 1 }))
escribir(reducir(rango(1, 11), 0, funcion(numero a, numero x): numero { devolver a + x }))
generador sin_fin(): numero {
    mientras verdadero { producir 1 }
}
intentar { reducir(sin_fin(), 0, funcion(numero a, numero x): numero { devolver a + x }) } capturar (error e) { escribir(e.mensaje) }
