# TEST: diccionarios
sea diccionario d = {"nombre": "Ana", "edad": 22, "ciudad": "Madrid"}

# Acceso
escribir(d["nombre"])
escribir(d["edad"])

# Longitud
escribir(d.longitud())

# Nueva clave
d["pais"] = "España"
escribir(d.longitud())
escribir(d["pais"])

# Modificar clave existente
d["edad"] = 23
escribir(d["edad"])

# Contiene
escribir(d.contiene("nombre"))
escribir(d.contiene("telefono"))

# Eliminar
d.eliminar("ciudad")
escribir(d.longitud())
escribir(d.contiene("ciudad"))

# Iterar claves
sea lista claves = []
para cada texto k en d {
    claves.agregar(k)
}
escribir(claves.longitud())

# Los diccionarios crecen más allá de su capacidad inicial.
# Antes reservaban 64 huecos fijos y la clave 65 corrompía el montón.
sea diccionario grande = {}
para cada numero i en rango(0, 300) {
    grande["k" + i] = i
}
escribir(grande.longitud())
escribir(grande["k0"])
escribir(grande["k299"])
escribir(grande.contiene("k150"))
grande.eliminar("k150")
escribir(grande.longitud())
escribir(grande.contiene("k150"))

# claves() y valores() devuelven listas, en el orden de inserción.
sea diccionario cuenta = {"gato": 3, "ave": 1, "perro": 2}
escribir(cuenta.claves())
escribir(cuenta.valores())
escribir(cuenta.claves().ordenar())
escribir(cuenta.valores().ordenar())
escribir(cuenta.claves().longitud())
sea diccionario vacio = {}
escribir(vacio.claves())
escribir(vacio.valores())
# Las listas que devuelven son independientes del diccionario.
sea lista ks = cuenta.claves()
ks.agregar("nuevo")
escribir(cuenta.longitud())
escribir(ks.longitud())
