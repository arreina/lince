# TEST: funciones
# Función básica
funcion sumar(numero a, numero b): numero {
    devolver a + b
}
escribir(sumar(3, 7))

# Función con texto
funcion saludar(texto nombre): texto {
    devolver "Hola, " + nombre
}
escribir(saludar("Lince"))

# Función recursiva
funcion factorial(numero n): numero {
    si n <= 1 {
        devolver 1
    }
    devolver n * factorial(n - 1)
}
escribir(factorial(5))
escribir(factorial(10))

# Función con ref
funcion agregar_doble(ref lista nums, numero x): nulo {
    nums.agregar(x * 2)
}
sea lista miLista = [1, 2, 3]
agregar_doble(miLista, 5)
escribir(miLista.longitud())
escribir(miLista[3])

# Valores por defecto
funcion potencia(numero base, numero exp = 2): numero {
    sea r = 1
    para (i = 0; i < exp; i++) {
        r = r * base
    }
    devolver r
}
escribir(potencia(3))
escribir(potencia(2, 8))

# Lambda en variable
sea triple = funcion(numero x): numero {
    devolver x * 3
}
escribir(triple(7))

# Lambda como argumento
funcion aplicar(numero x, funcion f): numero {
    devolver f(x)
}
escribir(aplicar(4, funcion(numero n): numero { devolver n * n }))

# Se puede llamar a cualquier cosa que dé una función, no solo a un nombre
sea doble = funcion(numero x): numero { devolver x * 2 }
escribir((doble)(4))
sea golpes = [funcion(numero d): numero { devolver d + 1 }, doble]
escribir(golpes[0](10))
escribir(golpes[1](10))
sea por_nombre = {"puño": doble}
escribir(por_nombre["puño"](3))
funcion sumador(numero a): funcion {
    devolver funcion(numero b): numero { devolver a + b }
}
escribir(sumador(2)(3))
clase Arma { sea al_golpear = nulo }
sea arma = Arma()
arma.al_golpear = doble
escribir(arma.al_golpear(21))
golpes[0](1)
sea uno = 1
intentar { golpes.agregar(uno)
    golpes[2](1) } capturar (error e) { escribir(e.mensaje) }
# Un '(' al principio de la línea siguiente no llama a lo de antes
sea a = doble
(uno)
escribir(a(5))

# Una función es igual a sí misma (aunque esté guardada en otro sitio)
funcion nada(): nulo { }
sea otra = nada
escribir(otra == nada)
escribir(nada != nada)
escribir(funcion(): nulo { } == nada)
escribir(golpes[1] == doble)

# 'val' es opcional y 'ref' devuelve lo asignado a la variable que se pasó
funcion intercambiar(ref numero a, ref numero b): nulo {
    sea t = a
    a = b
    b = t
}
sea p1 = 1
sea p2 = 2
intercambiar(p1, p2)
escribir("{p1} {p2}")
funcion sumar_a(ref numero puntos, numero cuanto): nulo { puntos += cuanto }
sea marcador = 10
sumar_a(marcador, 5)
escribir(marcador)
sumar_a(3, 1)
clase Hucha {
    funcion sacar(ref numero saldo, numero cuanto): nulo { saldo -= cuanto }
}
sea saldo = 100
Hucha().sacar(saldo, 30)
escribir(saldo)
funcion sin_val(numero x, lista l): numero { devolver x + l.longitud() }
escribir(sin_val(1, [1, 2]))
