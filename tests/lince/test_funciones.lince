# TEST: funciones
# Función básica
funcion sumar(val numero a, val numero b): numero {
    devolver a + b
}
escribir(sumar(3, 7))

# Función con texto
funcion saludar(val texto nombre): texto {
    devolver "Hola, " + nombre
}
escribir(saludar("Lince"))

# Función recursiva
funcion factorial(val numero n): numero {
    si n <= 1 {
        devolver 1
    }
    devolver n * factorial(n - 1)
}
escribir(factorial(5))
escribir(factorial(10))

# Función con ref
funcion agregar_doble(ref lista nums, val numero x): nulo {
    nums.agregar(x * 2)
}
sea lista miLista = [1, 2, 3]
agregar_doble(miLista, 5)
escribir(miLista.longitud())
escribir(miLista[3])

# Valores por defecto
funcion potencia(val numero base, val numero exp = 2): numero {
    sea r = 1
    para (i = 0; i < exp; i++) {
        r = r * base
    }
    devolver r
}
escribir(potencia(3))
escribir(potencia(2, 8))

# Lambda en variable
sea triple = funcion(val numero x): numero {
    devolver x * 3
}
escribir(triple(7))

# Lambda como argumento
funcion aplicar(val numero x, val funcion f): numero {
    devolver f(x)
}
escribir(aplicar(4, funcion(val numero n): numero { devolver n * n }))

# Se puede llamar a cualquier cosa que dé una función, no solo a un nombre
sea doble = funcion(val numero x): numero { devolver x * 2 }
escribir((doble)(4))
sea golpes = [funcion(val numero d): numero { devolver d + 1 }, doble]
escribir(golpes[0](10))
escribir(golpes[1](10))
sea por_nombre = {"puño": doble}
escribir(por_nombre["puño"](3))
funcion sumador(val numero a): funcion {
    devolver funcion(val numero b): numero { devolver a + b }
}
escribir(sumador(2)(3))
clase Arma { sea al_golpear = nulo }
sea arma = Arma()
arma.al_golpear = doble
escribir(arma.al_golpear(21))
golpes[0](1)
sea uno = 1
intentar { golpes.agregar(uno)
    golpes[2](1) } capturar (error e) { escribir(e.mensaje) }
# Un '(' al principio de la línea siguiente no llama a lo de antes
sea a = doble
(uno)
escribir(a(5))

# Una función es igual a sí misma (aunque esté guardada en otro sitio)
funcion nada(): nulo { }
sea otra = nada
escribir(otra == nada)
escribir(nada != nada)
escribir(funcion(): nulo { } == nada)
escribir(golpes[1] == doble)
