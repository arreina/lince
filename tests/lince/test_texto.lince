# TEST: texto
sea s = "Hola Mundo"

# Métodos básicos
escribir(s.longitud())
escribir(s.mayusculas())
escribir(s.minusculas())
escribir(s.contiene("Mundo"))
escribir(s.contiene("lince"))
escribir(s.reemplazar("Mundo", "Lince"))

# Recortar
sea con_espacios = "   hola   "
escribir(con_espacios.recortar())

# Acceso por índice
escribir(s[0])
escribir(s[5])

# Concatenación
sea resultado = "Hola" + ", " + "Lince" + "!"
escribir(resultado)

# Número a texto y texto a número
importar "texto"
escribir(texto.de_numero(42))
escribir(texto.a_numero("3.14"))
escribir(texto.es_numero("123"))
escribir(texto.es_numero("abc"))
escribir(texto.es_vacio(""))
escribir(texto.es_vacio("algo"))
escribir(texto.empieza_con("hola mundo", "hola"))
escribir(texto.termina_con("hola mundo", "mundo"))
escribir(texto.posicion("hola mundo", "mundo"))
escribir(texto.contar("banana", "a"))
escribir(texto.extraer("hola mundo", 5, 10))
escribir(texto.invertir("Lince"))
escribir(texto.repetir("ab", 3))
escribir(texto.rellenar_izq("5", 4, "0"))
escribir(texto.centrar("hi", 6, "-"))

# El texto se cuenta por caracteres, no por bytes: las vocales
# acentuadas y la ñ ocupan dos bytes pero son una sola letra.
sea palabra = "niño"
escribir(palabra.longitud())
escribir(palabra[2])
escribir(palabra[-1])
sea ciudad = "Alcalá"
escribir(ciudad.longitud())
sea frase = "el niño español"
escribir(frase.mayusculas())
sea grito = "EL NIÑO ESPAÑOL"
escribir(grito.minusculas())
sea acentos = "áéíóúüñ"
escribir(acentos.mayusculas())
escribir(acentos.longitud())
sea recorrido = ""
para cada texto c en "camión" { recorrido = recorrido + "[" + c + "]" }
escribir(recorrido)
escribir(texto.invertir("camión"))
escribir(texto.a_lista("niño"))
escribir(texto.posicion("camión", "ó"))
escribir(texto.extraer("camión", 4, 6))
escribir(texto.es_letra("ñ"))
escribir(texto.rellenar_der("niño", 8, "."))
