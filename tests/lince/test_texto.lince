# TEST: texto
sea s = "Hola Mundo"

# Métodos básicos
escribir(s.longitud())
escribir(s.mayusculas())
escribir(s.minusculas())
escribir(s.contiene("Mundo"))
escribir(s.contiene("lince"))
escribir(s.reemplazar("Mundo", "Lince"))

# Recortar
sea con_espacios = "   hola   "
escribir(con_espacios.recortar())
sea con_saltos = "\t linea\r\n"
sea solo_espacios = "   "
escribir("[" + con_saltos.recortar() + "]")
escribir("[" + solo_espacios.recortar() + "]")

# Acceso por índice
escribir(s[0])
escribir(s[5])

# Concatenación
sea resultado = "Hola" + ", " + "Lince" + "!"
escribir(resultado)

# Número a texto y texto a número
importar "texto"
escribir(a_texto(42))
escribir(a_numero("3.14"))
escribir("123".es_numero())
escribir("abc".es_numero())
escribir(("" == ""))
escribir(("algo" == ""))
escribir("hola mundo".empieza_con("hola"))
escribir("hola mundo".termina_con("mundo"))
escribir("hola mundo".posicion("mundo"))
escribir("banana".contar("a"))
escribir("hola mundo".extraer(5, 10))
escribir("Lince".invertir())
escribir(("ab" * 3))
escribir("5".rellenar_izq(4, "0"))
escribir("hi".centrar(6, "-"))

# El texto se cuenta por caracteres, no por bytes: las vocales
# acentuadas y la ñ ocupan dos bytes pero son una sola letra.
sea palabra = "niño"
escribir(palabra.longitud())
escribir(palabra[2])
escribir(palabra[-1])
sea ciudad = "Alcalá"
escribir(ciudad.longitud())
sea frase = "el niño español"
escribir(frase.mayusculas())
sea grito = "EL NIÑO ESPAÑOL"
escribir(grito.minusculas())
sea acentos = "áéíóúüñ"
escribir(acentos.mayusculas())
escribir(acentos.longitud())
sea recorrido = ""
para cada texto c en "camión" { recorrido = recorrido + "[" + c + "]" }
escribir(recorrido)
escribir("camión".invertir())
escribir("niño".a_lista())
escribir("camión".posicion("ó"))
escribir("camión".extraer(4, 6))
escribir("ñ".es_letra())
escribir("niño".rellenar_der(8, "."))

# Métodos e indexación directamente sobre un literal de texto, igual
# que ya se podía con un literal de lista.
escribir("hola".mayusculas())
escribir("HOLA".minusculas())
escribir("camión".longitud())
escribir("camión"[4])
escribir("camión"[-1])
escribir("hola mundo".contiene("mundo"))
