# TEST: importar ... como — espacio de nombres para librerías en Lince

importar "./ayuda_modulo"  como tres
importar "./ayuda_modulo2" como diez

# Dos librerías con la misma función, cada una por su nombre
escribir(tres.escala(2))
escribir(diez.escala(2))

# Constantes del módulo, también
escribir(tres.FACTOR)
escribir(diez.FACTOR)

# Una función de la librería llamando a otra de la misma librería
escribir(tres.escala_doble(2))

# Nada se filtra al ámbito de quien importa
intentar {
    escribir(FACTOR)
} capturar (error e) {
    escribir("FACTOR no se filtra")
}

# El mismo fichero con otro alias es el mismo módulo (en la 2.10 y antes eran
# dos copias)
importar "./ayuda_modulo" como tercero
escribir(tercero.escala(1))

# Un módulo con estado: corre una sola vez en el programa, aunque lo importe
# también otro módulo; sus variables se leen con su valor de ahora; y sus
# funciones aceptan los parámetros con valor por defecto
importar "./ayuda_estado" como estado
importar "./ayuda_estado_b" como segundo
estado.poner(5)
escribir("getter: {estado.leer()} variable: {estado.valor} desde otro: {segundo.leer_desde_b()}")
escribir("defecto: {estado.suma(1)} {estado.suma(1, 2)}")

# El choque de alias en el mismo ámbito da error de redefinición, igual que
# cualquier otra definición repetida — está cubierto en test_redefinicion.
# Aquí no se puede probar: dentro de un 'intentar' hay otro ámbito y tapar
# ahí es legal, y al mismo nivel aborta el script.
