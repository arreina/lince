# TEST: los fallos de uso del lenguaje son errores capturables
#
# Hasta ahora unos cuarenta de ellos hacían fprintf + exit(1): mataban el
# proceso, así que un intentar/capturar no podía recuperarse, y el REPL se
# cerraba entero. Cada caso provoca uno y comprueba el tipo con el que llega.

importar "texto"

clase Caja {
    funcion crear(val numero v): nulo { mi.v = v }
    funcion dime(): numero { devolver mi.v }
}

funcion doble(val numero x): numero { devolver x * 2 }

generador cuenta(val numero hasta): numero {
    para (i = 0; i < hasta; i++) { producir i }
}

intentar {
    sea l = [1, 2, 3]
    l[9] = 1
    escribir("indice-asignar: NO dio error")
} capturar (error e) {
    escribir("indice-asignar: " + e.tipo)
}

intentar {
    sea d = {"a": 1}
    d[1] = 2
    escribir("clave-no-texto: NO dio error")
} capturar (error e) {
    escribir("clave-no-texto: " + e.tipo)
}

intentar {
    sea n = 5
    n[0] = 1
    escribir("indice-en-numero: NO dio error")
} capturar (error e) {
    escribir("indice-en-numero: " + e.tipo)
}

intentar {
    sea r = texto.nada()
    escribir("modulo-sin-funcion: NO dio error")
} capturar (error e) {
    escribir("modulo-sin-funcion: " + e.tipo)
}

intentar {
