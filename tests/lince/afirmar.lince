# 🐆 Lince — afirmar.lince
# Librería de aserciones para tests

sea _tests_total    = 0
sea _tests_ok       = 0
sea _tests_fallidos = 0
sea _suite_actual   = ""

funcion suite(texto nombre): nulo {
    _suite_actual = nombre
    escribir("  ▶ " + nombre)
}

funcion afirmar(texto descripcion, logico condicion): nulo {
    _tests_total = _tests_total + 1
    si condicion {
        _tests_ok = _tests_ok + 1
        escribir("    ✅ " + descripcion)
    } sino {
        _tests_fallidos = _tests_fallidos + 1
        escribir("    ❌ FALLO: " + descripcion)
    }
}

funcion afirmar_igual(texto descripcion, numero a, numero b): nulo {
    afirmar(descripcion + " (" + a + " == " + b + ")", a == b)
}

funcion afirmar_texto(texto descripcion, texto a, texto b): nulo {
    afirmar(descripcion + " (\"" + a + "\" == \"" + b + "\")", a == b)
}

funcion afirmar_logico(texto descripcion, logico a, logico b): nulo {
    afirmar(descripcion, a == b)
}

funcion afirmar_error(texto descripcion, logico se_lanzo): nulo {
    afirmar(descripcion, se_lanzo)
}

funcion resumen(): nulo {
    escribir("")
    escribir("══════════════════════════════")
    si _tests_fallidos == 0 {
        escribir("✅ " + _tests_ok + "/" + _tests_total + " tests pasaron")
    } sino {
        escribir("❌ " + _tests_fallidos + " fallos de " + _tests_total + " tests")
    }
    escribir("══════════════════════════════")
}
