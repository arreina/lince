# TEST: tareas — concurrencia con procesos
importar "tareas"
importar "tiempo"

funcion cuadrado(val numero n): numero {
    devolver n * n
}

sea a = tareas.iniciar(cuadrado, [3])
sea b = tareas.iniciar(cuadrado, [4])
escribir(tareas.esperar(a) + tareas.esperar(b))

escribir(tareas.mapear([1, 2, 3, 4, 5, 6, 7, 8], cuadrado))
escribir(tareas.mapear([5, 6, 7], cuadrado, 1))
escribir(tareas.mapear([], cuadrado))

# Los datos viajan copiados: la tarea no puede cambiar los del programa
sea lista datos = [1, 2, 3]
sea t = tareas.iniciar(funcion(val lista l): lista { l.agregar(99)
    devolver l }, [datos])
escribir(tareas.esperar(t))
escribir(datos)

# Estructuras anidadas
sea d = tareas.esperar(tareas.iniciar(funcion(): diccionario {
    devolver {"nums": [1, 2.5], "txt": "ñandú", "ok": verdadero, "nada": nulo}
}))
escribir(d["nums"][1])
escribir(d["txt"])

# Los errores de la tarea llegan como ErrorTarea
intentar {
    tareas.esperar(tareas.iniciar(funcion(): nulo { lanzar Error("boom") }))
} capturar (ErrorTarea e) {
    escribir("capturado: " + e.mensaje)
}

# Una tarea ya recogida no se puede esperar otra vez
sea u = tareas.iniciar(cuadrado, [2])
tareas.esperar(u)
intentar {
    tareas.esperar(u)
} capturar (ErrorTarea e) {
    escribir("ya recogida")
}

# Cancelar
sea c = tareas.iniciar(funcion(): nulo { tiempo.esperar(60000) }, [])
tareas.cancelar(c)
escribir(tareas.cpus() >= 1)
