# TEST: tareas (tarea ... { esperar() })
importar "archivos"
importar "sistema"

# Dos tareas a la vez: cada esperar() deja pasar un fotograma
tarea contar(val texto nombre, val numero veces) {
    para (i = 1; i <= veces; i++) {
        escribir("{nombre} {i}")
        esperar()
    }
    escribir("{nombre} acaba")
}
sea a = contar("a", 3)
sea b = contar("b", 2)
escribir("empezadas: {a}")
para (k = 0; k < 4; k++) {
    escribir("-- fotograma {k}")
    esperar()
}
escribir("a terminada: {a.terminada()}")

# Se puede esperar desde una función que llama la tarea, y a otra tarea
funcion pasos(val numero n): nulo {
    para (i = 0; i < n; i++) { esperar() }
}
tarea calcular(val numero x): numero {
    pasos(2)
    devolver x * 10
}
tarea jefe() {
    escribir("jefe: carga")
    sea r = esperar(calcular(4))
    escribir("jefe: resultado {r}")
}
esperar(jefe())

# Parar: se deshace desde donde esperaba y pasa por finalmente; no se captura
tarea infinita() {
    intentar {
        mientras verdadero { esperar() }
    } capturar (error e) {
        escribir("no debería capturar: {e.mensaje}")
    } finalmente {
        escribir("infinita: finalmente")
    }
}
sea inf = infinita()
esperar()
inf.parar()
escribir("parada: {inf.terminada()}")
inf.parar()

# Una que se para a sí misma
sea guardadas = []
tarea sola() {
    esperar()
    escribir("sola: antes")
    guardadas[0].parar()
    escribir("sola: no debería")
}
guardadas.agregar(sola())
esperar()
esperar()
escribir("sola terminada: {guardadas[0].terminada()}")

# Un método puede ser una tarea, con 'mi'
clase Moneda {
    sea brillo = 0
    tarea parpadear(val numero veces) {
        para (i = 0; i < veces; i++) {
            mi.brillo += 1
            esperar()
        }
    }
}
sea m = Moneda()
sea t = m.parpadear(3)
escribir("brillo al empezar: {m.brillo}")
esperar(t)
escribir("brillo al acabar: {m.brillo}")
escribir(t es tarea)
escribir(t == t)
escribir(t == guardadas[0])

# Segundos (aquí, fuera de un juego, con el reloj de verdad)
tarea lenta() {
    esperar(0.05)
    escribir("lenta: hecho")
}
esperar(lenta())

# Un error mientras avanza le llega a quien la hace avanzar
tarea rota() {
    esperar()
    sea x = 1 / "a"
}
sea r = rota()
intentar { esperar(r) } capturar (error e) { escribir("capturado: {e.mensaje} (línea {e.linea})") }
# y uno antes de su primera espera, a quien la llama
tarea rota2() { lanzar Error("al empezar") }
intentar { rota2() } capturar (error e) { escribir("capturado: {e.mensaje}") }

intentar { esperar("x") } capturar (error e) { escribir(e.mensaje) }
intentar { esperar(-1) } capturar (error e) { escribir(e.mensaje) }
intentar { t.correr() } capturar (error e) { escribir(e.mensaje) }
tarea con_tipo(): numero { devolver "no" }
intentar { esperar(con_tipo()) } capturar (error e) { escribir(e.mensaje) }

# 'tarea' no es palabra reservada
sea tarea = "fregar"
escribir(tarea)

# Errores de sintaxis
fijo LINCE = sistema.entorno("LINCE_BIN", "./lince")
fijo TMP = "test_tareas_tmp.lince"
funcion comprobar(val texto codigo, val texto pista): nulo {
    archivos.escribir(TMP, codigo)
    escribir(sistema.ejecutar(LINCE + " comprobar " + TMP + " 2>&1").contiene(pista))
}
comprobar("clase A \{\n tarea crear() \{ }\n}\n", "'crear' no puede ser una tarea")
comprobar("clase A \{\n estatico tarea f() \{ }\n}\n", "no puede ser 'abstracto' ni 'estatico'")
archivos.eliminar(TMP)

# Las que quedan al acabar el programa se paran, con su finalmente
tarea eterna() {
    intentar { mientras verdadero { esperar() } } capturar (error e) { escribir(e.mensaje) } finalmente { escribir("eterna: finalmente al acabar") }
}
eterna()
escribir("fin del programa")
