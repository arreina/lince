importar "sistema"
importar "archivos"

sea lista tests = [
    "test_basico",
    "test_listas_dics",
    "test_funciones",
    "test_clases",
    "test_closures",
    "test_generadores",
    "test_errores",
    "test_modulos",
    "test_importar",
    "test_importar_como",
    "test_pruebas",
    "test_fechas",
    "test_division_cero",
    "test_poo_avanzada",
    "test_interfaces_defecto"
]

sea dir_tests = "tests/compilador"

# Binario a probar. Configurable para poder pasar la misma suite por el
# build con AddressSanitizer (LINCE_BIN=./lince_debug).
fijo LINCE = sistema.entorno("LINCE_BIN", "./lince")
fijo WINDOWS = sistema.plataforma() == "windows"
sea nulo_dev = "/dev/null"
sea temporal = "lince_tmp_compilador"
sea prefijo = "./"
si WINDOWS {
    nulo_dev = "nul"
    prefijo = ""
}
archivos.crear_directorio(temporal)
sea pasados = 0
sea fallados = 0

escribir("")
escribir("══════════════════════════════════════════════════")
escribir("🐆 Lince — Tests del Compilador")
escribir("══════════════════════════════════════════════════")
escribir("")

para cada texto nombre en tests {
    sea fuente   = dir_tests + "/" + nombre + ".lince"
    sea esperado = dir_tests + "/" + nombre + ".esperado"
    sea binario  = temporal + "/" + nombre
    si WINDOWS { binario = binario + ".exe" }

    # Compilar — verificar que el binario existe
    sea cmd_comp = LINCE + " compilar " + fuente + " -o " + binario + " > " + nulo_dev + " 2>&1"
    sistema.ejecutar(cmd_comp)
    sea compilado = archivos.existe(binario)

    si no compilado {
        escribir("  ❌ " + nombre + " — falló al compilar")
        fallados = fallados + 1
    } sino {
        sea salida_tmp = temporal + "/" + nombre + ".txt"
        sea cmd_run = prefijo + binario + " > " + salida_tmp + " 2>&1"
        si WINDOWS { cmd_run = binario.reemplazar("/", "\\") + " > " + salida_tmp + " 2>&1" }
        sistema.ejecutar(cmd_run)

        # Comparar con esperado
        sea salida   = archivos.leer(salida_tmp).reemplazar("\r", "")
        sea esperada = archivos.leer(esperado)

        si salida == esperada {
            escribir("  ✅ " + nombre)
            pasados = pasados + 1
        } sino {
            escribir("  ❌ " + nombre + " — salida incorrecta")
            fallados = fallados + 1
        }

        # Limpiar temporales
        archivos.eliminar(salida_tmp)
        archivos.eliminar(binario)
    }
}

archivos.eliminar(temporal)

escribir("")
escribir("══════════════════════════════════════════════════")
si fallados == 0 {
    escribir("✅ " + pasados + "/" + (pasados + fallados) + " tests del compilador pasaron")
} sino {
    escribir("❌ " + fallados + " tests fallaron (" + pasados + " pasaron)")
}
escribir("══════════════════════════════════════════════════")
escribir("")

# Código de salida distinto de cero si algo falló, para que la
# integración continua detecte los fallos.
si fallados != 0 {
    sistema.salir(1)
}
