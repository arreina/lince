# 🐆 La Piedra del Lince
#
# Una aventura de vista cenital hecha con Lince. Grum, el cíclope, ha robado
# la Piedra del Lince, la que protege el pueblo de Valleclaro. La sabia Ura te
# da la espada de tu abuelo: cruza el Bosque Viejo, encuentra la llave de la
# fortaleza y recupera la piedra.
#
# Controles: flechas o WASD para andar; espacio (o Z, o A en el mando) para
# hablar, abrir y dar espadazos; Esc (o P, o inicio) para la pausa, donde se
# pueden cambiar los controles. En el móvil sale un mando en la pantalla.
#
# Para jugar:  cd juegos/la_piedra_del_lince  y  lince la_piedra_del_lince.lince
#
# Los mapas son de Tiled (mapas/*.tmx): se pueden abrir y cambiar en Tiled.
# Los gráficos, la música y los sonidos son de terceros, con licencias libres
# (ver CREDITOS.md). Los corazones, las monedas y la piedra se dibujan aquí.

importar "juego"
importar "matematica"

fijo ANCHO = 320
fijo ALTO = 180
fijo VELOCIDAD = 72            # píxeles por segundo
fijo VIDA_INICIAL = 6          # en medios corazones: 3 corazones
fijo VIDA_MAXIMA = 12

juego.abrir("La Piedra del Lince", ANCHO, ALTO, {"escala": 4})
juego.definir_accion("izquierda", ["izquierda", "a", "mando:izquierda", "mando:izq_x-"])
juego.definir_accion("derecha", ["derecha", "d", "mando:derecha", "mando:izq_x+"])
juego.definir_accion("arriba", ["arriba", "w", "mando:arriba", "mando:izq_y-"])
juego.definir_accion("abajo", ["abajo", "s", "mando:abajo", "mando:izq_y+"])
juego.definir_accion("accion", ["espacio", "z", "entrar", "mando:a"])
juego.definir_accion("pausa", ["escape", "p", "mando:inicio"])

# ── Recursos ─────────────────────────────────────────────────────────
fijo LETRA = juego.fuente("recursos/PressStart2P-Regular.ttf", 8)
fijo GRANDE = juego.fuente("recursos/PressStart2P-Regular.ttf", 16)
fijo TP = juego.hoja("recursos/tiles_pueblo.png", 16)       # Kenney, Tiny Town
fijo TM = juego.hoja("recursos/tiles_mazmorra.png", 16)     # Kenney, Tiny Dungeon

# Las rutas, enteras: así «lince compilar» y «lince repartir» saben qué meter en el juego
fijo SONIDO = {
    "espada": juego.sonido("recursos/sonidos/espada.ogg"), "golpe": juego.sonido("recursos/sonidos/golpe.ogg"),
    "dano": juego.sonido("recursos/sonidos/dano.ogg"), "moneda": juego.sonido("recursos/sonidos/moneda.ogg"),
    "cofre": juego.sonido("recursos/sonidos/cofre.ogg"), "puerta": juego.sonido("recursos/sonidos/puerta.ogg"),
    "arbusto": juego.sonido("recursos/sonidos/arbusto.ogg"), "roca": juego.sonido("recursos/sonidos/roca.ogg"),
    "llave": juego.sonido("recursos/sonidos/llave.ogg"),
    "hierba": [juego.sonido("recursos/sonidos/paso_hierba1.ogg"), juego.sonido("recursos/sonidos/paso_hierba2.ogg")],
    "piedra": [juego.sonido("recursos/sonidos/paso_piedra1.ogg"), juego.sonido("recursos/sonidos/paso_piedra2.ogg")]
}
fijo MUSICA = {"pueblo": "recursos/musica/pueblo.ogg", "bosque": "recursos/musica/bosque.ogg",
               "mazmorra": "recursos/musica/mazmorra.ogg", "jefe": "recursos/musica/jefe.ogg"}
fijo LETRITA = juego.crear_efecto("clic", {"volumen": 0.12, "tono": 1.6, "largo": 0.4})

# Los cuadros de las hojas de Kenney
fijo HEROE = 112
fijo ESPADA = 104
fijo COFRE = 89
fijo COFRE_ABIERTO = 91
fijo REJA = 77
fijo LLAVE = 117          # en la hoja del pueblo
fijo ARBUSTO = 5          # en la hoja del pueblo
fijo ENEMIGOS = {
    "babosa":     {"cuadro": 108, "vida": 2, "dano": 1, "ancho": 10, "alto": 8},
    "murcielago": {"cuadro": 120, "vida": 1, "dano": 1, "ancho": 8, "alto": 6},
    "arana":      {"cuadro": 122, "vida": 2, "dano": 1, "ancho": 10, "alto": 8},
    "fantasma":   {"cuadro": 121, "vida": 3, "dano": 2, "ancho": 10, "alto": 10},
    "grum":       {"cuadro": 109, "vida": 14, "dano": 1, "ancho": 20, "alto": 14}
}

# Lo que se dibuja aquí, con texto
fijo COLORES = {"R": [228, 59, 68], "r": [158, 40, 53], "W": [255, 230, 230], "K": [38, 23, 33],
                "Y": [254, 231, 97], "y": [228, 166, 54], "o": [170, 110, 40],
                "G": [99, 199, 77], "g": [38, 140, 70], "C": [200, 255, 230], "D": [24, 70, 50]}
fijo CORAZON = juego.sprite([
    ".KK.KK.",
    "KRWKRRK",
    "KRRRRRK",
    ".KRRRK.",
    "..KRK..",
    "...K..."], COLORES)
fijo MEDIO_CORAZON = juego.sprite([
    ".KK.KK.",
    "KRWKKKK",
    "KRRK..K",
    ".KRK.K.",
    "..KKK..",
    "...K..."], COLORES)
fijo SIN_CORAZON = juego.sprite([
    ".KK.KK.",
