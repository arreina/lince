# Carga típica de un juego sin ventana: 2000 partículas (objetos) que se
# mueven, rebotan y se comprueban contra un jugador, durante 120 fotogramas.
importar "matematica"

clase Particula {
    funcion crear(numero px, numero py, numero vx, numero vy): nulo {
        mi.px = px
        mi.py = py
        mi.vx = vx
        mi.vy = vy
    }
    funcion mover(numero dt): nulo {
        mi.px = mi.px + mi.vx * dt
        mi.py = mi.py + mi.vy * dt
        si mi.px < 0 o mi.px > 800 { mi.vx = -mi.vx }
        si mi.py < 0 o mi.py > 600 { mi.vy = -mi.vy }
    }
    funcion cerca(numero cx, numero cy, numero r): logico {
        sea dx = mi.px - cx
        sea dy = mi.py - cy
        devolver dx * dx + dy * dy < r * r
    }
}

matematica.semilla(1)
sea particulas = []
para cada numero i en rango(0, 2000) {
    particulas.agregar(Particula(matematica.aleatorio(0, 800), matematica.aleatorio(0, 600),
                                 matematica.aleatorio(-100, 100), matematica.aleatorio(-100, 100)))
}
sea tocadas = 0
para cada numero cuadro en rango(0, 600) {
    para cada Particula p en particulas {
        p.mover(1 / 60)
        si p.cerca(400, 300, 50) { tocadas = tocadas + 1 }
    }
}
escribir(tocadas)
